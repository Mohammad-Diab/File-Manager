                <CheckBox x:Name="hidden" Content="Hidden" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF404040" FontSize="16" Margin="430,66,0,0" Background="{x:Null}" Checked="AnyAttributes_Checked"/>
                <CheckBox x:Name="archive" Content="Archive" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF404040" FontSize="16"  Margin="430,91,0,0" Background="{x:Null}" Checked="AnyAttributes_Checked"/>
                <Rectangle Margin="0,116,10,0" Height="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="360">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                    <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="White" Offset="1"/>
                            <GradientStop Color="#FFEC9B4A"/>
                            <GradientStop Color="#FFEEA963" Offset="0.329"/>
                            <GradientStop Color="#FFF2C190" Offset="0.478"/>
                            <GradientStop Color="#FFF6D6B6" Offset="0.751"/>
                            <GradientStop Color="#FFF9E7D5" Offset="0.912"/>
