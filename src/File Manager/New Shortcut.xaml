<Window x:Class="File_Manager.New_Shortcut"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:File_Manager"
        mc:Ignorable="d"
        Title="Shortcut Creator" Height="320" Width="500" FontSize="14" FontFamily="Segoe UI" MaxWidth="500" Loaded="Window_Loaded" ResizeMode="NoResize">
    <Grid>
        <Grid x:Name="mother" Margin="0,0,0,0">
            <Grid Width="490" HorizontalAlignment="Left">
                <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Margin="10,40,0,0" FontSize="18" Foreground="#FF195310" Text="Shortcut information" VerticalAlignment="Top"/>
                <Grid Margin="10,72,10,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Original path" VerticalAlignment="Center"/>
                    <TextBox x:Name="o_path" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,3" VerticalContentAlignment="Center" ToolTip="The file or folder the shortcut opens" TextChanged="OriginalPath_TextChanged"/>
                    <Button x:Name="o_browse" Grid.Row="0" Grid.Column="2" Content="..." ToolTip="Choose a file or a folder" Width="28" Height="26" Margin="4,3,0,3" Click="SelectOrginalItem_Click" Background="{x:Null}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Choose a file..." Click="SelectOriginalFile_Click"/>
                                <MenuItem Header="Choose a folder..." Click="SelectOriginalFolder_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <TextBlock Grid.Row="1" Text="Shortcut path" VerticalAlignment="Center"/>
                    <TextBox x:Name="s_path" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,3" VerticalContentAlignment="Center" ToolTip="The folder where the shortcut is saved"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="..." ToolTip="Choose the folder for the shortcut" Width="28" Height="26" Margin="4,3,0,3" Click="SelectLinkDestination_Click" Background="{x:Null}"/>
                    <TextBlock Grid.Row="2" Text="Shortcut name" VerticalAlignment="Center"/>
                    <TextBox x:Name="s_name" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="26" Margin="0,3" VerticalContentAlignment="Center" ToolTip="Name of the shortcut file ('.lnk' is added when missing)"/>
                    <TextBlock Grid.Row="3" Text="Description" VerticalAlignment="Center"/>
                    <TextBox x:Name="desc" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="26" Margin="0,3" VerticalContentAlignment="Center" ToolTip="Shown as the tooltip of the shortcut (optional)"/>
                    <TextBlock Grid.Row="4" Text="Icon" VerticalAlignment="Center"/>
                    <TextBox x:Name="icon_path" Grid.Row="4" Grid.Column="1" Height="26" Margin="0,3" VerticalContentAlignment="Center" ToolTip="An .ico file, or an .exe/.dll file that contains icons (optional; empty = the icon of the original)"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="..." ToolTip="Choose an icon (.ico, .exe or .dll)" Width="28" Height="26" Margin="4,3,0,3" Click="SelectIcon_Click" Background="{x:Null}"/>
                </Grid>
                <Button Content="Create" Width="180" Height="30" HorizontalAlignment="Center" Margin="0,0,0,10" VerticalAlignment="Bottom" Click="CreateShortcut_Click" Background="{x:Null}"/>
            </Grid>
            <Grid Margin="500,0,0,0" Width="490" HorizontalAlignment="Left">
                <TextBlock x:Name="textBlock_Copy" HorizontalAlignment="Left" Margin="10,40,0,0" FontSize="18" Foreground="#FF195310" Text="Junction information" VerticalAlignment="Top"/>
                <Grid Margin="10,72,10,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Source path" VerticalAlignment="Center"/>
                    <TextBox x:Name="d_path" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,3" VerticalContentAlignment="Center" ToolTip="The existing folder the junction points to"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="..." ToolTip="Choose the existing folder" Width="28" Height="26" Margin="4,3,0,3" Click="SelectSourceDirectory_Click" Background="{x:Null}"/>
                    <TextBlock Grid.Row="1" Text="Junction target" VerticalAlignment="Center"/>
                    <TextBox x:Name="j_path" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,3" VerticalContentAlignment="Center" ToolTip="The new junction (an empty folder, or a folder that does not exist yet)"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="..." ToolTip="Choose where the junction is created" Width="28" Height="26" Margin="4,3,0,3" Click="SelectJunctionTarget_Click" Background="{x:Null}"/>
                    <CheckBox x:Name="create_direcory" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="Create the folder if it does not exist." Margin="0,6,0,0" IsChecked="True"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="10,170,10,0" VerticalAlignment="Top">
                    <Image Source="Images/Appearance/dialog-information.png" Height="22" Width="22" VerticalAlignment="Center"/>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FF6DAB21" FontSize="16" Text="The junction target must be an empty folder."/>
                </StackPanel>
                <Button Content="Create" Width="180" Height="30" HorizontalAlignment="Center" Margin="0,0,0,10" VerticalAlignment="Bottom" Click="CreateJunction_Click" Background="{x:Null}"/>
            </Grid>
        </Grid>
        <StackPanel VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="NEW SHORTCUT" FontSize="18" Background="White" MouseUp="Label1_MouseUp" Cursor="Hand"/>
            <Label x:Name="label2" Content="NEW JUNCTION" FontSize="18" Foreground="White" Background="Black" MouseUp="label2_MouseUp" Cursor="Hand"/>
        </StackPanel>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,30,0,0" VerticalAlignment="Top" Width="143"/>
    </Grid>
</Window>
