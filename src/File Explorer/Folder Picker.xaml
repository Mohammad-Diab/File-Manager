<Window x:Class="File_Explorer.Folder_Picker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Picker" Height="350" Width="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded_1" ShowInTaskbar="False" Icon="Images/Appearance/empty.png">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
            <GradientStop Color="Snow" Offset="0.715"/>
            <GradientStop Color="#FFCDEAFB" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <TreeView x:Name="FolderExplorer" Margin="10,10,10,5" Background="{x:Null}"/>
        <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,7.5,10,7.5" Width="75" IsCancel="True" Visibility="Collapsed" Click="Cancel_Click" Grid.Row="1" Background="{x:Null}"/>
        <Button Content="OK" HorizontalAlignment="Right" Margin="0,7.5,10,7.5" Width="75" Click="OK_Click" Grid.Row="1" Background="{x:Null}"/>
        <Button HorizontalAlignment="Left" Margin="10,7,0,7" Grid.Row="1" Click="CreateDirectory_Click" Width="110" Background="{x:Null}" >
            <Button.Content>
                <Grid Width="106">
                    <TextBlock Margin="28,2,0,2" Text="New directory"/>
                    <Image Source="Images/Appearance/new-folder.png" HorizontalAlignment="Left" Width="22" Margin="2,0,0,0"/>
                </Grid>
            </Button.Content>
        </Button>
    </Grid>
</Window>
