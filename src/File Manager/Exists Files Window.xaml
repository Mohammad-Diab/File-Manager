<Window x:Class="File_Manager.Exists_Files_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What do you want to do" Height="510" Width="550" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Icon="Images/Appearance/empty.png" Loaded="Window_Loaded">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
            <GradientStop Color="#FFFFFCB6" Offset="1"/>
            <GradientStop Color="White" Offset="0.9"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <ListView Margin="0,85,0,0" x:Name="container" Background="{x:Null}" ItemsSource="{Binding}" SelectionChanged="Container_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="500">
                        <TextBlock Margin="10, 5, 0, 0" Text="{Binding Path=FileName}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Foreground="#FF646464"/>
                        <CheckBox Margin="10, 24, 0, 10" ToolTip="{Binding Path=SourceToolTip}" IsChecked="{Binding Path=SourceIsChecked}" HorizontalAlignment="Left" Width="245" Checked="From_Checked" Unchecked="From_Checked">
                            <Grid Width="225">
                                <Image Margin="0, 5, 0, 0" Source="{Binding Path=SourceIcon}" Height="64" Width="64" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                <TextBlock Margin="70, 6, 0, 0" Text="{Binding Path=SourceSize}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                                <TextBlock Margin="70, 27, 0, 0" Text="{Binding Path=SourceType}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                                <TextBlock Margin="70, 48, 0, 0" Text="{Binding Path=SourceDate}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                            </Grid>
                        </CheckBox>
                        <CheckBox Margin="0, 24, 0, 10" ToolTip="{Binding Path=TargetTooltip}" IsChecked="{Binding Path=TargetIsChecked}" HorizontalAlignment="Right" Width="245" Checked="To_Checked" Unchecked="To_Checked">
                            <Grid Width="225">
                                <Image Margin="0, 5, 0, 0" Source="{Binding Path=TargetIcon}" Height="64" Width="64" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                <TextBlock Margin="70, 6, 0, 0" Text="{Binding Path=TargetSize}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                                <TextBlock Margin="70, 27, 0, 0" Text="{Binding Path=TargetType}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                                <TextBlock Margin="70, 48, 0, 0" Text="{Binding Path=TargetDate}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                            </Grid>
                        </CheckBox>
                        <Rectangle Fill="YellowGreen" Height="1" Margin="0, 95, 0, 0" VerticalAlignment="Top"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Margin="10,10,0,0" Foreground="DarkBlue" FontSize="22"><Run Text="Which files do you want to Keep?"/><LineBreak/><Run Foreground="Black" FontSize="14" Text="if you choose both files the copy file will have a number added to its name."/></TextBlock>
        <CheckBox x:Name="source_checkbox" Content="File from source" HorizontalAlignment="Left" Margin="10,65,0,0" VerticalAlignment="Top" FontSize="14" Checked="CheckSource_Checked" Unchecked="CheckSource_Unloaded"/>
        <CheckBox x:Name="target_checkbox" Content="File already in target" HorizontalAlignment="Left" Margin="255,65,0,0" VerticalAlignment="Top" FontSize="14" Checked="CheckTarget_Checked" Unchecked="CheckTarget_Unloaded"/>
        <Rectangle Height="1" Margin="0,85,0,0" Stroke="Chocolate" VerticalAlignment="Top"/>
        <Button Content="Skip All" HorizontalAlignment="Right" Margin="0,0,90,9" Width="75" Click="Cancel_Click" Grid.Row="1" Height="22" VerticalAlignment="Bottom" Background="{x:Null}"/>
        <Button Content="Done" HorizontalAlignment="Right" Margin="0,0,10,9" VerticalAlignment="Bottom" Width="75" Height="22" Click="OK_Click" Grid.Row="1" Background="{x:Null}"/>
        <ComboBox x:Name="skip_items" HorizontalAlignment="Left" Margin="10,0,0,8" FontSize="13.8" SelectionChanged="SkipSame_SelectionChanged" SelectedIndex="0" Width="250" Background="{x:Null}" BorderBrush="#FFA23838" Grid.Row="1" Height="24" VerticalAlignment="Bottom">
            <ComboBoxItem Content="Do Nothing"/>
            <ComboBoxItem>
                <ComboBoxItem.Content>
                    <TextBlock>
                        <TextBlock.ToolTip>
                            <Grid>
                                <Rectangle Margin="0,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                            <GradientStop Color="#FFB40100" Offset="1"/>
                                            <GradientStop Color="#FFDC0200"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Image HorizontalAlignment="Left" Width="22" Margin="2,0,0,0" Source="Images/Appearance/warring.png" Height="22"/>
                                <TextBlock Margin="28,0,0,0" Text="Caution: It may take long time if you have a huge or lots of files.    " Foreground="WhiteSmoke" FontSize="14" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="SemiBold"/>
                            </Grid>
                        </TextBlock.ToolTip>
                    <Run Text="Skip"/>
                    <Run x:Name="same_containt" Text="????" Foreground="Green"/>
                    <Run Text="files with same containt."/>
                </TextBlock>
                </ComboBoxItem.Content>
            </ComboBoxItem>
            <ComboBoxItem>
                <ComboBoxItem.Content>
                    <TextBlock>
                    <Run Text="Skip"/>
                    <Run x:Name="same_file_size" Text="????" Foreground="Green"/>
                    <Run Text="files with same size."/>
                    </TextBlock>
                </ComboBoxItem.Content>
            </ComboBoxItem>
            <ComboBoxItem>
                <ComboBoxItem.Content>
                    <TextBlock>
                    <Run Text="Skip"/>
                    <Run x:Name="same_file_date" Text="????" Foreground="Green"/>
                    <Run Text="files with same size and date."/>
                    </TextBlock>
                </ComboBoxItem.Content>
            </ComboBoxItem>
            <ComboBoxItem Content="Skip older files"/>
        </ComboBox>
    </Grid>
</Window>
