<Window x:Class="File_Manager.SubtitleSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subtitle Options" MinHeight="350" MinWidth="400" Height="575" Width="500"  WindowStartupLocation="CenterScreen" FontSize="14" Loaded="Window_Loaded" PreviewKeyUp="Window_PreviewKeyUp" SizeChanged="Window_SizeChanged" Icon="Images/Tools Icon/subtitle-options.png">
    <!--Topmost="True"-->
    <Grid>
        <StackPanel x:Name="tab_panal" Height="36" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="FONT STYLE" FontSize="18" Background="White" MouseUp="TabChange_MouseButtonUp" Cursor="Hand"/>
            <Label x:Name="label2" Content="SUBTITLE SETTING" FontSize="18" Foreground="White" Background="Black" MouseUp="TabChange_MouseButtonUp" Cursor="Hand"/>
        </StackPanel>
        <Grid x:Name="mother" Margin="0,0,0,0">
            <Grid Width="495" HorizontalAlignment="Left">
                <TextBlock HorizontalAlignment="Left" Margin="10,40,0,0" Text="Preview" VerticalAlignment="Top" FontSize="18" Foreground="#FF195310"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,0,0,51" VerticalAlignment="Bottom" Text="Font size" FontSize="18" Foreground="#FF195310"/>
                <TextBlock HorizontalAlignment="Right" Margin="0,165,127,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Color" FontSize="18" Foreground="#FF195310"/>
                <ListBox x:Name="fonts_list" Margin="10,194,180,90"  ItemsSource="{Binding}" SelectionChanged="FontsNames_SelectionChanged" BorderBrush="#FF6C4500">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Left" FontFamily="{Binding Path=Font}" Foreground="#FF282828" TextWrapping="Wrap" Text="{Binding Path=DisplayName}" VerticalAlignment="Top"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Slider x:Name="font_size_slider" Margin="100,0,155,49" VerticalAlignment="Bottom" SmallChange="2" Minimum="8" Maximum="72" TickPlacement="BottomRight" Value="22" Ticks="8 9 10 11 12 14 16 18 20 22 24 26 28 36 48 72" AutoToolTipPlacement="BottomRight" ValueChanged="FontSizes_ValueChanged" LargeChange="10" Foreground="#FF6C4500"/>
                <ListBox x:Name="colors_list" Margin="0,194,20,90" SelectionChanged="FontColors_SelectionChanged" ItemsSource="{Binding}" BorderBrush="#FF6C4500" SelectionMode="Single" HorizontalAlignment="Right" Width="150">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="25" VerticalAlignment="Top" ToolTip="{Binding Path=ColorName}">
                                <Ellipse HorizontalAlignment="Left" Height="24"  Fill="{Binding Path=Color}" Stroke="#CC505050" VerticalAlignment="Top" Width="24"/>
                                <TextBlock HorizontalAlignment="Left" Margin="32,2,0,0" Foreground="#FF646464" TextWrapping="Wrap" Text="{Binding Path=ColorName}" VerticalAlignment="Top"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox x:Name="preview_text" Background="White" Margin="10,70,51,0" Text="هلا سكنت بذي ضغث فقد زعموا &#xD;&#xA;شخصت تطلب ظبيا راح مجتازا" TextAlignment="Center" AutoWordSelection="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AcceptsTab="True" Height="75" VerticalAlignment="Top" BorderBrush="#FF6C4500">
                    <!--<TextBox.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
