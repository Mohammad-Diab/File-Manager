<Window x:Class="File_Manager.File_s_Transferring_Error"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What do you want to do" Height="510" Width="550" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Icon="Images/Appearance/empty.png">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
            <GradientStop Color="LightPink" Offset="1"/>
            <GradientStop Color="White" Offset="0.9"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Margin="10,10,0,0" Foreground="DarkBlue" FontSize="22"><Run Text="What do you want to do?"/><LineBreak/><Run x:Name="sub_containt" Foreground="Black" FontSize="14" Text="File Operation Error."/></TextBlock>
        <RadioButton x:Name="retry_radiobutton" Content="Retry all" HorizontalAlignment="Right" Margin="0,65,115,0" VerticalAlignment="Top" FontSize="15" Checked="RetryAll_Checked" Unchecked="RetryAll_Unchecked"/>
        <RadioButton x:Name="skip_radiobutton" Content="Skip all" HorizontalAlignment="Right" Margin="0,65,20,0" VerticalAlignment="Top" FontSize="15" Checked="SkipAll_Checked" Unchecked="SkipAll_Unchecked"/>
        <Rectangle Height="1" Margin="0,85,0,0" Stroke="Chocolate" VerticalAlignment="Top"/>
        <Button Content="Skip All" HorizontalAlignment="Left" Margin="10,0,0,9" Width="75" Click="Cancel_Click" Grid.Row="1" Height="22" VerticalAlignment="Bottom" Background="{x:Null}"/>
        <Button Content="Done" HorizontalAlignment="Right" Margin="0,0,10,9" VerticalAlignment="Bottom" Width="75" Height="22" Click="Done_Click" Grid.Row="1" Background="{x:Null}"/>
        <TextBlock x:Name="source_checkbox_Copy" Text="Items" HorizontalAlignment="Left" Margin="10,65,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Button Content="Retry All" HorizontalAlignment="Left" Margin="90,0,0,9" VerticalAlignment="Bottom" Width="75" Height="22" Click="Retry_Click" Grid.Row="1" Background="{x:Null}"/>
        <ListView Margin="0,85,0,0" x:Name="container" Background="{x:Null}" ItemsSource="{Binding}" SelectionChanged="Container_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Width="500">
                        <RadioButton Margin="0,20,100,0" IsChecked="{Binding Path=RetryIsChecked}" HorizontalAlignment="Right" FontSize="14" Content="Retry" VerticalAlignment="Top" Click="ItemRadio_Click"/>
                        <RadioButton Margin="0,20,10,0" IsChecked="{Binding Path=SkipIsChecked}" HorizontalAlignment="Right" FontSize="14" Content="Skip" VerticalAlignment="Top" Click="ItemRadio_Click"/>
                        <TextBlock Margin="10, 0, 0, 0" Text="{Binding Path=FileName}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Foreground="#FF646464"/>
                        <TextBlock Margin="48,24,0,0" Text="{Binding Path=FileType}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                        <TextBlock Margin="48,43,0,0" Text="{Binding Path=ErrorMsg}" ToolTip="{Binding Path=ErrorMsg}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Foreground="Red"/>
                        <Image Source="{Binding Path=Icon}" Height="32" Margin="10, 24, 0, 0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="32"/>
                        <Rectangle Fill="YellowGreen" Height="1" Margin="0, 64, 0, 0" VerticalAlignment="Top"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
