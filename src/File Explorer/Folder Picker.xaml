<Window x:Class="File_Explorer.Folder_Picker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Picker" Height="350" Width="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded_1" ShowInTaskbar="False" Icon="Images/Appearance/empty.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <TreeView x:Name="FolderExplorer" Margin="10,10,10,5"/>
        <Button Content="OK" HorizontalAlignment="Right" Margin="0,5,10,5" Width="75" Click="OK_Click" Grid.Row="1"/>
        <Button Content="New directory" HorizontalAlignment="Left" Margin="10,7,0,7" Grid.Row="1" Click="CreateDirectory_Click" Width="86" />
    </Grid>
</Window>
