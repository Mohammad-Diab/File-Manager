<Window x:Class="File_Manager.Big_File_Finder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big File Finder" Height="425" Width="502" MinWidth="400" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <TreeView x:Name="ItemsTree" Margin="10,10,10,45" Grid.ColumnSpan="4"/>
        <Button Content="Select Folder" VerticalAlignment="Bottom" Margin="10,0,10,10" Height="30" Click="FindBigItems_Click"/>
        <Button x:Name="DeleteItems" Content="Delete Selected Items" VerticalAlignment="Bottom" Margin="10,0,10,10" Height="30" IsEnabled="False" Click="DeleteItems_Click" Grid.Column="3"/>
        <Button Content="Select all" Height="31" Margin="10,0,10,10" VerticalAlignment="Bottom" Click="SelectAll_Click" Grid.Column="1"/>
        <Button Content="Clear List" Height="31" Margin="10,0,10,10" VerticalAlignment="Bottom" Click="ClearList_Click" Grid.Column="2"/>
    </Grid>
</Window>
