<Window x:Class="File_Manager.about_app"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:File_Manager"
        Title="About File Manager" Height="620" Width="460" MinWidth="360" MinHeight="320" FlowDirection="LeftToRight" WindowStartupLocation="CenterScreen" Background="White" Icon="App Icon.ico" FontSize="14">
    <Grid>
        <TextBlock Margin="15,8,15,0" TextTrimming="CharacterEllipsis" Text="About File Manager" VerticalAlignment="Top" Foreground="Gray" FontSize="26"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,50,0,45">
            <local:About_Panel Margin="10,0,10,0" Foreground="#FF41403B"/>
        </ScrollViewer>
        <Rectangle Height="1" Margin="10,0,10,44" VerticalAlignment="Bottom" Fill="#FFDDDDDD"/>
        <Button x:Name="Closes" Content="Close" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Height="26" Background="{x:Null}" Foreground="Gray" BorderBrush="Gray" Click="Close_Click" IsCancel="True" IsDefault="True"/>
    </Grid>
</Window>
