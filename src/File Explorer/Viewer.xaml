<Window x:Class="File_Manager.Viewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viewer" Height="480" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="14" AllowsTransparency="False" WindowStyle="None" Loaded="Window_Loaded_1" KeyUp="Window_KeyUp_1">
    <Grid x:Name="Grid1" Background="#FF41403B">
        <Grid x:Name="MediaElement" Visibility="Collapsed">
            <MediaElement x:Name="MediaViewer" LoadedBehavior="Manual" UnloadedBehavior="Manual" MediaFailed="MediaViewer_MediaFailed"/>
            <Grid x:Name="MediaControl" Margin="250,420,250,0">
                <Image Height="60" Margin="0,0,0,0" VerticalAlignment="Bottom" Source="Images/Appearance/media-controller-background.png"/>
                <Button Content="Pause" Margin="28,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Click="Pause_Media"/>
                <Slider x:Name="MediaSlider" HorizontalAlignment="Right" Height="24" Margin="0,19,24,0" VerticalAlignment="Top" Width="160" SmallChange="1" Maximum="100" PreviewMouseLeftButtonUp="v"/>
                <Button Content="Mute" Margin="70,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Click="Mute_Media"/>
            </Grid>
            <TextBlock x:Name="Error" Margin="50,180,50,0" TextWrapping="Wrap" Foreground="#FFDD0000" FontSize="20" Text="" TextAlignment="Center" VerticalAlignment="Top"/>
        </Grid>
        <WebBrowser x:Name="WebPageViewer" Margin="0,20,0,0" Visibility="Collapsed"/>
        <Grid x:Name="Text" Visibility="Collapsed" Margin="0,20,0,0">
            <RichTextBox x:Name="TextViewer" IsReadOnly="True" VerticalScrollBarVisibility="Visible" Background="{x:Null}" Foreground="White" SelectionBrush="#FFFF9933"/>
            <Grid x:Name="TextControl" Margin="250,400,250,0" Height="60" VerticalAlignment="Top">
                <Image Height="60" Margin="0,0,0,0" VerticalAlignment="Bottom" Source="Images/Appearance/media-controller-background.png"/>
                <ComboBox x:Name="TextEncoding" Margin="18,17,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100" SelectionChanged="ComboBox_SelectionChanged_1">
                    <ComboBoxItem Content="ASCII"/>
                    <ComboBoxItem Content="BigEndianUnicode"/>
                    <ComboBoxItem Content="Unicode"/>
                    <ComboBoxItem Content="UTF32"/>
                    <ComboBoxItem Content="UTF7"/>
                    <ComboBoxItem Content="UTF8"/>
                </ComboBox>
                <Button x:Name="EditText" Content="Edit" Margin="123,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Click="Text_Editing"/>
                <Button Content="🔺" Margin="0,18,40,19" HorizontalAlignment="Right" Click="Save_Text"/>
                <Button Content="🔻" Margin="0,18,20,19" HorizontalAlignment="Right"/>
                <TextBox x:Name="Search_Text" HorizontalAlignment="Left" Margin="155,20,0,20" TextWrapping="Wrap" Text="Search" Width="84" TextChanged="TextBox_TextChanged_1"/>
            </Grid>
        </Grid>
        <Grid x:Name="ImageElement" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="ImageViewer" Stretch="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"/>
            </ScrollViewer>
            <Grid x:Name="ImageControl" Margin="250,420,250,0">
                <Image Height="60" Margin="0,0,0,0" VerticalAlignment="Bottom" Source="Images/Appearance/media-controller-background.png"/>
                <Button Content="Left" Margin="25,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <Button Content="zoom in" Margin="60,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Click="Zoom_In"/>
                <Button Content="Save" Margin="123,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <Button Content="Zoom out" Margin="0,18,70,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                <Button Content="Right" Margin="0,18,25,0" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Rotate_Right"/>
            </Grid>
        </Grid>
        <Grid x:Name="Unknown" Visibility="Collapsed">
            <Image x:Name="ItemImage" Margin="40,100,0,124" HorizontalAlignment="Left" Width="256"/>
            <StackPanel x:Name="FileInfo" Margin="0,82,40,98" HorizontalAlignment="Right" Width="400" CanVerticallyScroll="True" ScrollViewer.CanContentScroll="True">
                <TextBlock Margin="10" x:Name="name" TextWrapping="Wrap" Foreground="White"/>
                <TextBlock Margin="10" x:Name="size" TextWrapping="Wrap" Foreground="White"/>
                <TextBlock Margin="10" x:Name="type" TextWrapping="Wrap" Foreground="White"/>
                <TextBlock Margin="10" x:Name="created" TextWrapping="Wrap" Foreground="White"/>
                <TextBlock Margin="10" x:Name="modified" TextWrapping="Wrap" Foreground="White"/>
                <TextBlock Margin="10" x:Name="Accessed" TextWrapping="Wrap" Foreground="White"/>
                <ProgressBar Margin="10" x:Name="driveusage" Height="20" Visibility="Collapsed"/>
            </StackPanel>
            <Button x:Name="OpenUnknoun" Margin="300,410,300,24" Content="Open File" Click="OpenFile"/>
        </Grid>
        <Grid x:Name="Archive" Visibility="Collapsed">
            <Image x:Name="ArchiveImage" Margin="40,100,0,124" HorizontalAlignment="Left" Width="256"/>
            <StackPanel x:Name="ArchiveInfo" Margin="0,82,40,100" HorizontalAlignment="Right" Width="400" CanVerticallyScroll="True" ScrollViewer.CanContentScroll="True">
                <TextBlock Margin="10" x:Name="ArchiveName" TextWrapping="Wrap" Foreground="White"/>
                <TextBlock Margin="10" x:Name="ArchiveSize" TextWrapping="Wrap" Foreground="White"/>
                <TextBlock Margin="10" x:Name="ArchiveType" TextWrapping="Wrap" Foreground="White"/>
                <ProgressBar Margin="10" x:Name="CompressRate" Height="20" Visibility="Collapsed"/>
            </StackPanel>
            <Button Margin="450,410,200,24" Content="Explorer File" Click="OpenFile"/>
            <Button Margin="200,410,450,24" Content="Extract files" Click="Extract"/>
        </Grid>
        <DocumentViewer x:Name="XPSViewer"  Background="{x:Null}" Visibility="Collapsed" Margin="0,21,0,0"/>
        <TextBlock x:Name="FileName" TextWrapping="Wrap" Foreground="White" Visibility="Visible" TextAlignment="Center" FontSize="16" VerticalAlignment="Top"/>
    </Grid>
</Window>
