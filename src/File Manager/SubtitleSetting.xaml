                            <GradientStop Color="White" Offset="0.355"/>
                            <GradientStop Color="#FFC8C8C8" Offset="0.375"/>
                            <GradientStop Color="White" Offset="0.395"/>
                            <GradientStop Color="White" Offset="0.04"/>
                            <GradientStop Color="White" Offset="0.426"/>
                            <GradientStop Color="#FFC8C8C8" Offset="0.446"/>
