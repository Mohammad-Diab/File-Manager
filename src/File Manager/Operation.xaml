<Window x:Class="File_Manager.Operation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Operation" Width="550" ResizeMode="CanMinimize" ScrollViewer.CanContentScroll="True" Height="160" Icon="Images/Appearance/file-operation.png" Activated="Window_Activated" Deactivated="Window_Deactivated" Closing="Window_Closing">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo Description="Pause this operation" ImageSource="Images/Menu/copy-pause.png" Click="Pause_ThumbButtonInfo_Click"/>
                <ThumbButtonInfo Description="Resume this operation" ImageSource="Images/Menu/copy-start.png" Click="Start_ThumbButtonInfo_Click"/>
                <ThumbButtonInfo Description="Stop this operation" ImageSource="Images/Menu/copy-stop.png" Click="Stop_ThumbButtonInfo_Click"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid>
        <StackPanel Orientation="Vertical" Height="75" VerticalAlignment="Top" HorizontalAlignment="Left">
            <TextBlock x:Name="remain_title" Margin="0,2,0,0" Text="Remaining" HorizontalAlignment="Stretch" VerticalAlignment="Top" TextAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="remain" Margin="0,-5,0,0" Width="125" HorizontalAlignment="Left" Text="88.8" VerticalAlignment="Top" FontSize="48" Foreground="DodgerBlue" TextAlignment="Center"/>
                <TextBlock x:Name="remain_unit" HorizontalAlignment="Left" Text="Items" Margin="0,0,0,10" VerticalAlignment="Bottom" FontSize="14"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="operation" HorizontalAlignment="Left" Margin="160,4,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16" Text="Collecting Files:" Foreground="DodgerBlue"/>
        <ProgressBar x:Name="progress_bar" Height="10" Margin="175,54,50,0" VerticalAlignment="Top" Foreground="DodgerBlue"  IsIndeterminate="True"/>
        <TextBlock x:Name="name_textblock" Margin="175,30,10,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"><Run Text="Name: "/><Run Text=" "/><Run x:Name="item_name"/></TextBlock>
        <Button HorizontalAlignment="Right" Margin="0,5,50,0" VerticalAlignment="Top" Background="{x:Null}" Width="20" Height="20" Click="Stop_Click" BorderBrush="{x:Null}">
            <Button.Content>
                <Image Source="Images/Menu/copy-stop.png"/>
            </Button.Content>
        </Button>
        <Button HorizontalAlignment="Right" Margin="0,5,85,0" VerticalAlignment="Top" Width="20" Height="20" Background="{x:Null}" x:Name="pause_button" Click="PlayPause_Click" BorderBrush="{x:Null}">
            <Button.Content>
                <Image x:Name="play_pause_img" Source="Images/Menu/copy-pause.png"/>
            </Button.Content>
        </Button>
        <TextBlock x:Name="percent" FontSize="14" HorizontalAlignment="Right" Width="40" Margin="0,49,5,0" TextWrapping="Wrap" Text="0%" VerticalAlignment="Top" TextAlignment="Center"/>
        <Image x:Name="cut_sign_image" HorizontalAlignment="Right" Height="24" Margin="0,67,10,0" VerticalAlignment="Top" ToolTip="This file is being moved." Width="24" Source="Images/Appearance/operation-cut-sign.png" Visibility="Collapsed"/>
        <Grid x:Name="speed_graph" Height="20" Margin="175,68,50,0" VerticalAlignment="Top" Background="#08000000">
            <Polyline x:Name="speed_line" Stroke="DodgerBlue" StrokeThickness="1.5"/>
        </Grid>
        <TextBlock x:Name="speed_textblock" HorizontalAlignment="Left" Margin="287,95,0,0" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Speed: "/><Run x:Name="speed" Foreground="#FF1E90FF" FontWeight="Bold" FontSize="16" Text="0 byte/s"/></TextBlock>
        <TextBlock x:Name="complete_textblock" HorizontalAlignment="Left" Margin="10,95,0,0" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Completed: "/><Run x:Name="completed" Foreground="DodgerBlue" FontWeight="Bold" FontSize="16" Text="0"/><Run Foreground="DodgerBlue" x:Name="complete_item_run" FontWeight="Bold" FontSize="16" Text=" item"/><Run  Foreground="DodgerBlue" FontWeight="Bold" FontSize="16" x:Name="more_than_one" Text="s"/></TextBlock>
    </Grid>
</Window>
