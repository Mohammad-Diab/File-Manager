<Window x:Class="File_Manager.Empty_Folder_Remover"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empty directories remover" Height="400" Width="450" Closing="Window_Closing">
    <Grid>
        <ListView x:Name="items_list" Margin="10,41,10,27" ItemsSource="{Binding}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Margin="28,2,0,0" Text="{Binding Path=FullPath}" HorizontalAlignment="Left" FontSize="14"/>
                        <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button ToolTip="Search in folder" Margin="10,5,0,0" VerticalAlignment="Top" Click="FindEmptey_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Button.Content>
                <Image Source="Images/Appearance/folder-search.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button x:Name="delete_items" ToolTip="Delete selected items" Margin="0,5,84,0" VerticalAlignment="Top" Click="DeleteItems_Click" IsEnabled="False" Background="{x:Null}" HorizontalAlignment="Right">
            <Button.Content>
                <Image Source="Images/Appearance/delete.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button x:Name="select_all" ToolTip="Select all items" Margin="0,5,121,0" VerticalAlignment="Top" Click="SelectAll_Click" Background="{x:Null}" HorizontalAlignment="Right" IsEnabled="False">
            <Button.Content>
                <Image Source="Images/Appearance/select-all.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button x:Name="clear_list" ToolTip="Clear List" Margin="0,5,47,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" IsEnabled="False">
            <Button.Content>
                <Image Source="Images/Appearance/list-clear.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Setting" Margin="0,5,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}">
            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <TextBlock Margin="10,0,24,10" Text="" VerticalAlignment="Bottom" FontSize="14"/>
        <ProgressBar x:Name="progressbar" Height="21" Margin="47,11,158,0" VerticalAlignment="Top" Maximum="5100" Visibility="Hidden"/>
        <Grid x:Name="caution" Height="22" VerticalAlignment="Bottom" Visibility="Visible">
            <Rectangle Fill="Black" Height="22" Stroke="Black" VerticalAlignment="Bottom" Opacity="0.5"/>
            <Rectangle Height="21" VerticalAlignment="Bottom" Opacity="0.9" RenderTransformOrigin="0.5,0.5">
                <Rectangle.Stroke>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFB40100" Offset="0"/>
                        <GradientStop Color="#FFDC02FF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Stroke>
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                        <GradientStop Color="#FFB40100" Offset="1"/>
                        <GradientStop Color="#FFDC0200"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock Text="Caution: It's strongly recomanded to run this tools as adminstrator." TextTrimming="CharacterEllipsis" Foreground="WhiteSmoke" FontSize="14" TextAlignment="Center" Height="20" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,1,0,0"/>
        </Grid>
    </Grid>
</Window>
