<Window x:Class="File_Manager.New_Shortcut"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:File_Manager"
        mc:Ignorable="d"
        Title="Shortcut Creator" Height="290" Width="500" FontSize="14" FontFamily="Segoe UI" MaxWidth="500" Loaded="Window_Loaded" ResizeMode="NoResize">
    <Grid>
        <Grid x:Name="mother" Margin="0,0,0,0">
            <Grid Width="490" HorizontalAlignment="Left">
                <TextBox x:Name="s_path" Margin="125,99,30,0" VerticalAlignment="Top"/>
                <TextBox x:Name="s_name" Margin="125,129,10,0" VerticalAlignment="Top"/>
                <TextBox x:Name="o_path" Margin="125,69,30,0" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,131,0,0" TextWrapping="Wrap" Text="Shortcut name" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,101,0,0" TextWrapping="Wrap" Text="Shortcut path" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,71,0,0"  TextWrapping="Wrap" Text="Original path" VerticalAlignment="Top"/>
                <Button Content="..." ToolTip="Browse" HorizontalAlignment="Right" Margin="0,99,10,0" VerticalAlignment="Top" Width="21" Click="SelectLinkDestination_Click" Background="{x:Null}" Height="21"/>
                <Button Content="..." ToolTip="Browse" HorizontalAlignment="Right" Margin="0,69,10,0" VerticalAlignment="Top" Width="21" Click="SelectOrginalItem_Click" Background="{x:Null}" Height="21"/>
                <Button Content="Create" Margin="150,0,155,10" VerticalAlignment="Bottom" Click="CreateShortcut_Click" Background="{x:Null}"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,191,0,0" TextWrapping="Wrap" Text="Icon" VerticalAlignment="Top"/>
                <TextBox x:Name="desc" Margin="125,159,10,0" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,161,0,0" TextWrapping="Wrap" Text="Description" VerticalAlignment="Top"/>
                <TextBox x:Name="icon_path" Margin="125,189,30,0" VerticalAlignment="Top"/>
                <Button Content="..." ToolTip="Browse" HorizontalAlignment="Right" Margin="0,189,10,0" VerticalAlignment="Top" Width="21" Click="SelectIcon_Click" Background="{x:Null}" Height="21"/>
                <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Margin="10,40,0,0" FontSize="18" Foreground="#FF195310" Text="Shortcut information" VerticalAlignment="Top"/>
            </Grid>
            <Grid Margin="500,0,0,0" Width="490" HorizontalAlignment="Left">
                <TextBox x:Name="j_path" Margin="125,104,30,0" VerticalAlignment="Top"/>
                <TextBox x:Name="d_path" Margin="125,69,30,0" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Junction target"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,71,0,0"  TextWrapping="Wrap" Text="Source path" VerticalAlignment="Top"/>
                <Button Content="..." ToolTip="Browse" HorizontalAlignment="Right" Margin="0,104,10,0" VerticalAlignment="Top" Width="21" Click="SelectJunctionTarget_Click" Background="{x:Null}" Height="21"/>
                <Button Content="..." ToolTip="Browse" HorizontalAlignment="Right" Margin="0,69,10,0" VerticalAlignment="Top" Width="21" Click="SelectSourceDirectory_Click" Background="{x:Null}" Height="21"/>
                <Button Content="Create" Margin="150,0,155,10" VerticalAlignment="Bottom" Click="CreateJunction_Click" Background="{x:Null}"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,165,0,0" VerticalAlignment="Top" Foreground="#FF6DAB21" FontSize="20" Text="      Target must be an empty directory."/>
                <Image Source="Images/Appearance/dialog-information.png" Margin="10,165,0,0" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Width="25"/>
                <CheckBox x:Name="create_direcory" Content="Create directory if it is not exist." HorizontalAlignment="Left" Margin="125,135,0,0" VerticalAlignment="Top" IsChecked="True"/>
                <TextBlock x:Name="textBlock_Copy" HorizontalAlignment="Left" Margin="10,40,0,0" FontSize="18" Foreground="#FF195310" Text="Junction information" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
        <StackPanel VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="NEW SHORTCUT" FontSize="18" Background="White" MouseUp="Label1_MouseUp" Cursor="Hand"/>
            <Label x:Name="label2" Content="NEW JUNCTION" FontSize="18" Foreground="White" Background="Black" MouseUp="label2_MouseUp" Cursor="Hand"/>
        </StackPanel>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,30,0,0" VerticalAlignment="Top" Width="143"/>
    </Grid>
</Window>
