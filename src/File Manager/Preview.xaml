                        <TextBlock TextWrapping="NoWrap" Text="Version: 1.3" Foreground="White" FontSize="18"/>
                        <TextBlock TextWrapping="NoWrap" Text="__________________________________________________________" Foreground="White" FontSize="18"/>
                        <TextBlock TextWrapping="NoWrap" Text="abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ" Foreground="White" FontSize="18"/>
