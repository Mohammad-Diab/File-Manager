<Window x:Class="File_Manager.Operation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Operation" Width="550" ResizeMode="CanMinimize" ScrollViewer.CanContentScroll="True" Height="175" Icon="Images/Appearance/file-operation.png">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo Description="Pause this operation" ImageSource="Images/Menu/copy-pause.png" Click="Pause_ThumbButtonInfo_Click"/>
                <ThumbButtonInfo Description="Resume this operation" ImageSource="Images/Menu/copy-start.png" Click="Start_ThumbButtonInfo_Click"/>
                <ThumbButtonInfo Description="Stop this operation" ImageSource="Images/Menu/copy-stop.png" Click="Stop_ThumbButtonInfo_Click"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid>
        <TextBlock x:Name="remain" HorizontalAlignment="Left" Margin="10,13,0,0" Text="0" VerticalAlignment="Top" FontSize="48" Foreground="RoyalBlue"/>
        <TextBlock x:Name="remain_unit" HorizontalAlignment="Left" Margin="41,47,0,0" Text="Items" VerticalAlignment="Top" FontSize="14"/>
        <TextBlock x:Name="remain_title" HorizontalAlignment="Left" Margin="10,10,0,0" Text="Remaining" VerticalAlignment="Top" Width="65" TextAlignment="Center"/>
        <ProgressBar x:Name="progress_bar" Height="10" Margin="10,92,125,0" VerticalAlignment="Top" Foreground="DodgerBlue" IsIndeterminate="True"/>
        <TextBlock Margin="10,71,34,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"><Run Text="Name: "/><Run Text=" "/><Run x:Name="item_name"/></TextBlock>
        <TextBlock Margin="10,107,10,0" VerticalAlignment="Top" FontSize="14" TextTrimming="CharacterEllipsis"><Run x:Name="operation" Text="Collecting Files"/><Run Text=": "/><Run x:Name="completed" Foreground="Green" FontSize="16"/><Run Text=" item"/><Run x:Name="more_than_one" Text="s"/><Run Text=" completed"/><Run x:Name="to"/><Run Text=" @ "/><Run x:Name="speed" Foreground="Green" FontSize="16"/></TextBlock>
        <Button HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Background="{x:Null}" Click="Stop_Click">
            <Button.Content>
                <Image Source="Images/Menu/copy-stop.png" Width="32" Height="32"/>
            </Button.Content>
        </Button>
        <Button HorizontalAlignment="Right" Margin="0,10,51,0" VerticalAlignment="Top" Background="{x:Null}" x:Name="pause_button" Click="PlayPause_Click">
            <Button.Content>
                <Image x:Name="play_pause_img" Source="Images/Menu/copy-pause.png" Width="32" Height="32"/>
            </Button.Content>
        </Button>
        <TextBlock x:Name="percent" HorizontalAlignment="Right" Margin="0,87,53,0" TextWrapping="Wrap" FontSize="15" Text="0%" VerticalAlignment="Top"/>
        <Image x:Name="cut_sign_image" HorizontalAlignment="Right" Height="24" Margin="0,67,10,0" VerticalAlignment="Top" ToolTip="This file is being moved." Width="24" Source="Images/Appearance/operation-cut-sign.png" Visibility="Collapsed"/>
    </Grid>
</Window>
