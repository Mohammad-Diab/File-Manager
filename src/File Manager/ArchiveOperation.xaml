<Window x:Class="File_Manager.ArchiveOperation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:File_Manager"
        mc:Ignorable="d"
        Title="File Operation" Width="550" ResizeMode="CanMinimize" ScrollViewer.CanContentScroll="True" Height="140" Icon="Images/Appearance/file-operation.png">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="play_pause_taskbar" Description="Resume this operation" ImageSource="Images/Menu/copy-start.png" Click="Start_ThumbButtonInfo_Click"/>
                <ThumbButtonInfo Description="Stop this operation" ImageSource="Images/Menu/copy-stop.png" Click="Stop_ThumbButtonInfo_Click"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid>
        <TextBlock x:Name="remain" HorizontalAlignment="Left" Margin="5,5,0,0" Text="8.88" VerticalAlignment="Top" Width="90" FontSize="48" Foreground="MediumPurple" TextAlignment="Center"/>
        <TextBlock x:Name="remain_unit" HorizontalAlignment="Left" Margin="100,40,0,0" Text="byte" VerticalAlignment="Top" FontSize="14"/>
        <TextBlock x:Name="remain_title" HorizontalAlignment="Left" Margin="5,2,0,0" Text="Remaining" VerticalAlignment="Top" Width="90" TextAlignment="Center"/>
        <ProgressBar x:Name="progress_bar" Height="10" Margin="140,54,50,0" VerticalAlignment="Top" Maximum="100" Foreground="MediumPurple" IsIndeterminate="True"/>
        <Button HorizontalAlignment="Right" Height="20" Width="20" Margin="0,5,50,0" VerticalAlignment="Top" Background="{x:Null}" Click="Stop_Click" BorderBrush="{x:Null}">
            <Button.Content>
                <Image Source="Images/Menu/copy-stop.png"/>
            </Button.Content>
        </Button>
        <Button HorizontalAlignment="Right" Height="20" Width="20" Margin="0,5,85,0" VerticalAlignment="Top" Background="{x:Null}" x:Name="pause_button" Click="PlayPause_Click" BorderBrush="{x:Null}">
            <Button.Content>
                <Image x:Name="play_pause_img" Source="Images/Menu/copy-pause.png"/>
            </Button.Content>
        </Button>
        <TextBlock x:Name="percent" HorizontalAlignment="Right" Margin="0,49,5,0" TextWrapping="Wrap" FontSize="14" Text="0%" VerticalAlignment="Top" Width="40" TextAlignment="Center"/>
        <TextBlock HorizontalAlignment="Left" Margin="135,4,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16" Text="Creating archive:" Foreground="MediumPurple"/>
        <TextBlock x:Name="archive_name" Margin="140,30,10,0" Text="File name" VerticalAlignment="Top" FontSize="14"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,75,0,0" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Speed: "/><Run x:Name="speed_text" Foreground="MediumPurple" FontWeight="Bold" FontSize="16" Text="0 byte/s"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="290,75,0,0" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Time: "/><Run Foreground="MediumPurple" FontWeight="Bold" x:Name="time_text" FontSize="16" Text="0 days"/></TextBlock>
    </Grid>
</Window>
