                        <Grid x:Name="slider_mover_element" HorizontalAlignment="Left" Width="20" MouseEnter="SliderMoverElement_MouseEnter" MouseLeave="SliderMoverElement_MouseLeave" PreviewMouseLeftButtonDown="SliderMoverElement_PreviewMouseLeftButtonDown">
                            <Ellipse Fill="DarkBlue"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="RoyalBlue" Offset="1"/>
                                        <GradientStop Color="SkyBlue"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Margin="6">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="Blue" Offset="1"/>
                                        <GradientStop Color="LightBlue"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="a_volume_value" HorizontalAlignment="Right" Margin="0,0,19,0" TextWrapping="Wrap" Text="Volume: 75%" VerticalAlignment="Top" Foreground="White" FontSize="12"/>
                </Grid>
                <Grid x:Name="video_player" Visibility="Collapsed" MouseMove="VedioPlayerGrid_MouseMove" MouseWheel="VedioPlayerGrid_MouseWheel" Background="#FF404040">
