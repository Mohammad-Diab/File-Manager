<Window x:Class="Music_Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Music_Player"
        mc:Ignorable="d"
        Title="MainWindow" AllowsTransparency="True" Height="270" Width="480" ResizeMode="CanMinimize" WindowStyle="None">
    <Grid>
        <Grid x:Name="grid" Opacity="0.5" Margin="26,94,0,0" HorizontalAlignment="Left" Width="433" VerticalAlignment="Top">
            <TextBlock x:Name="text01" Visibility="Hidden" HorizontalAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="36"><Run FlowDirection="RightToLeft" Text="الشطر الاول ......"/></TextBlock>
            <TextBlock x:Name="text02" Visibility="Hidden" HorizontalAlignment="Left" Margin="0,60,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="36"><Run FlowDirection="RightToLeft" Text="الشطر الثاني ....."/></TextBlock>
        </Grid>
        <Button Content="Button" HorizontalAlignment="Left" Margin="10,240,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
        <TextBox x:Name="text" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" Width="75"/>
        <Button Content="play/pause" HorizontalAlignment="Left" Margin="131,231,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click_1"/>
        <Button Content="stop" HorizontalAlignment="Left" Margin="211,231,0,0" VerticalAlignment="Top" Width="75"/>
        <Button Content="add subtitle" HorizontalAlignment="Left" Margin="291,231,0,0" VerticalAlignment="Top" Width="75" Click="AddSubtitle_Click"/>
        <Slider x:Name="slider" Margin="10,211,51,0" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Right" Margin="0,212,6,0" TextWrapping="Wrap" Text="00:00" VerticalAlignment="Top" Width="40"/>
        <MediaElement x:Name="media" HorizontalAlignment="Right" Height="10" VerticalAlignment="Top" Width="10" MediaOpened="Audio_MediaOpened"/>

    </Grid>
</Window>
