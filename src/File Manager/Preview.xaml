                        </Button>
                        <TextBlock x:Name="video_current_position_time" Margin="80,293,225,0" TextWrapping="Wrap" Text="00:00" VerticalAlignment="Top" Foreground="White" TextAlignment="Center" FontSize="36"/>
                        <Grid Height="20" Margin="2,346,180,0" VerticalAlignment="Top" PreviewMouseLeftButtonUp="SliderMoverElement_PreviewMouseLeftButtonUp" >
                            <Rectangle x:Name="v_slider_background" Fill="#FFF4F4F5" Height="6" Margin="10,7,10,0" VerticalAlignment="Top" StrokeThickness="1" Stroke="Black" RadiusY="3" RadiusX="3"/>
                            <Rectangle x:Name="v_slider_forground" Fill="LightSkyBlue" HorizontalAlignment="Left" Height="4" Margin="11,8,0,0" VerticalAlignment="Top" Width="0" StrokeThickness="1" RadiusY="2" RadiusX="2"/>
                            <Grid x:Name="v_slider_mover_element" HorizontalAlignment="Left" Width="20" MouseEnter="SliderMoverElement_MouseEnter" MouseLeave="SliderMoverElement_MouseLeave" PreviewMouseLeftButtonDown="SliderMoverElement_PreviewMouseLeftButtonDown">
                                <Ellipse Fill="DarkBlue"/>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="RoyalBlue" Offset="1"/>
                                            <GradientStop Color="SkyBlue"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Margin="6">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="Blue" Offset="1"/>
                                            <GradientStop Color="LightBlue"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
