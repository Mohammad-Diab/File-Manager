<Window x:Class="File_Explorer.File_s_transferring_Error"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What do you want to do" Height="500" Width="525" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Icon="Images/Appearance/empty.png">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
            <GradientStop Color="LightSkyBlue" Offset="1"/>
            <GradientStop Color="White" Offset="0.902"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <ScrollViewer Margin="0,88,0,37" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="container"/>
        </ScrollViewer>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Margin="10,10,0,0" Foreground="DarkBlue" FontSize="22"><Run Text="What do you want to do?"/><LineBreak/><Run x:Name="sub_containt" Foreground="Black" FontSize="14" Text="Some files have not transferred successfully."/></TextBlock>
        <RadioButton x:Name="retry_radiobutton" Content="Retry all" HorizontalAlignment="Right" Margin="0,65,115,0" VerticalAlignment="Top" FontSize="15" Checked="RetryAll_Checked" Unchecked="RetryAll_Unchecked"/>
        <RadioButton x:Name="skip_radiobutton" Content="Skip all" HorizontalAlignment="Right" Margin="0,65,20,0" VerticalAlignment="Top" FontSize="15" Checked="SkipAll_Checked" Unchecked="SkipAll_Unchecked"/>
        <Rectangle Fill="YellowGreen" Height="1" Margin="0,85,0,0" Stroke="YellowGreen" VerticalAlignment="Top"/>
        <Button Content="Skip All" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Width="75" Height="22" Background="White" Opacity="0.9" Click="Cancel_Click"/>
        <Button Content="Done" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Height="22" Background="White" Opacity="0.9" Click="OK_Click"/>
        <TextBlock x:Name="source_checkbox_Copy" Text="Files" HorizontalAlignment="Left" Margin="10,65,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Button Content="Retry All" HorizontalAlignment="Left" Margin="90,0,0,10" VerticalAlignment="Bottom" Width="75" Height="22" Background="White" Opacity="0.9" Click="Retry_Click"/>
    </Grid>
</Window>
