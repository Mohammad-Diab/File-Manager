<Window x:Class="File_Manager.MultiDirectoriesSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-Directories Selector" Height="400" Width="375" SizeChanged="Window_SizeChanged" WindowStartupLocation="CenterScreen">
    <Grid>
        <ListBox x:Name="list_of_directories" Margin="10,68,10,10" SelectionChanged="ListOfDirectories_SelectionChanged" SelectionMode="Extended"/>
        <Button ToolTip="Add folder" Margin="10,5,0,0" VerticalAlignment="Top" Click="AddFolder_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="Clear list" Margin="84,5,0,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="Done" ToolTip="Done" Margin="0,5,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Click="Done_Click">
            <Image Source="Images/Appearance/done.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="remove_selected" ToolTip="Remove selected files" Margin="47,5,0,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Left" Background="{x:Null}" IsEnabled="False">
            <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="Add folder" Margin="0,42,10,0" VerticalAlignment="Top" Click="AddFolderFromPath_Click" HorizontalAlignment="Right" Background="{x:Null}">
            <Image Source="Images/Appearance/list-add.png" Height="17" Width="17" Stretch="UniformToFill"/>
        </Button>
        <TextBlock x:Name="path_box_label" Margin="12,43,37,0" Text="You can also put path here, then click on -->" VerticalAlignment="Top" FontSize="14" Foreground="#FF292929" Opacity="0.5"/>
        <TextBox x:Name="to_add_path" Margin="10,42,36,0" VerticalAlignment="Top" FontSize="14" Background="{x:Null}" GotKeyboardFocus="to_add_path_GotKeyboardFocus" LostKeyboardFocus="to_add_path_LostKeyboardFocus" PreviewKeyDown="search_PreviewKeyDown"/>
    </Grid>
</Window>
