<Window x:Class="File_Manager.Renamer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renamer" Height="430" Width="400" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListView x:Name="FilesList" Margin="10,42,10,79" SelectionMode="Multiple"/>
        <Button Margin="0,0,10,10" VerticalAlignment="Bottom" Click="Rename_Click" Height="32" Background="RoyalBlue" Foreground="White" HorizontalAlignment="Right" Width="109">
            <Button.Content>
                <Grid Width="105" Height="28">
                    <TextBlock Text="Rename" Foreground="WhiteSmoke" Margin="35,5,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Image Source="Images/Appearance/rename.png" Width="28" Stretch="Fill" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                </Grid>
            </Button.Content>
        </Button>
        <TextBox x:Name="extension" Height="23" Margin="10,0,150,32" TextWrapping="Wrap" VerticalAlignment="Bottom" TextChanged="extension_TextChanged" FontSize="16"/>
        <TextBlock FontSize="14" HorizontalAlignment="Left" Margin="10,0,0,55" Text="Type new extension here (without any dots):" VerticalAlignment="Bottom" Foreground="Blue" TextTrimming="CharacterEllipsis"/>
        <CheckBox x:Name="remove_extension" Content="Remove old extension" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" FontSize="14" Foreground="Red" BorderBrush="Green" IsChecked="True"/>
        <Button ToolTip="Add files" Margin="10,5,0,0" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Button.Content>
                <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Add folder (add all files in it)" Margin="47,5,0,0" VerticalAlignment="Top" Click="AddFolder_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Button.Content>
                <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Clear list" Margin="0,5,47,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}">
            <Button.Content>
                <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Setting" Margin="0,5,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}">
            <Button.Content>
                <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Remove selected files" Margin="0,5,84,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}">
            <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
    </Grid>
</Window>
