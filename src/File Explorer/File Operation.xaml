<Window x:Class="File_Explorer.File_Operation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Operation" Width="520" ResizeMode="NoResize" ScrollViewer.CanContentScroll="True" Loaded="Window_Loaded" Height="95" Icon="Images/Appearance/file-operation.png">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo Description="Pause this operation" ImageSource="Images/Menu/copy-pause.png" Click="Pause_ThumbButtonInfo_Click"/>
                <ThumbButtonInfo Description="Start or continue this operation" ImageSource="Images/Menu/copy-start.png" Click="Start_ThumbButtonInfo_Click"/>
                <ThumbButtonInfo Description="Stop this operation" ImageSource="Images/Menu/copy-stop.png" Click="Stop_ThumbButtonInfo_Click"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid>
            <ProgressBar x:Name="PB" Margin="10,0,0,5" HorizontalAlignment="Left" Width="400" Height="20" VerticalAlignment="Bottom">
            <ProgressBar.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="DarkBlue" Offset="0.1"/>
                    <GradientStop Color="RoyalBlue" Offset="0.9"/>
                    <GradientStop Color="Blue" Offset="0.5"/>
                </LinearGradientBrush>
            </ProgressBar.Foreground>
        </ProgressBar>
        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Copying..." VerticalAlignment="Top"/>
        <Button HorizontalAlignment="Right" Margin="0,0,10,5" Width="32" Height="32" VerticalAlignment="Bottom" Background="{x:Null}" Click="Stop_Click">
            <Button.Content>
                <Image Source="Images/Menu/copy-stop.png" />
            </Button.Content>
        </Button>
            <Button x:Name="play_pause" HorizontalAlignment="Right" Margin="0,0,47,5" Width="32" Height="32" VerticalAlignment="Bottom" Background="{x:Null}" Click="PlayPause_Click">
            <Button.Content>
                <Image x:Name="play_pause_img" Source="Images/Menu/copy-start.png"/>
            </Button.Content>
        </Button>
        <TextBlock Margin="181,0,0,7" TextWrapping="Wrap" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="60" TextAlignment="Center" Foreground="#FFFF3232"><Run x:Name="percent" Text="0"/><Run Text="%"/></TextBlock>
    </Grid>
</Window>
