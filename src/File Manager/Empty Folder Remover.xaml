<Window x:Class="File_Manager.Empty_Folder_Remover"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empty Folder Remover" Height="400" Width="400" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TreeView x:Name="ItemsTree" Margin="10,42,10,10"/>
        <Button ToolTip="Search in folder" Margin="10,5,0,0" VerticalAlignment="Top" Click="FindEmptey_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Button.Content>
                <Image Source="Images/Appearance/folder-search.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button x:Name="DeleteItems" ToolTip="Delete selected items" Margin="0,5,84,0" VerticalAlignment="Top" Click="DeleteItems_Click" IsEnabled="False" Background="{x:Null}" HorizontalAlignment="Right">
            <Button.Content>
                <Image Source="Images/Appearance/delete.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Select all items" Margin="0,5,121,0" VerticalAlignment="Top" Click="SelectAll_Click" Background="{x:Null}" HorizontalAlignment="Right" IsEnabled="False">
            <Button.Content>
                <Image Source="Images/Appearance/select-all.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Clear List" Margin="0,5,47,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" IsEnabled="False">
            <Button.Content>
                <Image Source="Images/Appearance/list-clear.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Setting" Margin="0,5,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}">
            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
    </Grid>
</Window>
