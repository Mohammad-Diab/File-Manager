<Window x:Class="File_Manager.Directory_Explorer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:File_Manager"
        mc:Ignorable="d"
        Title="Files Manager (APPS PREVIEW)" MinWidth="450" Width="800" Height="525" WindowStartupLocation="Manual" Icon="App Icon.ico" Loaded="Window_Loaded">
    <Grid>
        <StackPanel Height="25" VerticalAlignment="Bottom" Orientation="Horizontal"/>

        <Grid VerticalAlignment="Top" Margin="45,3,0,0">
            <StackPanel Height="25" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Button HorizontalAlignment="Left" Width="24" Height="24" Background="{x:Null}" Margin="0,1,0,0">
                    <Button.Content>
                        <Image Stretch="Fill" Source="Images/Explorer Interface/back.png"/>
                    </Button.Content>
                </Button>
                <Button HorizontalAlignment="Left" Margin="-1,1,0,0" Width="24" Height="24" Background="{x:Null}">
                    <Button.Content>
                        <Image Stretch="Fill" Source="Images/Explorer Interface/front.png"/>
                    </Button.Content>
                </Button>
                <Button HorizontalAlignment="Left" Width="16" Background="{x:Null}" BorderBrush="{x:Null}" Height="12" VerticalAlignment="Bottom" Margin="-1,0,0,1">
                    <Button.Content>
                        <Image Stretch="Fill" Source="Images/Explorer Interface/down.png"/>
                    </Button.Content>
                </Button>
                <Rectangle Width="1" Fill="#FF4B9B9B" Margin="5,1,0,0"/>
            </StackPanel>
            <Grid x:Name="address_grid" Margin="73,2,211,0" VerticalAlignment="Top">
                <Button Height="21" HorizontalAlignment="Left" Margin="0,0,0,0" Width="14" Background="{x:Null}" BorderBrush="{x:Null}">
                    <Button.Content>
                        <Image Stretch="Fill" Source="Images/Explorer Interface/up.png"/>
                    </Button.Content>
                </Button>
                <TextBox x:Name="address_textblock" FontSize="14" Text="root" VerticalAlignment="Top" Margin="14,0,20,0" BorderBrush="#FF707070" PreviewKeyUp="AddressTextBlock_PreviewKeyUp"/>
                <Button HorizontalAlignment="Right" Margin="0,0,0,0" Width="21" Height="21" Background="{x:Null}">
                    <Button.Content>
                        <Image Stretch="Fill" Height="17" Width="17" Source="Images/Explorer Interface/refresh.png"/>
                    </Button.Content>
                </Button>
            </Grid>
            <Grid VerticalAlignment="Top" HorizontalAlignment="Right" Width="200" Margin="0,2,0,0">
                <Grid>
                    <TextBlock FontSize="14" TextWrapping="Wrap" Margin="5,0,26,0" Text="filter or search" FontStyle="Italic" Foreground="Gray"/>
                    <TextBox x:Name="filter_TextBox" FontSize="14" TextWrapping="Wrap" Margin="0,0,26,0" BorderBrush="#FF707070" Background="Transparent"/>
                </Grid>
                <Button HorizontalAlignment="Right" Width="21" Margin="0,0,6,0" Height="21" Background="{x:Null}">
                    <Button.Content>
                        <Image Stretch="Fill" Height="17" Width="17" Source="Images/Explorer Interface/search.png"/>
                    </Button.Content>
                </Button>
            </Grid>
            <Rectangle Fill="#FF4B9B9B" Margin="0,2,205,3" HorizontalAlignment="Right" Width="1"/>
        </Grid>

        <Grid x:Name="content" Margin="0,0,0,0">
            <Grid HorizontalAlignment="Left" Margin="0,30,0,25" Width="200" Background="#FF404040">
                <StackPanel Background="Black" x:Name="navigation_panal" Orientation="Horizontal" Height="34" VerticalAlignment="Top">
                    <Grid Height="34" Background="White" Cursor="Hand" ToolTip="Quick access list" PreviewMouseLeftButtonUp="Navigation_Click" Tag="Quick access">
                        <Image Source="Images/Explorer Interface/quick-access.png" Margin="0,0,0,4" HorizontalAlignment="Left" Width="30"/>
                        <TextBlock Margin="32,6,5,0" Text="Quick access" VerticalAlignment="Top" FontSize="14"/>
                    </Grid>
                    <Grid Height="34" Background="Black" Cursor="Hand" ToolTip="Bookmarks" Margin="0,0,0,0" PreviewMouseLeftButtonUp="Navigation_Click" Tag="Bookmarks">
                        <Image Source="Images/Explorer Interface/bookmark.png" Margin="0,0,0,4" HorizontalAlignment="Left" Width="30"/>
                        <TextBlock VerticalAlignment="Top" Foreground="Black"/>
                    </Grid>
                    <Grid Height="34" Background="Black" Cursor="Hand" ToolTip="History" Margin="0,0,0,0" PreviewMouseLeftButtonUp="Navigation_Click" Tag="History">
                        <Image Source="Images/Explorer Interface/history.png" Margin="0,0,0,6" Height="28" HorizontalAlignment="Left" Width="28"/>
                        <TextBlock VerticalAlignment="Top" Foreground="Black"/>
                    </Grid>
                </StackPanel>
                <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Width="115" Margin="0,30,0,0" VerticalAlignment="Top" Height="4"/>
                <Grid x:Name="quick_access_grids" Margin="0,34,0,0">
                    <Grid HorizontalAlignment="Left" Width="200">
                        <ListBox x:Name="quick_access_list" ItemsSource="{Binding}" Background="#FF404040" BorderBrush="{x:Null}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" MaxHeight="24" IsEnabled="{Binding Path=IsEnable}" Background="#00404040">
                                        <Image Margin="0" Source="{Binding Path=Image}" Height="{Binding Path=ImageHigh}" Width="{Binding Path=ImageHigh}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        <TextBlock Margin="5,0,0,0" Text="{Binding Path=FullPath}" HorizontalAlignment="Left" Foreground="{Binding Path=TextForeground}" FontSize="{Binding Path=FontSize}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Visibility="Collapsed" HorizontalAlignment="Left" Width="200" Margin="200,0,0,0">
                        <StackPanel>
                            <Grid Margin="5,5,0,0">
                                <Image HorizontalAlignment="Left" Height="24" Margin="5,1,0,0" VerticalAlignment="Top" Width="24" Stretch="Fill" Source="Images/Explorer Interface/bookmark.png"/>
                                <TextBlock HorizontalAlignment="Left" Margin="34,0,0,0" TextWrapping="Wrap" Text="Bookmarks" VerticalAlignment="Top" Foreground="White" FontSize="20"/>
                            </Grid>
                            <Grid Margin="5,5,5,0">
                                <Button Content="Add this location" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" Width="90"/>
                                <Button Content="Manage" HorizontalAlignment="Left" Margin="100,0,0,0" VerticalAlignment="Top" Width="90"/>
                            </Grid>
                            <ListBox x:Name="bookmark_list" Margin="5" Background="#FF404040" BorderBrush="{x:Null}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Visibility="Collapsed" HorizontalAlignment="Left" Width="200" Margin="400,0,0,0">
                        <StackPanel>
                            <Grid Margin="5,5,0,0">
                                <Image HorizontalAlignment="Left" Height="24" Margin="5,1,0,0" VerticalAlignment="Top" Width="24" Stretch="Fill" Source="Images/Explorer Interface/history.png"/>
                                <TextBlock HorizontalAlignment="Left" Margin="34,0,0,0" TextWrapping="Wrap" Text="History" VerticalAlignment="Top" Foreground="White" FontSize="20"/>
                            </Grid>
                            <Grid Margin="5,5,5,0">
                                <Button Content="Manage" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" Width="90"/>
                                <Button Content="Clear" HorizontalAlignment="Left" Margin="100,0,0,0" VerticalAlignment="Top" Width="90"/>
                            </Grid>
                            <ListBox x:Name="history_list" Margin="5" Background="#FF404040" BorderBrush="{x:Null}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Margin="205,33,10,25">
                <ListView x:Name="directories_list" Visibility="Collapsed" TextBlock.TextAlignment="Right" ItemsSource="{Binding}" Foreground="#FF41403B" Background="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Path=Icon}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                            <TextBlock Margin="4,4,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Path=FileSize}"/>
                            <GridViewColumn Header="Type" Width="85" DisplayMemberBinding="{Binding Path=FileType}"/>
                            <GridViewColumn Header="Data Modified" Width="100" DisplayMemberBinding="{Binding Path=DateModified}"/>
                        </GridView>
                    </ListView.View>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Expander IsExpanded="True" Header="{Binding Name}" Foreground="DimGray" FontSize="18">
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event='MouseDoubleClick' Handler='DirectoryItem_DoubleClick'/>
                        </Style>
                    </ListView.Resources>
                </ListView>
                <ListView x:Name="root_list" Visibility="Visible" TextBlock.TextAlignment="Right" ItemsSource="{Binding}" Foreground="#FF41403B" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Height="48" Width="200" ToolTip="{Binding Path=toolTip}">
                                <Image Margin="0" Source="{Binding Path=Image}" Height="48" Width="48" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                <TextBlock Margin="10,2,0,0" Text="{Binding Path=FullPath}" HorizontalAlignment="Left" FontSize="14" TextWrapping="Wrap" MaxHeight="48"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Expander IsExpanded="True" Header="{Binding Name}" Foreground="DimGray" FontSize="18">
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event='MouseDoubleClick' Handler='RootItem_DoubleClick'/>
                        </Style>
                    </ListView.Resources>
                </ListView>
                <TextBlock x:Name="info_textblock" Visibility="Collapsed" Margin="10,25,10,0" TextWrapping="Wrap" Text="This directory is empty." VerticalAlignment="Top" FontSize="14" TextAlignment="Center" Foreground="#FF404040"/>
            </Grid>
            <Grid x:Name="back_grid" Margin="-250,0,0,0" Background="#00000000" Visibility="Collapsed" PreviewMouseUp="Background_PreviewMouseUp"/>
            <Grid x:Name="file_menu" HorizontalAlignment="Left" Margin="-250,30,0,25" Width="450" Visibility="Visible" Background="#FF404040">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Rectangle Fill="White" Margin="10,10,0,0" HorizontalAlignment="Left" Width="25" Height="3" VerticalAlignment="Top"/>
                <Rectangle Fill="White" Margin="10,17,0,0" HorizontalAlignment="Left" Width="25" Height="3" VerticalAlignment="Top"/>
                <Rectangle Fill="White" Margin="10,24,0,0" HorizontalAlignment="Left" Width="25" Height="3" VerticalAlignment="Top"/>
                <TextBlock Text="FILE MANAGER" Foreground="WhiteSmoke" FontSize="22" Margin="45,3,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <Grid Margin="0,0,0,0" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="menu_list" Background="{x:Null}" BorderBrush="{x:Null}" SelectionChanged="Menu_SelectionChanged">
                        <ListViewItem Height="32">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/new.png"/>
                                <TextBlock Text="NEW" VerticalAlignment="Top" Foreground="White" Margin="5,0,0,0" FontSize="14"/>
                            </StackPanel>
                        </ListViewItem>
                        <StackPanel Orientation="Horizontal" Height="32">
                            <Image Width="20" Height="20" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/new.png"/>
                            <TextBlock Text="DETAILS" VerticalAlignment="Top" Foreground="White" Margin="5,6,0,0" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="32">
                            <Image Width="20" Height="20" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/edit.png"/>
                            <TextBlock Text="EDIT" VerticalAlignment="Top" Foreground="White" Margin="5,6,0,0" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="32">
                            <Image Width="20" Height="20" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/view.png"/>
                            <TextBlock Text="VIEW" VerticalAlignment="Top" Foreground="White" Margin="5,6,0,0" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="32">
                            <Image Width="20" Height="20" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/tools.png"/>
                            <TextBlock Text="TOOLS" VerticalAlignment="Top" Foreground="White" Margin="5,6,0,0" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="32">
                            <Image Width="20" Height="20" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/recent.png"/>
                            <TextBlock Text="RECENT" VerticalAlignment="Top" Foreground="White" Margin="5,6,0,0" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="32">
                            <Image Width="20" Height="20" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/option.png"/>
                            <TextBlock Text="OPTIONS" VerticalAlignment="Top" Foreground="White" Margin="5,6,0,0" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="32">
                            <Image Width="20" Height="20" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/help.png"/>
                            <TextBlock Text="HELP" VerticalAlignment="Top" Foreground="White" Margin="5,6,0,0" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="32">
                            <Image Width="20" Height="20" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/exit.png"/>
                            <TextBlock Text="EXIT" VerticalAlignment="Top" Foreground="White" Margin="5,6,0,0" FontSize="14"/>
                        </StackPanel>
                    </ListView>

                    <Grid x:Name="new_menu_grid" Grid.Column="1" Margin="7,0,0,0" Visibility="Collapsed">
                        <ListBox x:Name="listBox" Margin="10,42,10,10" Background="{x:Null}" BorderBrush="{x:Null}">
                            <StackPanel Orientation="Horizontal" Height="32">
                                <Image Width="24" Height="24" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/new-directory.png"/>
                                <TextBlock Text="Create directory" VerticalAlignment="Top" Foreground="White" Margin="5,5,0,0" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="32">
                                <Image Width="24" Height="24" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/new-file.png"/>
                                <TextBlock Text="Create file" VerticalAlignment="Top" Foreground="White" Margin="5,5,0,0" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="32">
                                <Image Width="24" Height="24" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/new-shortcut.png"/>
                                <TextBlock Text="Create shortcut" VerticalAlignment="Top" Foreground="White" Margin="5,5,0,0" FontSize="16"/>
                            </StackPanel>
                            <ListBoxItem Background="WhiteSmoke" Height="2" HorizontalAlignment="Stretch" Width="250" IsEnabled="False" Margin="0,5,0,5"/>
                            <StackPanel Orientation="Horizontal" Height="32">
                                <Image Width="24" Height="24" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/new-tab.png"/>
                                <TextBlock Text="New tab" VerticalAlignment="Top" Foreground="White" Margin="5,5,0,0" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="32">
                                <Image Width="24" Height="24" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/new-window.png"/>
                                <TextBlock Text="New window" VerticalAlignment="Top" Foreground="White" Margin="5,5,0,0" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="32">
                                <Image Width="24" Height="24" Margin="5,0,0,0" Stretch="Fill" Source="Images/Explorer Interface/new-window-admin.png"/>
                                <TextBlock Text="New window (admin)" VerticalAlignment="Top" Foreground="White" Margin="5,5,0,0" FontSize="16"/>
                            </StackPanel>
                        </ListBox>
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="NEW" VerticalAlignment="Top" Foreground="White" FontSize="20"/>
                    </Grid>

                    <Grid x:Name="details_menu_grid" Grid.Column="1" Margin="7,0,0,0" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="DETAILS" VerticalAlignment="Top" Foreground="White" FontSize="20"/>
                        <!--info abaut selected index and attrepute-->
                    </Grid>

                    <Grid x:Name="edit_menu_grid" Grid.Column="1" Margin="7,0,0,0" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="EDIT" VerticalAlignment="Top" Foreground="White" FontSize="20"/>
                        <!--Cut Copy paste undo redo select-all select-non invaled-selection-->
                    </Grid>

                    <Grid x:Name="view_menu_grid" Grid.Column="1" Margin="7,0,0,0" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="VIEW" VerticalAlignment="Top" Foreground="White" FontSize="20"/>
                        <ScrollViewer Margin="10,42,0,0" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <CheckBox Content="Show hidden files" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Background="#FFABABAB" FontSize="16" BorderBrush="#FF8F8F8F" Foreground="White"/>
                                <CheckBox Content="Show files extension" HorizontalAlignment="Left" Margin="10,35,0,0" VerticalAlignment="Top" Background="#FFABABAB" FontSize="16" BorderBrush="#FF8F8F8F" Foreground="White"/>
                                <Rectangle Fill="WhiteSmoke" Height="1" HorizontalAlignment="Left" Width="250" IsEnabled="False" Margin="10,65,0,0" VerticalAlignment="Top"/>
                                <TextBlock HorizontalAlignment="Left" Margin="10,71,0,0" Text="View mode" VerticalAlignment="Top" Foreground="White" FontSize="18"/>
                                <ListView SelectedIndex="3" Height="120" Margin="20,100,10,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="White" FontSize="16">
                                    <ListViewItem Content="Icons"/>
                                    <ListViewItem Content="Large icons"/>
                                    <ListViewItem Content="List"/>
                                    <ListViewItem Content="Details"/>
                                    <ListViewItem Content="Tiles"/>
                                    <ListViewItem Content="panels"/>
                                </ListView>
                                <Rectangle Fill="WhiteSmoke" Height="1" HorizontalAlignment="Left" Width="250" IsEnabled="False" Margin="10,235,0,0" VerticalAlignment="Top"/>
                                <TextBlock HorizontalAlignment="Left" Margin="10,241,0,0" Text="Sort by" VerticalAlignment="Top" Foreground="White" FontSize="18"/>
                                <RadioButton x:Name="radioButton" Content="Name" HorizontalAlignment="Left" Margin="20,270,0,0" FontSize="16" VerticalAlignment="Top" Background="#FFABABAB" BorderBrush="#FF8F8F8F" Foreground="White"/>
                                <RadioButton x:Name="radioButton_Copy" Content="Type" HorizontalAlignment="Left" Margin="20,295,0,0" FontSize="16" VerticalAlignment="Top" Background="#FFABABAB" BorderBrush="#FF8F8F8F" Foreground="White"/>
                                <RadioButton x:Name="radioButton_Copy1" Content="Size" HorizontalAlignment="Left" Margin="20,320,0,0" FontSize="16" VerticalAlignment="Top" Background="#FFABABAB" BorderBrush="#FF8F8F8F" Foreground="White"/>
                                <RadioButton x:Name="radioButton_Copy2" Content="Last modified date" HorizontalAlignment="Left" Margin="20,345,0,0" FontSize="16" VerticalAlignment="Top" Background="#FFABABAB" BorderBrush="#FF8F8F8F" Foreground="White"/>
                                <Rectangle Fill="WhiteSmoke" Height="1" HorizontalAlignment="Left" Width="175" IsEnabled="False" Margin="20,375,0,0" VerticalAlignment="Top"/>
                                <ToggleButton x:Name="button1" IsChecked="True" HorizontalAlignment="Left" Margin="24,390,0,50" VerticalAlignment="Top" Width="146" HorizontalContentAlignment="Left" Background="{x:Null}">
                                    <ToggleButton.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="24" Height="24"/>
                                            <TextBlock Text="Ascending" Margin="5,1,0,0" Foreground="White" FontSize="14" Height="20"/>
                                        </StackPanel>
                                    </ToggleButton.Content>
                                </ToggleButton>

                            </Grid>
                        </ScrollViewer>

                    </Grid>

                    <Grid x:Name="tools_menu_grid" Grid.Column="1" Margin="7,0,0,0" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="TOOLS" VerticalAlignment="Top" Foreground="White" FontSize="20"/>
                        <ListBox Margin="0,42,0,0" Background="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <Grid Margin="5" Height="75" Width="130" ToolTip="Compressed files manager">
                                <Image Stretch="Fill"/>
                                <Rectangle Height="20" VerticalAlignment="Bottom" Fill="#54000000"/>
                                <TextBlock Text="Compressed files manager" Foreground="White" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Margin="5" Height="75" Width="130" ToolTip="System monitor">
                                <Image Stretch="Fill"/>
                                <Rectangle Height="20" VerticalAlignment="Bottom" Fill="#54000000"/>
                                <TextBlock Text="System monitor" Foreground="White" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Margin="5" Height="75" Width="130" ToolTip="Super extension changer">
                                <Image Stretch="Fill"/>
                                <Rectangle Height="20" VerticalAlignment="Bottom" Fill="#54000000"/>
                                <TextBlock Text="Super extension changer" Foreground="White" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Margin="5" Height="75" Width="130" ToolTip="Duplicat files remover">
                                <Image Stretch="Fill"/>
                                <Rectangle Height="20" VerticalAlignment="Bottom" Fill="#54000000"/>
                                <TextBlock Text="Duplicat files remover" Foreground="White" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Margin="5" Height="75" Width="130" ToolTip="Directory analyzer">
                                <Image Stretch="Fill"/>
                                <Rectangle Height="20" VerticalAlignment="Bottom" Fill="#54000000"/>
                                <TextBlock Text="Directory analyzer" Foreground="White" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Margin="5" Height="75" Width="130" ToolTip="Empty directories remover">
                                <Image Stretch="Fill"/>
                                <Rectangle Height="20" VerticalAlignment="Bottom" Fill="#54000000"/>
                                <TextBlock Text="Empty directories remover" Foreground="White" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Margin="5" Height="75" Width="130" ToolTip="Files destoyer">
                                <Image Stretch="Fill"/>
                                <Rectangle Height="20" VerticalAlignment="Bottom" Fill="#54000000"/>
                                <TextBlock Text="Files destoyer" Foreground="White" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Margin="5" Height="75" Width="130" ToolTip="Files encreptor">
                                <Image Stretch="Fill"/>
                                <Rectangle Height="20" VerticalAlignment="Bottom" Fill="#54000000"/>
                                <TextBlock Text="Files encreptor" Foreground="White" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Margin="5" Height="75" Width="130" ToolTip="Virtual Machine">
                                <Image Stretch="Fill"/>
                                <Rectangle Height="20" VerticalAlignment="Bottom" Fill="#54000000"/>
                                <TextBlock Text="Virtual Machine" Foreground="White" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom"/>
                            </Grid>
