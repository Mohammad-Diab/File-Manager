<Window x:Class="File_Manager.Files_Encrepter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encrypt files" Height="550" Width="405" Closing="Window_Closing" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid x:Name="main_grid">
            <StackPanel x:Name="tab_panal" Height="36" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
                <Label x:Name="label1" Content="ENCRYPT FILES" FontSize="18" Background="White" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
                <Label x:Name="label2" Content="DE-ENCRYPT FILES" FontSize="18" Foreground="White" Background="Black" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
            </StackPanel>

            <Grid x:Name="mother" Margin="0,0,0,0">
                <Grid HorizontalAlignment="Left" Width="400" AllowDrop="True"  Drop="EncOutputText_Drop">
                    <Button x:Name="encrypt_add_button" ToolTip="Add files" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}" Margin="10,42,0,0">
                        <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="encrypt_add_folder_button" ToolTip="Add folder (add all files in it)" Margin="47,42,0,0" VerticalAlignment="Top" Click="AddDirectory_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="encrypt_clear_button" ToolTip="Clear list" Margin="0,42,52,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button ToolTip="Setting" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Margin="0,42,15,0">
                        <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="encrypt_remove_button" ToolTip="Remove selected files" Margin="0,42,89,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <ListView x:Name="encrypt_list" Margin="10,80,15,190" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}" AllowDrop="True" Drop="EncryptList_Drop">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ContextMenu="{Binding Menu}">
                                    <TextBlock Margin="28,4,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left"/>
                                    <Image Margin="0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Rectangle Fill="#FF9CC9F0" Height="2" Margin="10,0,50,175" VerticalAlignment="Bottom"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,0,0,145" TextWrapping="Wrap" Text="Encrypt options" VerticalAlignment="Bottom" Foreground="#FF003397" FontSize="20"/>
                    <Button VerticalAlignment="Bottom" Content="Encrypt" Foreground="White" Click="Encrypt_Click" Height="32" Background="#FF40E2E2" FontSize="20" HorizontalAlignment="Right" Width="109" Margin="0,0,15,10"/>
                    <TextBox x:Name="enc_password_text" Margin="100,0,65,70" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                    <PasswordBox x:Name="enc_password" Margin="100,0,65,70" VerticalAlignment="Bottom" MaxLength="128"/>
                    <TextBlock HorizontalAlignment="Left" Margin="20,0,0,70" TextWrapping="Wrap" Text="Password:" FontSize="14" VerticalAlignment="Bottom"/>
                    <Button x:Name="enc_show_password" Content="Show" HorizontalAlignment="Right" Margin="0,0,15,69" VerticalAlignment="Bottom" Width="45" Background="{x:Null}" Click="ShowPassword_Click"/>
                    <TextBox x:Name="enc_output" Margin="20,0,65,100" Text="D:\" VerticalAlignment="Bottom" MaxLines="1" MaxLength="248"/>
                    <Button x:Name="encrypt_browser_button" Content="Browse" HorizontalAlignment="Right" Margin="0,0,15,99" VerticalAlignment="Bottom" Width="45" Height="20" Background="{x:Null}" Click="Browser_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="20,0,0,120" TextWrapping="Wrap" Text="Save output files in" VerticalAlignment="Bottom" FontSize="14"/>
                    <CheckBox x:Name="enc_delete_files" Content="Secure delete files after encryption." HorizontalAlignment="Left" Margin="20,0,0,20" VerticalAlignment="Bottom" FontSize="14" Foreground="Red" BorderBrush="Green" IsChecked="False"/>
                    <TextBlock Margin="20,0,0,50" Text="All files in the list will be encrypt with this password" VerticalAlignment="Bottom" Foreground="Green" HorizontalAlignment="Left"/>
                </Grid>

                <Grid HorizontalAlignment="Left" Margin="405,0,0,0" Width="400" AllowDrop="True">
                    <Button ToolTip="Add files" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}" Margin="10,42,0,0">
                        <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button ToolTip="Add folder (add all files in it)" Margin="47,42,0,0" VerticalAlignment="Top" Click="AddDirectory_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button ToolTip="Clear list" Margin="0,42,52,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button ToolTip="Setting" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Margin="0,42,15,0">
                        <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button ToolTip="Remove selected files" Margin="0,42,89,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <ListView x:Name="decrypt_list" Margin="10,80,15,180" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}" AllowDrop="True" Drop="DecryptList_Drop">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ContextMenu="{Binding Menu}">
                                    <TextBlock Margin="28,4,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left"/>
                                    <Image Margin="0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Rectangle Fill="#FF9CC9F0" Height="2" Margin="10,0,50,165" VerticalAlignment="Bottom"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,0,0,135" TextWrapping="Wrap" Text="Decrypt options" VerticalAlignment="Bottom" Foreground="#FF003397" FontSize="20"/>
                    <Button VerticalAlignment="Bottom" Click="Decrypt_Click" Height="32" Background="#FF883CD4" Foreground="White" HorizontalAlignment="Right" Width="109" Margin="0,0,15,10">
                        <Button.Content>
                            <Grid Width="105" Height="28">
                                <TextBlock Text="De-encrypt" Foreground="White" Margin="35,5,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Image Source="Images/Appearance/rename.png" Width="28" Stretch="Fill" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <PasswordBox x:Name="dec_password" Margin="100,0,65,60" VerticalAlignment="Bottom" MaxLength="128"/>
                    <TextBlock HorizontalAlignment="Left" Margin="20,0,0,60" TextWrapping="Wrap" Text="Password:" FontSize="14" VerticalAlignment="Bottom"/>
                    <TextBox x:Name="dec_password_text" Margin="100,0,65,60" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                    <Button x:Name="dec_show_password" Content="Show" HorizontalAlignment="Right" Margin="0,0,15,59" VerticalAlignment="Bottom" Width="45" Background="{x:Null}" Click="ShowPassword_Click"/>
                    <TextBox x:Name="dec_output" Margin="20,0,65,90" Text="D:\" VerticalAlignment="Bottom" MaxLines="1" MaxLength="248" AllowDrop="True" Drop="DecOutputText_Drop"/>
                    <Button Content="Browse" HorizontalAlignment="Right" Margin="0,0,15,89" VerticalAlignment="Bottom" Width="45" Height="20" Background="{x:Null}" Click="Browser_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="20,0,0,110" TextWrapping="Wrap" Text="Save output files in" VerticalAlignment="Bottom" FontSize="14"/>
                    <TextBlock Margin="20,0,124,22" TextWrapping="Wrap" Text="Be sure that all files in list have the same password." VerticalAlignment="Bottom" Foreground="Red" MaxHeight="36"/>
                </Grid>
            </Grid>
            <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,32,0,0" VerticalAlignment="Top" Width="125"/>
        </Grid>
    </Grid>
</Window>
