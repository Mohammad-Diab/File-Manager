<Window x:Class="File_Manager.System_Monitor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System_Monitor" Height="350" Width="550">
    <Grid x:Name="GridContainer">
        <ListView x:Name="ProcessList" ItemsSource="{Binding}" Margin="5,43,5,5">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding Path=PID}"/>
                    <GridViewColumn Header="Name" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ContextMenu="{Binding Path=Menu}">
                                    <TextBlock Margin="28,4,0,0" Text="{Binding Path=ProcessName}" HorizontalAlignment="Left"/>
                                    <Image Margin="0" Source="{Binding Path=Icon}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Memory" Width="90" DisplayMemberBinding="{Binding Path=Memory}"/>
                    <GridViewColumn Header="CPU" Width="75" DisplayMemberBinding="{Binding Path=CPU}"/>
                    <GridViewColumn Header="Threads" Width="80" DisplayMemberBinding="{Binding Path=Threads}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button x:Name="EndProcess" IsEnabled="False" ToolTip="Ask to close" HorizontalAlignment="Left" VerticalAlignment="Top" Width="28" Margin="10,10,0,0" Height="28"/>
        <Button x:Name="EndProcess_Copy" IsEnabled="False" ToolTip="Kill" HorizontalAlignment="Left" VerticalAlignment="Top" Width="28" Margin="43,10,0,0" Height="28"/>
        <Button x:Name="Refresh" ToolTip="Refresh" HorizontalAlignment="Left" VerticalAlignment="Top" Width="28" Click="Refresh_Click" Margin="76,10,0,0" Height="28"/>
    </Grid>
</Window>
