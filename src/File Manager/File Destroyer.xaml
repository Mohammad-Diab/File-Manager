<Window x:Class="File_Manager.File_Destroyer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Files Destroyer" Height="525" Width="405" Closing="Window_Closing" SizeChanged="Window_SizeChanged" Loaded="Window_Loaded">
    <Grid x:Name="main_grid">
        <StackPanel x:Name="tab_panal" Height="36" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="DESTROY FILES" FontSize="18" Background="White" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
            <Label x:Name="label2" Content="DESTROY ALL DELETED FILES" FontSize="18" Foreground="White" Background="Black" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
        </StackPanel>

        <Grid x:Name="mother" Margin="0,0,0,0">
            <Grid HorizontalAlignment="Left" Width="400">
                <Button ToolTip="Add files" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}" Margin="10,42,0,0" BorderBrush="Black">
                    <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                </Button>
                <Button ToolTip="Add folder (add all files in it)" Margin="47,42,0,0" VerticalAlignment="Top" Click="AddFolder_Click" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="Black">
                    <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                </Button>
                <Button ToolTip="Clear list" Margin="0,42,52,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" BorderBrush="Black">
                    <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                </Button>
                <Button ToolTip="Setting" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Margin="0,42,15,0" BorderBrush="Black">
                    <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
                </Button>
                <Button ToolTip="Remove selected files" Margin="0,42,89,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}" BorderBrush="Black">
                    <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                </Button>
                <ListView x:Name="files_list" Margin="10,79,15,150" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}" AllowDrop="True" Drop="FilesList_Drop" BorderBrush="Black">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ContextMenu="{Binding Menu}">
                                <TextBlock Margin="28,4,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left"/>
                                <Image Margin="0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Rectangle Fill="#FF9CC9F0" Height="2" Margin="10,0,50,140" VerticalAlignment="Bottom"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,0,0,108" Text="Destroy options" VerticalAlignment="Bottom" Foreground="#FF003397" FontSize="20"/>
                <CheckBox x:Name="delete_files" Content="Delete files after destroy." HorizontalAlignment="Left" Margin="20,0,0,20" VerticalAlignment="Bottom" FontSize="14" Foreground="Red" BorderBrush="Black" IsChecked="True"/>
                <Button VerticalAlignment="Bottom" Content="Destroy" FontSize="16" Click="Destroy_Click" Height="32" Background="Black" Foreground="White" HorizontalAlignment="Right" Width="109" Margin="0,0,15,10">
                    <!--<Button.Content>
                        <Grid Width="105" Height="28">
                            <TextBlock Text="Destroy" Foreground="WhiteSmoke" Margin="35,5,0,4" FontSize="14" HorizontalAlignment="Left"/>
                            <Image Width="28" Stretch="Fill" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                    </Button.Content>-->
                </Button>
                <TextBlock HorizontalAlignment="Left" Text="Repetitions of operation:" VerticalAlignment="Bottom" FontSize="16" Margin="20,0,0,49" Foreground="#FF011F5B"/>
                <ComboBox x:Name="method_cb" SelectedIndex="0" HorizontalAlignment="Left"  Margin="215,0,0,79" VerticalAlignment="Bottom" Width="150" Foreground="Black" Background="{x:Null}">
                    <!--<ComboBoxItem Content="Quick destroy (random)"/>-->
                    <ComboBoxItem Content="Quick destroy (zeros)"/>
                    <ComboBoxItem Content="Quick destroy (ones)"/>
                    <ComboBoxItem Content="Secure destroy"/>
                </ComboBox>
                <TextBox x:Name="repete_tb" HorizontalAlignment="Left" Margin="215,0,0,49" TextWrapping="Wrap" Text="1" VerticalAlignment="Bottom" Width="150" FontSize="14" MaxLength="2" TextAlignment="Center"/>
                <TextBlock HorizontalAlignment="Left" Margin="20,0,0,80" Text="Destroy method" VerticalAlignment="Bottom" FontSize="16" Foreground="#FF011F5B"/>
            </Grid>

            <Grid Margin="405,0,0,0" HorizontalAlignment="Left" Width="400">
                <TextBlock HorizontalAlignment="Left" Margin="10,50,0,0" TextWrapping="Wrap" Text="This tool makes your deleted files unrecoverable." VerticalAlignment="Top" FontSize="16" Foreground="Maroon" Width="354"/>
                <ScrollViewer Margin="10,76,10,0" VerticalScrollBarVisibility="Auto">
                    <Grid Background="White" Height="400">
                        <TextBlock Margin="0,10,10,0" TextWrapping="Wrap" Text="To begin choose disk letter then click on start button below" VerticalAlignment="Top" FontSize="16" MaxHeight="65"/>
                        <ComboBox x:Name="drive_list" Margin="198,68,40,0" VerticalAlignment="Top" FontSize="14" SelectionChanged="DriveList_SelectionChanged" BorderBrush="Maroon"/>
                        <Button x:Name="refresh" ToolTip="refresh drives list" HorizontalAlignment="Right" Margin="0,68,10,0" VerticalAlignment="Top" Height="25" Background="{x:Null}" Click="RefreshList_Click" Width="25" BorderBrush="Maroon">
                            <Image Source="Images/Appearance/view-refresh.png" Stretch="Fill"/>
                        </Button>
                        <ComboBox x:Name="disk_method_cb" Margin="198,243,10,0" VerticalAlignment="Top" FontSize="14" SelectedIndex="0" SelectionChanged="DriveList_SelectionChanged" BorderBrush="Maroon">
                            <!--<ComboBoxItem Content="Quick destroy (random)"/>-->
                            <ComboBoxItem Content="Quick destroy (zeros)"/>
                            <ComboBoxItem Content="Quick destroy (ones)"/>
                            <ComboBoxItem Content="Secure destroy"/>
                        </ComboBox>
                        <TextBlock HorizontalAlignment="Left" Margin="0,245,0,0" Text="Destroy method" VerticalAlignment="Top" FontSize="16" Foreground="#FF011F5B"/>
                        <TextBlock HorizontalAlignment="Left" Margin="0,70,0,0" Text="Drive letter" VerticalAlignment="Top" FontSize="16" Foreground="#FF011F5B"/>
                        <TextBlock HorizontalAlignment="Left" Text="Repetitions of operation" VerticalAlignment="Top" FontSize="16" Margin="0,210,0,0" Foreground="#FF011F5B"/>
                        <TextBox x:Name="disk_repete_tb" Margin="198,210,12,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" MaxLength="2" TextAlignment="Center" FontSize="14" BorderBrush="Maroon"/>
                        <Button x:Name="destroy_button" Content="Begin" Margin="100,0,100,15" VerticalAlignment="Bottom" Height="65" FontSize="36" Background="Maroon" Click="DestroyDisk_Click" Foreground="White" BorderBrush="#FF5E47C7"/>
                        <Image x:Name="drive_icon" HorizontalAlignment="Left" Height="64" Margin="14,100,0,0" VerticalAlignment="Top" Width="64" Source="Images/Appearance/warning-grey.png"/>
                        <TextBlock x:Name="drive_name" HorizontalAlignment="Left" Margin="90,100,0,0" TextTrimming="CharacterEllipsis" Text="-" VerticalAlignment="Top" FontSize="14"/>
                        <TextBlock x:Name="drive_format" HorizontalAlignment="Left" Margin="90,122,0,0" TextTrimming="CharacterEllipsis" Text="-" VerticalAlignment="Top" FontSize="14"/>
                        <TextBlock x:Name="drive_free_size" HorizontalAlignment="Left" Margin="90,145,0,0" TextTrimming="CharacterEllipsis" Text="-" VerticalAlignment="Top" FontSize="14"/>
                        <Rectangle x:Name="total_size_rec" Fill="#FFF4F4F5" Height="18" Margin="10,175,10,0" Stroke="Maroon" VerticalAlignment="Top"/>
                        <Rectangle x:Name="avalible_size_rec" Fill="RoyalBlue" Height="16" Margin="11,176,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="0"/>
                        <CheckBox x:Name="disk_delete_files" Content="Delete files after destroy." HorizontalAlignment="Left" Margin="0,280,0,0" VerticalAlignment="Top" FontSize="14" Foreground="Maroon" BorderBrush="Maroon" IsChecked="True"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,32,0,0" VerticalAlignment="Top" Width="131"/>
    </Grid>
</Window>
