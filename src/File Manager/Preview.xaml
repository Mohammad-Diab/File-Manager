                        <TextBlock TextWrapping="NoWrap" Text="36-  The Quick brown fox jumps over the lazy dog. 0123456789   فلج الثغور إذا ابتسمن ضواحكا   هيف الخصور نواعم الأبدان" Foreground="White" FontSize="36"/>
                        <TextBlock TextWrapping="NoWrap" Text="48-  The Quick brown fox jumps over the lazy dog. 0123456789   فلج الثغور إذا ابتسمن ضواحكا   هيف الخصور نواعم الأبدان" Foreground="White" FontSize="48"/>
                        <TextBlock TextWrapping="NoWrap" Text="60-  The Quick brown fox jumps over the lazy dog. 0123456789   فلج الثغور إذا ابتسمن ضواحكا   هيف الخصور نواعم الأبدان" Foreground="White" FontSize="60"/>
                        <TextBlock TextWrapping="NoWrap" Text="72-  The Quick brown fox jumps over the lazy dog. 0123456789   فلج الثغور إذا ابتسمن ضواحكا   هيف الخصور نواعم الأبدان" Foreground="White" FontSize="72"/>
                    </ListBox>
                </Grid>
            </Grid>
            <Grid Margin="800,44,0,0" HorizontalAlignment="Left" Width="800">
