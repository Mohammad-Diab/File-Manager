<Window x:Class="File_Manager.AboutTool"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:File_Manager"
        mc:Ignorable="d"
        Title="About Tool" Height="450" Width="350" FontSize="14" ResizeMode="NoResize" MinWidth="350" MinHeight="450">
    <Grid>
        <TextBlock x:Name="tool_title" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="About tool" VerticalAlignment="Top" Foreground="Gray" FontSize="28"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,47,0,38">
            <Grid>
                <ItemsControl Margin="20,156,10,0" VerticalAlignment="Top" ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Top">
                                <Image HorizontalAlignment="Left" Height="24" Source="{Binding Path=TypeImage}" VerticalAlignment="Top" Width="24" Margin="5,5,0,0"/>
                                <TextBlock HorizontalAlignment="Left" Margin="{Binding Path=TypeMargin}" Text="{Binding Path=TypeText}" VerticalAlignment="Top" FontSize="16"/>
                                <TextBlock HorizontalAlignment="Left" Margin="10,34,0,0" TextWrapping="Wrap" Text="{Binding Path=FeatureInfo}" VerticalAlignment="Top" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Image x:Name="tool_image" HorizontalAlignment="Left" Height="72" Margin="20,36,0,0" VerticalAlignment="Top" Width="72"/>
                <TextBlock x:Name="tool_name" HorizontalAlignment="Left" Margin="100,36,0,0" TextWrapping="Wrap" Text="Name" VerticalAlignment="Top"/>
                <TextBlock x:Name="tool_vertion" HorizontalAlignment="Left" Margin="100,60,0,0" TextWrapping="Wrap" Text="Version" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="20,10,0,0" TextWrapping="Wrap" Text="General" VerticalAlignment="Top" FontSize="16" Foreground="CadetBlue"/>
                <TextBlock HorizontalAlignment="Left" Margin="20,130,0,0" TextWrapping="Wrap" Text="What's new" VerticalAlignment="Top" FontSize="16" Foreground="CadetBlue"/>
                <TextBlock x:Name="tool_date" HorizontalAlignment="Left" Margin="100,84,0,0" TextWrapping="Wrap" Text="Date" VerticalAlignment="Top"/>
            </Grid>
        </ScrollViewer>
        <Button x:Name="button" Content="OK" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Click="button_Click" Foreground="Gray" BorderBrush="Gray"/>
        <TextBlock Text="mohammad.diab93@outlook.com " Margin="10,0,0,10" VerticalAlignment="Bottom" FontSize="14" FontFamily="Segoe Print" Foreground="Gray" TextAlignment="Center" HorizontalAlignment="Left"/>
    </Grid>
</Window>
