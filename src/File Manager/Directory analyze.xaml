<Window x:Class="File_Manager.Directory_analyze"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:File_Manager"
        mc:Ignorable="d"
        Title="Directory_analyze" Height="400" Width="600" Loaded="Window_Loaded">

    <Grid Margin="0,0,0,0" HorizontalAlignment="Left" Width="595">
        <Grid x:Name="mother" Margin="-600,0,0,0">
            <Grid HorizontalAlignment="Left" Width="595" >
                <Grid x:Name="wd_welcome_grid" Visibility="Visible">
                    <TextBlock HorizontalAlignment="Left" Margin="10,44,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14" Foreground="#FF003397"><Run Text="This tool help you to determinate the deferent in files between tow directories."/><LineBreak/><Run Text="Just select your directories then click Next."/></TextBlock>
                    <TextBlock Margin="10,200,10,0" TextWrapping="Wrap" Text="To start click 'Next'" VerticalAlignment="Top" FontSize="14" TextAlignment="Center" Foreground="#FF003397"/>
                </Grid>
                <Button Content="Next" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}"/>
                <TextBlock x:Name="wd_welcome" HorizontalAlignment="Left" Margin="10,90,0,0" Text="Welcome" VerticalAlignment="Top" FontSize="140" Foreground="#FF87227E"/>
            </Grid>
            <Grid HorizontalAlignment="Left" Width="595" Margin="600,0,0,0">
                <ScrollViewer Margin="0,44,10,35" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14" Foreground="#FF003397" Grid.ColumnSpan="2"><Run Text="you should select tow deferent directories to analyze them."/><LineBreak/><Run Text="both directories should have common files."/></TextBlock>
                        <TextBlock Margin="10,42,10,0" TextWrapping="Wrap" Text="Select directories then click 'Next'" VerticalAlignment="Top" FontSize="14" TextAlignment="Center" Foreground="#FF003397" Grid.ColumnSpan="2"/>
                        <Grid x:Name="fd_grid" Margin="15,75,0,0" Background="#00000000" Drop="DirectoryGrid_Drop" AllowDrop="True">
                            <TextBox x:Name="fd_filepath" Margin="101,34,10,0" TextWrapping="Wrap" Text="-" VerticalAlignment="Top" FontSize="14" MaxHeight="96" BorderBrush="{x:Null}" TextChanged="FirstDirectoryPath_TextChanged"/>
                            <TextBlock x:Name="fd_filename" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" FontSize="16" Foreground="#FF003397" FontWeight="Bold" Margin="0,3,43,0"><Run Text="First "/><Run Text="directory"/></TextBlock>
                            <Image x:Name="fd_image" HorizontalAlignment="Left" Height="96" Margin="0,34,0,0" VerticalAlignment="Top" Width="96" Source="Images/Appearance/warning-grey.png"/>
                            <TextBlock x:Name="fd_type" Margin="10,135,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                            <TextBlock x:Name="fd_size" Margin="10,159,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                            <TextBlock x:Name="fd_date" HorizontalAlignment="Left" Margin="10,183,0,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top" Width="268"/>
                            <Button x:Name="fd_browse" ToolTip="Select first file" Content="B" Margin="0,0,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Height="28" Width="28" Background="{x:Null}" Click="Browser_Click"/>
                            <Rectangle HorizontalAlignment="Right" Margin="0,0,-2,10" Width="3">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="White" Offset="1"/>
                                        <GradientStop Color="#FFBCEDFF"/>
                                        <GradientStop Color="#FFCDF1FF" Offset="0.643"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <Grid x:Name="sd_grid" Margin="5,75,10,0" Background="#00000000" Drop="DirectoryGrid_Drop" AllowDrop="True" Grid.Column="1">
                            <TextBox x:Name="sd_filepath" Margin="111,34,10,0" TextWrapping="Wrap" Text="-" VerticalAlignment="Top" FontSize="14" MaxHeight="96" BorderBrush="{x:Null}" TextChanged="SecondDirectoryPath_TextChanged"/>
                            <TextBlock x:Name="sd_filename" TextTrimming="CharacterEllipsis" Text="Second directory" VerticalAlignment="Top" FontSize="16" Foreground="#FF003397" FontWeight="Bold" Margin="10,3,43,0"/>
                            <Image x:Name="sd_image" HorizontalAlignment="Left" Height="96" Margin="10,34,0,0" VerticalAlignment="Top" Width="96" Source="Images/Appearance/warning-grey.png"/>
                            <TextBlock x:Name="sd_type" Margin="20,135,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                            <TextBlock x:Name="sd_size" Margin="20,159,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                            <TextBlock x:Name="sd_date" Margin="20,183,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                            <Button ToolTip="Select first file" Content="B" Margin="0,0,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Height="28" Width="28" Background="{x:Null}" Click="Browser_Click"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
                <TextBlock HorizontalAlignment="Left" Margin="10,0,0,5" TextWrapping="Wrap" Text="You can drug and drop directories or paths." VerticalAlignment="Bottom" TextDecorations="Underline"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Choose directories" VerticalAlignment="Top" FontSize="22" Foreground="#FF87227E"/>
                <Button x:Name="begin_analyze_button" Content="Begin analyze" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="100" Background="{x:Null}"/>
            </Grid>
            <Grid HorizontalAlignment="Left" Width="595" Margin="1200,0,0,0">
                <TextBlock HorizontalAlignment="Left" Margin="10,44,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14" Foreground="#FF003397" Text="Now we are analyze selected directories please be impatient."/>
                <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Analyzing" VerticalAlignment="Top" FontSize="22" Foreground="#FF87227E"/>
                <TextBlock Margin="10,231,10,0" TextWrapping="Wrap" Text="Please wait..." VerticalAlignment="Top" FontSize="14" TextAlignment="Center" Foreground="#FF003397"/>
                <TextBlock Margin="30,132,30,0" TextWrapping="Wrap" Text="Task" VerticalAlignment="Top" FontSize="36" TextAlignment="Center" Foreground="#FF003397"/>
                <ProgressBar Height="29" Margin="10,197,10,0" VerticalAlignment="Top"/>
                <Button x:Name="button" Content="Cancel" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}"/>
            </Grid>
            <Grid HorizontalAlignment="Left" Width="595" Margin="1800,0,0,0">
                <TextBlock HorizontalAlignment="Left" Margin="10,44,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14" Foreground="#FF003397" Text="What do you want to do?"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Result" VerticalAlignment="Top" FontSize="22" Foreground="#FF87227E"/>
                <Button Content="close" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}"/>
                <Button Content="Start again" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
