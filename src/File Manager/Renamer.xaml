<Window x:Class="File_Manager.Renamer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renamer" Height="450" Width="475" Icon="Images/Appearance/renamer-icon.png">
    <TabControl Margin="0,0,0,0" Background="White">
        <TabItem Header="Extension changer">
            <TabItem.Background>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                    <GradientStop Color="SkyBlue" Offset="0"/>
                    <GradientStop Color="#FF83D2FF" Offset="1"/>
                </LinearGradientBrush>
            </TabItem.Background>
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#FFC3E3FD" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <ListView x:Name="FilesList" Margin="10,42,10,79" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBlock Margin="28,2,0,0" Text="{Binding Path=FullPath}" HorizontalAlignment="Left" FontSize="14"/>
                                <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBox x:Name="extension" Height="23" Margin="10,0,150,32" TextWrapping="Wrap" VerticalAlignment="Bottom" TextChanged="Extension_TextChanged" FontSize="16" Background="#BFFFFFFF"/>
                <TextBlock FontSize="14" HorizontalAlignment="Left" Margin="10,0,0,55" Text="Type new extension here (without any dots):" VerticalAlignment="Bottom" Foreground="Blue" TextTrimming="CharacterEllipsis"/>
                <Grid Margin="10,5" x:Name="rename_control">
                    <CheckBox x:Name="remove_extension" Content="Remove old extension" HorizontalAlignment="Left" Margin="0,0,0,5" VerticalAlignment="Bottom" FontSize="14" Foreground="Red" BorderBrush="Green" IsChecked="True"/>
                    <Button ToolTip="Add files" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Add folder (add all files in it)" Margin="37,0,0,0" VerticalAlignment="Top" Click="AddFolder_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Clear list" Margin="0,0,37,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Setting" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Remove selected files" Margin="0,0,74,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button VerticalAlignment="Bottom" Click="Rename_Click" Height="32" Background="RoyalBlue" Foreground="White" HorizontalAlignment="Right" Width="109">
                        <Button.Content>
                            <Grid Width="105" Height="28">
                                <TextBlock Text="Rename" Foreground="WhiteSmoke" Margin="35,5,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Image Source="Images/Appearance/rename.png" Width="28" Stretch="Fill" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <TextBlock HorizontalAlignment="Right" x:Name="items_count" Margin="0,0,10,55" TextWrapping="Wrap" VerticalAlignment="Bottom" FontSize="14">
                        <TextBlock.Foreground>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFF6800" Offset="0"/>
                                <GradientStop Color="Red" Offset="1"/>
                            </RadialGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Suggest best possible extension" BorderBrush="#FFACACAC">
            <TabItem.Background>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                    <GradientStop Color="#FF83C370" Offset="0"/>
                    <GradientStop Color="#FFD7F0CF" Offset="0.997"/>
                </LinearGradientBrush>
            </TabItem.Background>
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#FFB4E69D" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <TextBlock HorizontalAlignment="Right" Margin="0,0,12,42" TextWrapping="Wrap" VerticalAlignment="Bottom" FontSize="14">
                    <TextBlock.Foreground>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFF6800" Offset="0"/>
                            <GradientStop Color="Red" Offset="1"/>
                        </RadialGradientBrush>
                    </TextBlock.Foreground><Run x:Name="items_count2"/><Run Text=" "/><Run x:Name="items_done"/><Run x:Name="items_and"/><Run x:Name="items_failed"/></TextBlock>
                <ProgressBar x:Name="rename2_progressbar" Visibility="Hidden" HorizontalAlignment="Right" Height="19" Margin="0,0,10,42" VerticalAlignment="Bottom" Width="239" Maximum="1050"/>
                <Grid x:Name="rename2_control" Margin="10,5">
                    <Button ToolTip="Add files" Margin="0" VerticalAlignment="Top" Click="AddFile2_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Add folder (add all files in it)" Margin="37,0,0,0" VerticalAlignment="Top" Click="AddFolder2_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Clear list" Margin="0,0,37,0" VerticalAlignment="Top" Click="ClearList2_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Setting" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Remove selected files" Margin="0,0,74,0" VerticalAlignment="Top" Click="RemoveSelected2_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button VerticalAlignment="Bottom" Click="Rename2_Click" Height="32" Background="ForestGreen" Foreground="White" HorizontalAlignment="Right" Width="109">
                        <Grid Width="105" Height="28">
                            <TextBlock Text="Rename" Foreground="WhiteSmoke" Margin="35,5,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Image Source="Images/Appearance/rename.png" Width="28" Stretch="Fill" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                    </Button>
                    <Button Margin="0,0,0,30" Content="Suggest file extension" VerticalAlignment="Bottom" Click="Suggest_Click" Height="28" Foreground="#FF535353" HorizontalAlignment="Left" Width="157">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#7F1A661A" Offset="0"/>
                                <GradientStop Color="#66FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <CheckBox x:Name="remove_extension2" Content="Remove old extension" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="14" Foreground="Red" BorderBrush="Green" IsChecked="True" Margin="0,0,0,5"/>
                </Grid>
                <ListView x:Name="FilesList2" Margin="10,42,10,66" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="300" Header="File Path">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <TextBlock Margin="28,2,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left" FontSize="14"/>
                                            <Image Margin="0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Extension" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding PossibleExt}" SelectedIndex="{Binding SelectedExt}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>
    </TabControl>
</Window>