<Window x:Class="File_Manager.File_Operation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Operation" Width="500" ResizeMode="NoResize" SizeToContent="Height" WindowStartupLocation="CenterScreen" ScrollViewer.CanContentScroll="True">
    <Grid Margin="0,0,0,0">
        <StackPanel CanVerticallyScroll="True">
            <Grid Height="52" VerticalAlignment="Top">
                <ProgressBar Margin="10,25,0,0" HorizontalAlignment="Left" Width="400" Height="20" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,5,0,0" TextWrapping="Wrap" Text="Copying..." VerticalAlignment="Top"/>
                <Button Content="◼" HorizontalAlignment="Right" Margin="0,25,10,0" Width="20" Height="20" VerticalAlignment="Top"/>
                <Button Content="▶" HorizontalAlignment="Right" Margin="0,25,34,0" Width="20" Height="20" VerticalAlignment="Top"/>
            </Grid>
            <Rectangle Height="2" VerticalAlignment="Top" StrokeThickness="0" Margin="0,0,0,0">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF00A2FF" Offset="0"/>
                        <GradientStop Color="Lime" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </StackPanel>
    </Grid>
</Window>
