<Window x:Class="File_Manager.Folder_Picker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Picker" Height="350" Width="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded_1" Icon="Images/Appearance/empty.png">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
            <GradientStop Color="Snow" Offset="0.609"/>
            <GradientStop Color="#FFCDEAFB" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="257*"/>
            <RowDefinition Height="64*"/>
        </Grid.RowDefinitions>
        <TreeView x:Name="FolderExplorer" Margin="10,10,10,0" Background="{x:Null}" ItemsSource="{Binding}" SelectedItemChanged="FolderExplorer_SelectedItemChanged" TreeViewItem.Expanded="Add_Folders">
            <TreeView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Margin="25,0,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left"/>
                        <Image Margin="0" Source="{Binding Path=Image}" Height="16" Width="16" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    </Grid>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,9,10,7" Width="75" IsCancel="True" Visibility="Collapsed" Click="Cancel_Click" Background="{x:Null}" Grid.Row="1"/>
        <Button x:Name="OK" Content="OK" HorizontalAlignment="Right" Margin="0,28,10,0" Width="75" Click="OK_Click" Background="{x:Null}" Height="26" VerticalAlignment="Top" Grid.Row="1"/>
        <Button HorizontalAlignment="Left" Margin="10,28,0,0" Click="CreateDirectory_Click" Width="110" Background="{x:Null}" Height="26" VerticalAlignment="Top" Grid.Row="1" >
            <Button.Content>
                <Grid Width="106">
                    <TextBlock Margin="28,2,0,2" Text="New directory"/>
                    <Image Source="Images/Appearance/new-folder.png" HorizontalAlignment="Left" Width="22" Margin="2,0,0,0"/>
                </Grid>
            </Button.Content>
        </Button>
        <TextBox x:Name="path" Margin="10,5,10,0" VerticalAlignment="Top" Grid.Row="1" Background="#3FFFFFFF"/>
    </Grid>
</Window>
