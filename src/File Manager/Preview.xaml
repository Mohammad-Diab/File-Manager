                </Grid>
                <CheckBox x:Name="system" Content="System" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF404040" FontSize="16" Margin="430,203,0,0" Checked="AnyAttributes_Checked"/>
                <TextBlock Foreground="LightSkyBlue" FontSize="14" TextWrapping="Wrap" Margin="0,228,20,0" HorizontalAlignment="Right" Width="320" Height="56" VerticalAlignment="Top"><Run Foreground="#FF0B6AA4" Text="The file is part of the operating system or is used exclusively by the operating system."/><LineBreak/><Run Foreground="#FF0B6AA4"/><Run Foreground="#FFFF2700" Text="&#x9;   &quot;Caution: use with attention!&quot;."/></TextBlock>
                <Rectangle Margin="0,196,10,0" Height="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="360">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                    <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="White" Offset="1"/>
                            <GradientStop Color="#FFEC9B4A"/>
                            <GradientStop Color="#FFEEA963" Offset="0.329"/>
                            <GradientStop Color="#FFF2C190" Offset="0.478"/>
                            <GradientStop Color="#FFF6D6B6" Offset="0.751"/>
                            <GradientStop Color="#FFF9E7D5" Offset="0.912"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Margin="0,289,10,0" Height="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="360">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                    <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="White" Offset="1"/>
                            <GradientStop Color="#FFEC9B4A"/>
                            <GradientStop Color="#FFEEA963" Offset="0.329"/>
                            <GradientStop Color="#FFF2C190" Offset="0.478"/>
                            <GradientStop Color="#FFF6D6B6" Offset="0.751"/>
                            <GradientStop Color="#FFF9E7D5" Offset="0.912"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <CheckBox x:Name="not_content_indexed" Content="Not Content Indexed" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF404040" FontSize="16" Margin="430,296,0,0" Checked="AnyAttributes_Checked"/>
                <TextBlock Text="The file will not be indexed by the operating system's content indexing service." Foreground="#FF0D6DA8" FontSize="14" TextWrapping="Wrap"  Margin="0,321,20,0" HorizontalAlignment="Right" Width="320" Height="38" VerticalAlignment="Top"/>
                <Rectangle x:Name="Rectangle1_Copy2" Margin="399,41,0,20" HorizontalAlignment="Left" Width="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                    <RotateTransform CenterY="0.5" CenterX="0.5"/>
