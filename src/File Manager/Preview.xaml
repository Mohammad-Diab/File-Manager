                                    <RotateTransform Angle="-85.03" CenterY="0.5" CenterX="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="SkyBlue" Offset="0"/>
