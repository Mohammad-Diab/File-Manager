<Window x:Class="File_Manager.Renamer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Super Extension Changer" Height="550" Width="640" MinWidth="460" MinHeight="380" Icon="Images/Appearance/renamer-icon.png" Closing="Window_Closing" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Geometry x:Key="undo_glyph">M7.5,3 L2.5,7.5 L7.5,12 L7.5,9 L11,9 C14,9 16,11 16,13.5 C16,15 15.3,16.2 14.3,17 C17,16.3 18.5,14.2 18.5,11.8 C18.5,8.5 15.6,6 12,6 L7.5,6 Z</Geometry>
    </Window.Resources>
    <Grid>
        <Grid x:Name="main_grid">
            <StackPanel x:Name="tab_panal" Height="36" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
                <Label x:Name="label1" Content="EXT. CHANGER" FontSize="18" Background="White" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
                <Label x:Name="label2" Content="SUGGEST EXT." FontSize="18" Foreground="White" Background="Black" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
            </StackPanel>

            <Grid x:Name="mother" Margin="0,0,0,0">
                <Grid HorizontalAlignment="Left" Width="635" Margin="0,40,0,0">
                    <ListView x:Name="renamer_list" Margin="10,42,15,80" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}" AllowDrop="True" Drop="FilesList_Drop" SelectionChanged="List_SelectionChanged" KeyUp="List_KeyUp">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="330" Header="File">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="{Binding Path=FullPath}">
                                                <TextBlock Margin="28,2,0,0" Text="{Binding Path=FullPath}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="230" Header="New name">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=NewName}" Foreground="{Binding Path=NewNameColor}" ToolTip="{Binding Path=NewName}" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBox x:Name="extension" Height="23" Margin="10,0,150,30" TextWrapping="NoWrap" VerticalAlignment="Bottom" TextChanged="Extension_TextChanged" FontSize="16" Background="#BFFFFFFF" MaxLines="1" MaxLength="30"/>
                    <TextBlock x:Name="extension_label" FontSize="14" HorizontalAlignment="Left" Margin="10,0,0,55" Text="Type new extension here (without any dots):" VerticalAlignment="Bottom" Foreground="Blue" TextTrimming="CharacterEllipsis"/>
                    <CheckBox x:Name="remove_extension" Content="Remove old extension" ToolTip="Ticked: 'photo.png' becomes 'photo.jpg'. Not ticked: the new extension is added, 'photo.png' becomes 'photo.png.jpg'." HorizontalAlignment="Left" Margin="10,0,0,5" VerticalAlignment="Bottom" FontSize="14" Foreground="Blue" BorderBrush="Blue" IsChecked="True" Checked="RemoveExtension_Changed" Unchecked="RemoveExtension_Changed"/>
                    <Button ToolTip="Add files" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}" Margin="10,5,0,0">
                        <Button.Content>
                            <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Add folder (add all files in it)" Margin="47,5,0,0" VerticalAlignment="Top" Click="AddFolder_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button x:Name="undo_button" Tag="Undo last rename: give the files of the last rename their old names back" ToolTip="Undo last rename" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="0,5,126,0" VerticalAlignment="Top" Click="Undo_Click" HorizontalAlignment="Right" Background="{x:Null}" Width="36" Height="36">
                        <Path Data="{StaticResource undo_glyph}" Fill="#FF2F5597" Stretch="Uniform" Width="22" Height="22"/>
                    </Button>
                    <Button x:Name="clear_button" Tag="Clear list" ToolTip="Clear list" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="0,5,52,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button x:Name="setting_button" ToolTip="Settings" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Margin="0,5,15,0" Click="Setting_Click">
                        <Button.Content>
                            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button x:Name="remove_button" Tag="Remove selected files from the list" ToolTip="Remove selected files from the list" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="0,5,89,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="rename_button" Tag="Rename the files in the list" ToolTip="Rename the files in the list" IsEnabled="False" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Bottom" Click="Rename_Click" Height="32" Background="RoyalBlue" Foreground="White" HorizontalAlignment="Right" Width="109" Margin="0,0,15,10">
                        <Button.Content>
                            <Grid Width="105" Height="28">
                                <TextBlock Text="Rename" Foreground="WhiteSmoke" Margin="35,5,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Image Source="Images/Appearance/rename.png" Width="28" Stretch="Fill" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <TextBlock HorizontalAlignment="Right" x:Name="items_count" Margin="0,0,10,55" TextWrapping="Wrap" VerticalAlignment="Bottom" FontSize="14">
                        <TextBlock.Foreground>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFF6800" Offset="0"/>
                                <GradientStop Color="Red" Offset="1"/>
                            </RadialGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>

                <Grid HorizontalAlignment="Left" Margin="640,40,0,0" Width="635">
                    <TextBlock HorizontalAlignment="Right" Margin="0,0,12,42" TextWrapping="Wrap" VerticalAlignment="Bottom" FontSize="14">
                        <TextBlock.Foreground>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFF6800" Offset="0"/>
                                <GradientStop Color="Red" Offset="1"/>
                            </RadialGradientBrush>
                        </TextBlock.Foreground><Run x:Name="items_count2"/><Run Text=" "/><Run x:Name="items_done"/><Run x:Name="items_and"/><Run x:Name="items_failed"/></TextBlock>
                    <Button ToolTip="Add files" Margin="10,5,0,0" VerticalAlignment="Top" Click="SuggesterAddFile_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button ToolTip="Add folder (add all files in it)" Margin="47,5,0,0" VerticalAlignment="Top" Click="SuggesterAddFolder_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button x:Name="undo_button2" Tag="Undo last rename: give the files of the last rename their old names back" ToolTip="Undo last rename" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="0,5,126,0" VerticalAlignment="Top" Click="Undo_Click" HorizontalAlignment="Right" Background="{x:Null}" Width="36" Height="36">
                        <Path Data="{StaticResource undo_glyph}" Fill="#FF2F5597" Stretch="Uniform" Width="22" Height="22"/>
                    </Button>
                    <Button x:Name="clear_button2" Tag="Clear list" ToolTip="Clear list" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="0,5,52,0" VerticalAlignment="Top" Click="SuggesterClearList_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Button.Content>
                            <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button x:Name="setting_button2" ToolTip="Settings" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Margin="0,5,15,0" Click="Setting_Click">
                        <Button.Content>
                            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button.Content>
                    </Button>
                    <Button x:Name="remove_button2" Tag="Remove selected files from the list" ToolTip="Remove selected files from the list" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="0,5,89,0" VerticalAlignment="Top" Click="SuggesterRemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="rename_button2" Tag="Rename the files to the chosen extensions" ToolTip="Rename the files to the chosen extensions" IsEnabled="False" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Bottom" Click="SuggesterRename_Click" Height="32" Background="ForestGreen" Foreground="White" HorizontalAlignment="Right" Width="109" Margin="0,0,15,10">
                        <Grid Width="105" Height="28">
                            <TextBlock Text="Rename" Foreground="WhiteSmoke" Margin="35,5,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Image Source="Images/Appearance/rename.png" Width="28" Stretch="Fill" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                    </Button>
                    <Button x:Name="suggest_button" Tag="Read every file and suggest its real extension" ToolTip="Read every file and suggest its real extension" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="10,0,0,28" Content="Suggest file extension" VerticalAlignment="Bottom" Click="Suggest_Click" Height="28" Foreground="Green" HorizontalAlignment="Left" Width="157" BorderBrush="Green">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#7F1A661A" Offset="0"/>
                                <GradientStop Color="#66FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <CheckBox x:Name="remove_extension2" Content="Remove old extension" ToolTip="Ticked: the wrong extension is replaced. Not ticked: the suggested extension is added after the old one." HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="14" Foreground="Green" BorderBrush="Green" IsChecked="True" Margin="10,0,0,5"/>
                    <ListView x:Name="sugester_list" Margin="10,42,15,66" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}" AllowDrop="True" Drop="FilesList_Drop" SelectionChanged="List_SelectionChanged" KeyUp="List_KeyUp">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="250" Header="File Path">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="{Binding FullPath}">
                                                <TextBlock Margin="28,2,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <Image Margin="0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Detected type" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TypeName}" ToolTip="{Binding TypeName}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Sure?" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ConfidenceText}" Foreground="{Binding ConfidenceColor}" ToolTip="{Binding ConfidenceTip}" Margin="0,2,0,0"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Extension" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding PossibleExt}" SelectedIndex="{Binding SelectedExt}" MinWidth="80"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>
            <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,32,0,0" VerticalAlignment="Top" Width="129"/>
        </Grid>
        <Button ToolTip="About Super Extension Changer" HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" Background="{x:Null}" BorderBrush="{x:Null}" Click="AboutTool_Click">
            <Image Stretch="Fill" Source="Images/Menu/about-tool.png"/>
        </Button>
        <ProgressBar x:Name="rename2_progressbar" Visibility="Hidden" Height="20" Margin="260,7,50,0" Maximum="1050" VerticalAlignment="Top"/>
    </Grid>
</Window>