<Window x:Class="File_Manager.Files_Splitter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Files Splitter" Height="350" Width="550">
    <Grid>
        <Grid x:Name="mother" Margin="0,0,0,0">
            <Grid Width="545" HorizontalAlignment="Left">
                <ListBox Height="275" Margin="325,45,0,0" VerticalAlignment="Top"/>
            </Grid>
            <Grid Margin="550,0,0,0" Width="545" HorizontalAlignment="Left">
            </Grid>
            <Grid Margin="1100,0,0,0" Width="545" HorizontalAlignment="Left">
            </Grid>
        </Grid>
        <StackPanel Height="45" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="ADVANCE SPLITTER" FontSize="24" Background="White" MouseUp="Label1_MouseUp" Cursor="Hand"/>
            <Label x:Name="label2" Content="SPLITTER" FontSize="24" Foreground="White" Background="Black" MouseUp="label2_MouseUp" Cursor="Hand"/>
            <Label x:Name="label3" Content="MARGER" FontSize="24" Foreground="White" Background="Black" MouseUp="label3_MouseUp" Cursor="Hand"/>
        </StackPanel>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,41,0,0" VerticalAlignment="Top" Width="220"/>
    </Grid>
</Window>
