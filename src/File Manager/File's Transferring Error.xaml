<Window x:Class="File_Manager.File_s_Transferring_Error"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What do you want to do" Height="500" Width="525" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Icon="Images/Appearance/empty.png">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
            <GradientStop Color="LightPink" Offset="1"/>
            <GradientStop Color="White" Offset="0.9"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <ScrollViewer Margin="0,88,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="container"/>
        </ScrollViewer>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Margin="10,10,0,0" Foreground="DarkBlue" FontSize="22"><Run Text="What do you want to do?"/><LineBreak/><Run x:Name="sub_containt" Foreground="Black" FontSize="14" Text="Some files have not transferred successfully."/></TextBlock>
        <RadioButton x:Name="retry_radiobutton" Content="Retry all" HorizontalAlignment="Right" Margin="0,65,115,0" VerticalAlignment="Top" FontSize="15" Checked="RetryAll_Checked" Unchecked="RetryAll_Unchecked"/>
        <RadioButton x:Name="skip_radiobutton" Content="Skip all" HorizontalAlignment="Right" Margin="0,65,20,0" VerticalAlignment="Top" FontSize="15" Checked="SkipAll_Checked" Unchecked="SkipAll_Unchecked"/>
        <Rectangle Height="1" Margin="0,85,0,0" Stroke="Chocolate" VerticalAlignment="Top"/>
        <Button Content="Skip All" HorizontalAlignment="Left" Margin="10,0,0,9" Width="75" Click="Cancel_Click" Grid.Row="1" Height="22" VerticalAlignment="Bottom" Background="{x:Null}"/>
        <Button Content="Done" HorizontalAlignment="Right" Margin="0,0,10,9" VerticalAlignment="Bottom" Width="75" Height="22" Click="OK_Click" Grid.Row="1" Background="{x:Null}"/>
        <TextBlock x:Name="source_checkbox_Copy" Text="Items" HorizontalAlignment="Left" Margin="10,65,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Button Content="Retry All" HorizontalAlignment="Left" Margin="90,0,0,9" VerticalAlignment="Bottom" Width="75" Height="22" Click="Retry_Click" Grid.Row="1" Background="{x:Null}"/>
    </Grid>
</Window>
