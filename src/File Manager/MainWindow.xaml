<Window x:Class="File_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Files Manager (APPS PREVIEW)" Width="800" Height="525" WindowStartupLocation="Manual" Loaded="Main_Window_Loaded" Icon="App Icon.ico" PreviewKeyUp="Explorer_KeyUP">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo/>
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid Margin="0,51,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid x:Name="Properties" HorizontalAlignment="Right" Width="220" Visibility="Visible" Grid.RowSpan="1" Background="#FFE7E5E4">
                <Image x:Name="img" Height="200" Margin="10,20,10,0" VerticalAlignment="Top" Stretch="UniformToFill" Source="Images\Icons\256\computer.png"/>
                <StackPanel Margin="10,240,10,10">
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14">
                        <Run x:Name="name_title" Text="Name: " Foreground="RoyalBlue"/>
                        <Run x:Name="name" Text=""/>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14">
                        <Run x:Name="type_title" Text="Type: " Foreground="Tomato"/>
                        <Run x:Name="type" Text=""/>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14">
                        <Run x:Name="size_title" Text="Size: " Foreground="Tomato"/>
                        <Run x:Name="size" Text=""/>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14">
                        <Run x:Name="data_Modified_title" Text="Data Modified: " Foreground="Tomato"/>
                        <Run x:Name="data_Modified" Text=""/>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <ListView x:Name="Explorer" TextBlock.TextAlignment="Right" Margin="0,0,220,19" ItemsSource="{Binding}" PreviewKeyUp="Explorer_PreviewKeyUp" Foreground="#FF41403B" SelectionChanged="Explorer_SelectionChanged" Background="White" ContextMenuOpening="Explorer_ContextMenuOpening">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Sort by">
                            <MenuItem Header="Name"/>
                            <MenuItem Header="Size"/>
                            <MenuItem Header="Type"/>
                            <MenuItem Header="Date Modified"/>
                        </MenuItem>
                        <MenuItem Header="Refresh" Click="Explorer_KeyUP"/>
                        <Separator/>
                        <MenuItem x:Name="paste_context_menu" Header="Paste" IsEnabled="False" Click="Paste_Click"/>
                        <MenuItem Header="Past shortcut" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="New">
                            <MenuItem Header="Folder" Click="NewDirectory_Click"/>
                            <MenuItem Header="Shortcut"/>
                            <Separator/>
                            <MenuItem Header="Plain Text Document" Click="PlanText_Click"/>
                            <MenuItem Header="HTML File" Click="HTML_Click"/>
                            <MenuItem Header="Bitmap Image" Click="Bitmap_Click"/>
                            <MenuItem Header="Microsoft Word Document" Click="DOCX_Click"/>
                            <MenuItem Header="Open Document Text" Click="ODT_Click"/>
                            <MenuItem Header="Microsoft PowerPoint Presentation" Click="PPTX_Click"/>
                            <MenuItem Header="Open Document Presentation" Click="ODP_Click"/>
                            <MenuItem Header="Microsoft Excel Worksheet" Click="XLSX_Click"/>
                            <MenuItem Header="Open Document Spreadsheet" Click="ODS_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Properties"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.Resources>
                    <Style TargetType="{x:Type ListViewItem}">
                        <EventSetter Event='MouseDoubleClick' Handler='Item_DoubleClick'/>
                        <EventSetter Event='ContextMenuOpening'  Handler='Item_ContextMenuOpening'/>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                <GridView>
                        <GridViewColumn Header="Name" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ContextMenu="{Binding Path=Menu}">
                                        <TextBlock Margin="28,4,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left"/>
                                        <Image Margin="0" Source="{Binding Path=Icon}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        <!--<TextBlock Margin="25,0,0,0" Text="{Binding Path=FileExt}" HorizontalAlignment="Left" FontSize="8"/>-->
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Path=FileSize}"/>
                        <GridViewColumn Header="Type" Width="85" DisplayMemberBinding="{Binding Path=FileType}"/>
                        <GridViewColumn Header="Data Modified" Width="100" DisplayMemberBinding="{Binding Path=DateModified}"/>
                </GridView>
                </ListView.View>
            </ListView>
            <Grid VerticalAlignment="Bottom" Margin="0,0,220,0">
                <TextBlock x:Name="statebar" TextWrapping="Wrap" FontSize="14"><Run Text=" "/><Run x:Name="count"/><Run Text=" "/><Run x:Name="selected" Foreground="DodgerBlue"/><Run Text=" "/><Run x:Name="total_files_size" Foreground="Brown"/></TextBlock>
            </Grid>
        </Grid>
        <Grid Height="30" Margin="0,21,0,0" VerticalAlignment="Top" Background="#FFF2F1F0">
            <Button x:Name="Back" Click="GoBack_Click" Margin="3,3,0,3" VerticalAlignment="Stretch" Background="{x:Null}" HorizontalAlignment="Left" IsEnabled="False" Width="24" BorderBrush="{x:Null}">
                <Image Source="Images/Appearance/go-previous.png"/>
            </Button>
            <Button x:Name="Forword" Click="GoFront_Click" Margin="26,3,0,3" VerticalAlignment="Stretch" Background="{x:Null}" HorizontalAlignment="Left" IsEnabled="False" Width="24" BorderBrush="{x:Null}">
                <Image Source="Images/Appearance/go-next.png"/>
            </Button>
            <ComboBox x:Name="backMenu" HorizontalAlignment="Left" Margin="84,3,0,3" Width="20" SelectionChanged="Surfing_Back"/>
            <Button x:Name="Up" Click="GoUP_Click" Margin="55,3,0,3" VerticalAlignment="Stretch" Background="{x:Null}" HorizontalAlignment="Left" IsEnabled="False" Width="24" BorderBrush="{x:Null}">
                <Image Source="Images/Appearance/go-up.png"/>
            </Button>
            <ComboBox x:Name="AddressHelper" Text="" Margin="109,4,234,4" HorizontalAlignment="Stretch" FontSize="13" IsEditable="True" SelectionChanged="Address_SelectionChanged">
                <ComboBox.Background>
                    <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                        <GradientStop Color="#FFF0F0F0" Offset="0"/>
                        <GradientStop Color="#7FE5E5E5" Offset="1"/>
                    </LinearGradientBrush>
                </ComboBox.Background>
            </ComboBox>
            <ProgressBar x:Name="progressbar" Height="22" Margin="109,4,234,0" VerticalAlignment="Top" Background="{x:Null}" Opacity="0.75"/>
            <TextBox x:Name="Address" Margin="109,4,234,0" KeyUp="Address_KeyUp" HorizontalAlignment="Stretch" FontSize="13" VerticalAlignment="Top" Height="22" Background="{x:Null}"/>
            <Button x:Name="View_Refresh" Click="Explorer_KeyUP" Margin="0,3,209,3" VerticalAlignment="Stretch" Background="{x:Null}" HorizontalAlignment="Right" Width="24" BorderBrush="{x:Null}">
                <Image Source="Images/Appearance/view-refresh.png"/>
            </Button>
            <TextBox x:Name="Search" Margin="0,4,5,4" Background="{x:Null}" HorizontalAlignment="Right" Width="199" ToolTip="GGGGG" Tag="FFFFFFFFFFF" FontSize="14"/>
        </Grid>
        <Menu VerticalAlignment="Top">
            <MenuItem Header="FILE MANAGER" FontSize="14">
                <MenuItem Header="New Window" Foreground="#FF41403B" Click="New_Window"/>
                <MenuItem Header="New Window (Admin Propriety)" Foreground="#FF41403B" Click="NewWindowAdmin_Click"/>
                <Separator Foreground="#FF41403B"/>
                <MenuItem Header="BookMarks" Foreground="#FF41403B"/>
                <Separator Foreground="#FF41403B"/>
                <MenuItem Header="Preferences" Foreground="#FF41403B"/>
                <MenuItem Header="about File Manager" Foreground="#FF41403B" Click="MenuItem_Click"/>
                <MenuItem Header="Help" Foreground="#FF41403B"/>
                <Separator Foreground="#FF41403B"/>
                <MenuItem Header="Quit" Foreground="#FF41403B" Click="Quit"/>
            </MenuItem>
            <MenuItem Header="VIEW" FontSize="14">
                <MenuItem Header="Show Image" Foreground="#FF41403B" Click="ShowImage_Click" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Zoom In" Foreground="#FF41403B"/>
                <MenuItem Header="Zoom Out" Foreground="#FF41403B"/>
                <MenuItem Header="Normal Size" Foreground="#FF41403B"/>
                <Separator/>
                <MenuItem Header="Refresh" Foreground="#FF41403B" Click="Explorer_KeyUP"/>
                <Separator/>
                <MenuItem Header="Show Details Pane" Foreground="#FF41403B" IsCheckable="True"/>
                <MenuItem Header="Show Hidden Files" Foreground="#FF41403B" Click="ShowHiddenFiles_Click" IsCheckable="True"/>
            </MenuItem>
            <MenuItem Header="TOOLS" FontSize="14">
                <MenuItem Header="Compressed files manager" Foreground="#FF41403B" Click="FileCompresser_Click"/>
                <MenuItem Header="System monitor" Foreground="#FF41403B" Click="SystemMonitor_Click"/>
                <MenuItem Header="Super extension changer" Foreground="#FF41403B" Click="SuperFilesRenamer_Click"/>
                <MenuItem Header="Dublicate files remover" Foreground="#FF41403B" Click="DublicateFileRemover_Click"/>
                <MenuItem Header="Disk explorer" Foreground="#FF41403B" Click="BigFileFinder_Click"/>
                <MenuItem Header="Empty directories remover" Foreground="#FF41403B" Click="EmptyDirectoriesRemover_Click"/>
                <MenuItem Header="Files destoyer" Foreground="#FF41403B"/>
                <MenuItem Header="Files encreptor" Foreground="#FF41403B"/>
            </MenuItem>
            <MenuItem x:Name="options" Header="OPTIONS" FontSize="14">
                <MenuItem Header="New Tab" Foreground="#FF41403B"/>
                <MenuItem Header="New Directory" Foreground="#FF41403B" Click="NewDirectory_Click"/>
                <MenuItem Header="New Document" Foreground="#FF41403B">
                    <MenuItem Header="Shortcut" Foreground="#FF41403B"/>
                    <Separator/>
                    <MenuItem Header="Plain Text Document" Foreground="#FF41403B" Click="PlanText_Click"/>
                    <MenuItem Header="HTML File" Foreground="#FF41403B" Click="HTML_Click"/>
                    <MenuItem Header="Bitmap Image" Foreground="#FF41403B" Click="Bitmap_Click"/>
                    <MenuItem Header="Microsoft Word Document" Foreground="#FF41403B" Click="DOCX_Click"/>
                    <MenuItem Header="Open Document Text" Foreground="#FF41403B" Click="ODT_Click"/>
                    <MenuItem Header="Microsoft PowerPoint Presentation" Foreground="#FF41403B" Click="PPTX_Click"/>
                    <MenuItem Header="Open Document Presentation" Foreground="#FF41403B" Click="ODP_Click"/>
                    <MenuItem Header="Microsoft Excel Worksheet" Foreground="#FF41403B" Click="XLSX_Click"/>
                    <MenuItem Header="Open Document Spreadsheet" Foreground="#FF41403B" Click="ODS_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Cut" Foreground="#FF41403B" Click="Cut_Click"/>
                <MenuItem Header="Copy" Foreground="#FF41403B" Click="Copy_Click"/>
                <MenuItem Header="Paste" Foreground="#FF41403B" Click="Paste_Click"/>
                <Separator/>
                <MenuItem Header="Undo" Foreground="#FF41403B"/>
                <MenuItem Header="Redo" Foreground="#FF41403B"/>
                <Separator/>
                <MenuItem Header="Select All" Foreground="#FF41403B" Click="SelectAll_Click"/>
                <MenuItem Header="Inverse Selection" Foreground="#FF41403B" Click="InverseSelection_Click"/>
                <Separator/>
                <MenuItem Header="BookMark This Location" Foreground="#FF41403B"/>
                <MenuItem Header="Properties" Foreground="#FF41403B"/>
                <Separator/>
                <MenuItem Header="Close" Foreground="#FF41403B" Click="Close"/>
            </MenuItem>
        </Menu>
    </Grid>
</Window>
