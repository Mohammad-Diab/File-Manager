<Window x:Class="File_Manager.ModrenMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:File_Manager"
        mc:Ignorable="d"
        Title="FILE MANAGER" FontSize="14" Topmost="True" MinWidth="350" MinHeight="125" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Height="210" Width="500" Loaded="Window_Loaded">
    <Grid>
        <Rectangle Height="33" Stroke="Black" Visibility="Collapsed" StrokeThickness="0" VerticalAlignment="Bottom" Opacity="0.5">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFCCE7F1" Offset="0"/>
                    <GradientStop Color="AliceBlue" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="Background" Fill="RoyalBlue" Height="5" Stroke="Black" StrokeThickness="0" VerticalAlignment="Top"/>
        <Image x:Name="image" HorizontalAlignment="Left" Height="48" Margin="10,10,0,0" VerticalAlignment="Top" Width="48" Source="Images/Appearance/dialog-information.png"/>
        <StackPanel x:Name="stack_panal" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <TextBlock x:Name="title" TextWrapping="Wrap" Margin="63,10,0,0" VerticalAlignment="Top" Foreground="RoyalBlue" FontSize="18" Text="Main Message" HorizontalAlignment="Left"/>
            <Rectangle x:Name="rectangle" Height="2" Stroke="Black" StrokeThickness="0" Margin="63,5,50,0">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="SkyBlue" Offset="0"/>
                        <GradientStop Color="AliceBlue" Offset="0.714"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock x:Name="addition_info" HorizontalAlignment="Left" Margin="70,5,0,0" TextWrapping="Wrap" Text="Addition info:" VerticalAlignment="Top" FontSize="12"/>
            <TextBlock x:Name="extra_info" Margin="75,5,0,0" TextWrapping="Wrap" Text="Extra Info" VerticalAlignment="Top" FontSize="14" HorizontalAlignment="Left"/>
            <Grid x:Name="password_grid" Margin="75,2,10,0">
                <TextBlock Margin="0,1,0,0" Text="Password:" VerticalAlignment="Top" FontSize="14" HorizontalAlignment="Left"/>
                <PasswordBox x:Name="password_pw" Height="20" Margin="100,0,19,0" MinWidth="200"/>
                <TextBox x:Name="password_view" Visibility="Collapsed" Height="20" Margin="100,0,19,0" MinWidth="200"/>
                <ToggleButton x:Name="show_password_bt" HorizontalAlignment="Right" ToolTip="Show password" Height="20" Width="20" Background="{x:Null}" BorderBrush="#FFABADB3" Checked="ShowPassword_Checked" Unchecked="show_password_bt_Unchecked">
                    <ToggleButton.Content>
                        <Image Stretch="Fill" Source="Images/Appearance/show-passwoed.png"/>
                    </ToggleButton.Content>
                </ToggleButton>
            </Grid>
            <Grid x:Name="Caution_grid" Margin="75,3,10,0">
                <Image Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" Source="Images/Appearance/warning.png"/>
                <TextBlock x:Name="caution_text" Margin="22,0,0,0" Text="Caution Text" Foreground="#FFD44930" VerticalAlignment="Top" FontSize="14" HorizontalAlignment="Left" TextDecorations="Underline"/>
            </Grid>
            <ItemsControl Visibility="Visible" Margin="75,5,40,5" x:Name="buttons_panal" ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Button_Click" HorizontalContentAlignment="Left" ToolTip="{Binding Path=Text}" Background="{x:Null}" BorderBrush="{x:Null}" Tag="{Binding Path=ID}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="32">
                                    <Image Margin="2,0,0,0" Width="32" Stretch="Fill" Source="{Binding Path=Image}"/>
                                    <TextBlock Margin="4,6,0,4" VerticalAlignment="Top" FontSize="14" Foreground="#FF233591" Text="{Binding Path=Text}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!--iRoyalBlue   ×Tomato  !nearYellow ?Green-->
        </StackPanel>

        <Button Click="Button_Click" Height="48" Visibility="Collapsed" x:Name="button_template" Background="{x:Null}" BorderBrush="{x:Null}">
            <Button.Content>
                <Grid>
                    <Image Margin="2,0,0,0" Width="48" Stretch="Fill"/>
                    <TextBlock Margin="55,2,0,2" VerticalAlignment="Top" FontSize="14" Foreground="#FF233591"/>
                </Grid>
            </Button.Content>
        </Button>

        <Button x:Name="ok" Content="OK" HorizontalAlignment="Right" Margin="0,0,10,3" VerticalAlignment="Bottom" Width="85" Background="{x:Null}" Click="Ok_Click" BorderThickness="2,1" BorderBrush="Black" FontSize="14.667"/>
        <Button x:Name="cancel" Content="Cancel" HorizontalAlignment="Right" Margin="0,0,100,3" VerticalAlignment="Bottom" Width="85" Background="{x:Null}" BorderThickness="2,1" BorderBrush="Black" FontSize="14.667"/>
        <CheckBox x:Name="show_again" Content="Don't show this message again." HorizontalAlignment="Left" Margin="25,0,0,7" VerticalAlignment="Bottom"/>
        <MediaElement x:Name="sound_player" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Visibility="Collapsed" Width="0"/>
    </Grid>
</Window>
