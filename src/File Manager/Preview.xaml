<Window x:Class="File_Manager.Preview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Height="553" Width="806" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Icon="Images/Menu/file-preview.png" FontSize="14" Closing="Window_Closing">
    <Window.Resources>
        <ControlTemplate x:Key="roundButtonTemplate" TargetType="{x:Type Button}">
            <Grid MouseEnter="RoundButton_MouseOver" MouseLeave="RoundButton_MouseLeave" MouseLeftButtonDown="RoundButton_MouseDown" MouseLeftButtonUp="RoundButton_MouseUp">
                <Ellipse Width="60" Height="60" Fill="{x:Null}" Stroke="#FFE6E6E6" StrokeThickness="5"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14"/>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="bigRoundButtonTemplate" TargetType="{x:Type Button}">
            <Grid MouseEnter="RoundButton_MouseOver" MouseLeave="RoundButton_MouseLeave" MouseLeftButtonDown="RoundButton_MouseDown" MouseLeftButtonUp="RoundButton_MouseUp">
                <Ellipse Width="120" Height="120" Fill="{x:Null}" Stroke="#FFE6E6E6" StrokeThickness="5"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14"/>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="mediumRoundButtonTemplate" TargetType="{x:Type Button}">
            <Grid MouseEnter="RoundButton_MouseOver" MouseLeave="RoundButton_MouseLeave" MouseLeftButtonDown="RoundButton_MouseDown" MouseLeftButtonUp="RoundButton_MouseUp">
                <Ellipse Width="75" Height="75" Fill="{x:Null}" Stroke="#FFE6E6E6" StrokeThickness="4"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14"/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <Grid x:Name="mother_of_all_grid" Margin="0,0,0,0" HorizontalAlignment="Left" Width="4800">
            <Grid x:Name="preview_grid" HorizontalAlignment="Left" Width="800" Margin="0,44,0,0">
