                            <GradientStop Color="White" Offset="0.781"/>
                            <GradientStop Color="#FFC8C8C8" Offset="0.801"/>
                            <GradientStop Color="White" Offset="0.821"/>
                            <GradientStop Color="White" Offset="0.852"/>
                            <GradientStop Color="#FFC8C8C8" Offset="0.872"/>
                            <GradientStop Color="White" Offset="0.892"/>
                            <GradientStop Color="White" Offset="0.922"/>
