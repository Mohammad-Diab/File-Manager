<Window x:Class="File_Manager.Empty_Folder_Remover"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empty Folders Remover" Height="420" Width="400" Icon="Images/Tools Icon/Window/EmptyFolderRemover.ico" Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid>
        <ListView x:Name="items_list" Margin="5,47,5,5" ItemsSource="{Binding}" SelectionMode="Extended" SelectionChanged="ItemsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="{Binding Path=Tip}">
                        <TextBlock Margin="28,2,0,0" Text="{Binding Path=FullPath}" HorizontalAlignment="Left" FontSize="14"/>
                        <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Resources>
                <Style TargetType="{x:Type ListViewItem}">
                    <EventSetter Event='Control.MouseDoubleClick' Handler='Item_MouseDoubleClick'/>
                    <EventSetter Event='UIElement.PreviewKeyUp'  Handler='Item_PreviewKeyUp'/>
                </Style>
           </ListView.Resources>
        </ListView>
        <Button x:Name="find_button" Tag="Search for empty folders in one or more folders" ToolTipService.ShowOnDisabled="True" Margin="5,10,0,0" VerticalAlignment="Top" Click="FindEmptey_Click" HorizontalAlignment="Left" Background="{x:Null}" Padding="2">
            <Button.Content>
                <Image Source="Images/Appearance/folder-search.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button x:Name="stop_button" ToolTip="Stop the search" Margin="42,10,0,0" VerticalAlignment="Top" Click="StopSearch_Click" HorizontalAlignment="Left" Background="{x:Null}" Padding="2" Visibility="Collapsed">
            <Button.Content>
                <Image Source="Images/Appearance/button-cancel.png" Width="28" Height="28" Stretch="Uniform"/>
            </Button.Content>
        </Button>
        <Button x:Name="delete_items" Tag="Delete selected items (to the Recycle Bin, hold Shift to delete permanently)" ToolTipService.ShowOnDisabled="True" Margin="0,10,116,0" VerticalAlignment="Top" Click="DeleteItems_Click" IsEnabled="False" Background="{x:Null}" HorizontalAlignment="Right" Padding="2">
            <Button.Content>
                <Image Source="Images/Appearance/delete.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button x:Name="select_none" Tag="Select none" ToolTipService.ShowOnDisabled="True" Margin="0,10,190,0" VerticalAlignment="Top" Click="SelectNone_Click" Background="{x:Null}" HorizontalAlignment="Right" IsEnabled="False" Padding="2">
            <Button.Content>
                <Image Source="Images/Appearance/select-none.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button x:Name="select_all" Tag="Select all empty folders (empty files are not selected)" ToolTipService.ShowOnDisabled="True" Margin="0,10,153,0" VerticalAlignment="Top" Click="SelectAll_Click" Background="{x:Null}" HorizontalAlignment="Right" IsEnabled="False" Padding="2">
            <Button.Content>
                <Image Source="Images/Appearance/select-all.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button x:Name="clear_list" Tag="Clear list" ToolTipService.ShowOnDisabled="True" Margin="0,10,79,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" IsEnabled="False" Padding="2">
            <Button.Content>
                <Image Source="Images/Appearance/list-clear.png" Width="28" Height="28" Stretch="UniformToFill"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Setting" Margin="0,10,42,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Visibility="Collapsed">
            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="About Empty Folders Remover" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="{x:Null}" Click="AboutTool_Click" Margin="0,10,5,0">
            <Button.Content>
                <Image Stretch="Fill" Source="Images/Menu/about-tool-blue.png"/>
            </Button.Content>
        </Button>
        <ProgressBar x:Name="progressbar" Height="21" Margin="79,15,227,0" VerticalAlignment="Top" Maximum="5100" Visibility="Collapsed"/>
        <Grid x:Name="info_bar" Height="26" Margin="5,0,5,4" VerticalAlignment="Bottom" Background="#FFE8F1FB" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="Images/Appearance/dialog-information.png" Width="18" Height="18" Margin="4,0"/>
            <TextBlock x:Name="info_text" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#FF011F5B" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Button x:Name="show_skipped" Grid.Column="2" Content="Show skipped" ToolTip="List the folders that were skipped" Margin="4,2,0,2" Padding="6,0" Background="{x:Null}" BorderBrush="RoyalBlue" Click="ShowSkipped_Click"/>
            <Button x:Name="restart_admin" Grid.Column="3" Content="Restart as administrator" ToolTip="Open this tool as administrator with the same folders (Windows asks for permission)" Margin="4,2,2,2" Padding="6,0" Background="{x:Null}" BorderBrush="RoyalBlue" Click="RestartAdmin_Click"/>
        </Grid>
        <Rectangle Height="5" Stroke="Black" VerticalAlignment="Top" Fill="Black" StrokeThickness="0"/>
    </Grid>
</Window>
