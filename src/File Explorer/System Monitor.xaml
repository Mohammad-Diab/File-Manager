<Window x:Class="File_Explorer.System_Monitor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System_Monitor" Height="325" Width="500" Loaded="Window_Loaded_1">
    <Grid x:Name="GridContainer">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Properties" Visibility="Visible" Grid.RowSpan="1" Background="#FFE7E5E4" Grid.Column="1" Margin="0,0,0,21">
            <StackPanel Margin="13,10,10,10">
                <TextBlock TextWrapping="Wrap"><Run Foreground="Blue" Text="ID: "/><Run x:Name="id" Foreground="Black"/></TextBlock>
                <Separator/>
                <TextBlock TextWrapping="Wrap" FontSize="14"><Run Foreground="Red" Text="Name: "/><Run x:Name="name"/></TextBlock>
                <Separator/>
                <TextBlock TextWrapping="Wrap"><Run Foreground="Blue" Text="Type: "/><Run x:Name="type" Foreground="Black"/></TextBlock>
                <Separator/>
                <TextBlock TextWrapping="Wrap"><Run Foreground="Blue" Text="Size: "/><Run x:Name="size" Foreground="Black"/></TextBlock>
                <Separator/>
                <TextBlock TextWrapping="Wrap"><Run Foreground="Blue" Text="Data Modified: "/><Run x:Name="data_Modified" Foreground="Black"/></TextBlock>
                <Separator/>
                <Button x:Name="EndProcess" IsEnabled="False" Content="Ask to close" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75"/>
                <Button x:Name="EndProcess_Copy" IsEnabled="False" Content="Kill" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75"/>
                <Button x:Name="Refresh" Content="Refresh" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>
        <!--<ListBox x:Name="ListProcess" Margin="0,0,0,20" SelectionChanged="ListProcess_SelectionChanged"/>-->
        <StatusBar Height="20" VerticalAlignment="Bottom" Grid.ColumnSpan="2" Background="#FFE7E5E4">
            <TextBlock x:Name="proccess_number" TextWrapping="Wrap" Text=""/>
        </StatusBar>
        <ListView x:Name="ListProcess" Margin="0,0,0,20" SelectionChanged="ListProcess_SelectionChanged" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="Auto" DisplayMemberBinding="{Binding Path=name}"/>
                    <GridViewColumn Header="ID" Width="Auto" DisplayMemberBinding="{Binding Path=id}"/>
                    <GridViewColumn Header="CPU" Width="Auto" DisplayMemberBinding="{Binding Path=cpu}"/>
                    <GridViewColumn Header="Memory" Width="Auto" DisplayMemberBinding="{Binding Path=memory}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
