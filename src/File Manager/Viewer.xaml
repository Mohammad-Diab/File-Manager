<Window x:Class="File_Manager.Viewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viewer" Height="480" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="14" AllowsTransparency="False" WindowStyle="None" Loaded="Window_Loaded" KeyUp="Window_KeyUp_1" Icon="Images/Menu/file-preview.png">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo/>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <ControlTemplate x:Key="roundButtonTemplate" TargetType="{x:Type Button}">
            <Grid MouseEnter="Grid_MouseOver" MouseLeave="Grid_MouseLeave" MouseLeftButtonDown="Grid_MouseDown" MouseLeftButtonUp="Grid_MouseUp" Background="#FF111111">
                <Ellipse Width="60" Height="60" Fill="{x:Null}" Stroke="Snow" StrokeThickness="5"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14"/>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="emptybutton" TargetType="{x:Type Button}">
            <Grid>
                <ContentPresenter/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <Grid Background="#FF41403B">
        <TabControl x:Name="Container" HorizontalAlignment="Left" Height="480" VerticalAlignment="Top" Width="800" Foreground="{x:Null}" BorderBrush="Black" Background="{x:Null}">
            <TabItem Header="Viewer" Foreground="#FF41403B" Margin="0,0,0,0">
                <Grid x:Name="viewer" MouseMove="viewer_MouseMove">
                    <Grid x:Name="Controls" Visibility="Collapsed" Margin="160,0" Height="80" VerticalAlignment="Bottom">
                        <Button x:Name ="stop" Visibility="Visible" Foreground ="White" FontSize ="28" FontWeight ="Bold" Margin="85,10,0,10" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalAlignment="Left" Width="60" Template="{StaticResource emptybutton}" MouseEnter="Grid1_MouseOver" MouseLeave="Grid1_MouseLeave">
                            <Button.Content>
                                <Grid>
                                    <Ellipse Width="56" Height="56" Fill="{x:Null}" Stroke="Snow" StrokeThickness="5"/>
                                    <Image x:Name="stop_content" Source="Images/Menu/copy-stop.png" Height="32" Width="32"/>
                                </Grid>
                            </Button.Content>
                        </Button>
                        <Button x:Name ="play" Foreground ="White" FontSize ="28" FontWeight ="Bold" Margin="10,10,0,10" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalAlignment="Left" Width="60" Visibility="Visible" Template="{StaticResource emptybutton}" MouseEnter="Grid1_MouseOver" MouseLeave="Grid1_MouseLeave">
                            <Button.Content>
                                <Grid>
                                    <Ellipse Width="56" Height="56" Fill="{x:Null}" Stroke="Snow" StrokeThickness="5"/>
                                    <Image x:Name="play_content" Source="Images/Menu/copy-pause.png" Height="32" Width="32"/>
                                </Grid>
                            </Button.Content>
                        </Button>
                        <Button x:Name ="pause" Foreground ="White" FontSize ="28" FontWeight ="Bold" Margin="10,10,0,10" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalAlignment="Left" Width="60" Visibility="Hidden" Template="{StaticResource emptybutton}" MouseEnter="Grid1_MouseOver" MouseLeave="Grid1_MouseLeave">
                            <Button.Content>
                                <Grid>
                                    <Ellipse Width="56" Height="56" Fill="{x:Null}" Stroke="Snow" StrokeThickness="5"/>
                                    <Image x:Name="pause_content" Source="Images/Menu/copy-pause.png" Height="32" Width="32"/>
                                </Grid>
                            </Button.Content>
                        </Button>
                        <Slider x:Name="volume" HorizontalAlignment="Right" Margin="0,5,10,5" Width="20" Orientation="Vertical" Maximum="100" LargeChange="10" SmallChange="5" AutoToolTipPlacement="TopLeft"/>
                        <Slider x:Name="Slider1" Visibility="Visible" Height="20" Margin="160,0,40,40" VerticalAlignment="Bottom" PreviewMouseUp="Slider1_PreviewMouseUp" ValueChanged="Slider1_ValueChanged"/>
                        <TextBlock x:Name="Timer1" Visibility="Visible" Margin="160,0,40,10" TextWrapping="Wrap" Foreground="RoyalBlue" VerticalAlignment="Bottom" FontSize="20" TextAlignment="Center">
                            <Run x:Name="day" Text="00"/>
                           <Run Text=":"/>
                           <Run x:Name="hour" Text="00"/>
                            <Run Text=":"/>
                           <Run x:Name="minute" Text="00"/>
                           <Run Text=":"/>
                           <Run x:Name="second" Text="00"/>
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Information" Foreground="#FF41403B" Margin="0,0,0,0">
                <Grid x:Name="information">
                    <Image x:Name="ItemImage" Margin="40,86,0,0" HorizontalAlignment="Left" Width="256" Height="256" VerticalAlignment="Top"/>
                    <StackPanel x:Name="FileInfo" Margin="0,77,40,0" HorizontalAlignment="Right" Width="400" CanVerticallyScroll="True" ScrollViewer.CanContentScroll="True" VerticalAlignment="Top" MaxHeight="320">
                        <TextBlock Margin="10" TextWrapping="Wrap" Foreground="White" FontSize="16"><Run x:Name="name_title" Text="Name: " Foreground="YellowGreen"/></TextBlock>
                        <TextBlock x:Name="error" Foreground="Tomato" Visibility="Collapsed" TextAlignment="Center"><Run Text="File name can't contain any of these characters:"/><LineBreak/><Run Text="'\' , '/' , ':' , '*' , '?' , '&quot;' , '&lt;' , '&gt;' , '|'"/></TextBlock>
                        <TextBlock Margin="10" TextWrapping="Wrap" Foreground="White" FontSize="14"><Run x:Name="type_title" Text="Type: " Foreground="Beige"/><Run Text=" "/><Run x:Name="type" Foreground="Snow"/></TextBlock>
                        <TextBlock Margin="10" TextWrapping="Wrap" Foreground="White" FontSize="14"><Run x:Name="size_title" Text="Size: " Foreground="Beige"/><Run x:Name="size" Foreground="Snow"/><Run x:Name="dirs_count"/><Run x:Name="and"/><Run x:Name="files_count"/></TextBlock>
                        <TextBlock x:Name="created_all" Margin="10"  TextWrapping="Wrap" Foreground="White" FontSize="14"><Run x:Name="created_title" Text="Created Time: " Foreground="Beige"/><Run x:Name="created" Foreground="Snow"/></TextBlock>
                        <TextBlock x:Name="modified_all" Margin="10"  TextWrapping="Wrap" Foreground="White" FontSize="14"><Run x:Name="modified_title" Text="Modified Time: " Foreground="Beige"/><Run x:Name="modified" Foreground="Snow"/></TextBlock>
                        <TextBlock x:Name="accessed_all" Margin="10"  TextWrapping="Wrap" Foreground="White" FontSize="14"><Run x:Name="accessed_title" Text="Last Accessed Time: " Foreground="Beige"/><Run x:Name="accessed" Foreground="Snow"/></TextBlock>
                        <Grid>
                            <Rectangle Margin="10,10,0,10" x:Name="drive_usage" Height="20" Visibility="Visible" Fill="#FFC8C8C8" HorizontalAlignment="Left" Width="380" Stroke="White"/>
                            <Rectangle Margin="11,11,0,11" x:Name="drive_usage_act" Visibility="Visible" Fill="#FF26A0DA" HorizontalAlignment="Left" Width="4"/>
                        </Grid>
                    </StackPanel>
                    <TextBox x:Name="name" Text="" Foreground="Snow" Background="{x:Null}" TextChanged="name_TextChanged" Margin="420,85,135,0" Height="23" VerticalAlignment="Top"/>
                    <Button x:Name="Change_Name" Content="Change Name" FontSize="12" Margin="0,85,40,0" Visibility="Hidden" Background="{x:Null}" BorderBrush="Linen" Foreground="Snow" HorizontalAlignment="Right" VerticalAlignment="Top" Width="90" Height="24" Click="ChangeName_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Attributes" Foreground="#FF41403B" Margin="0,0,0,0">
                <Grid x:Name="attributes">
                    <Image x:Name="item_image" Margin="40,86,0,0" HorizontalAlignment="Left" Width="256" Height="256" VerticalAlignment="Top"/>
                    <StackPanel Margin="0,50,40,0" CanVerticallyScroll="True" HorizontalAlignment="Right" Width="400" VerticalAlignment="Top">
                        <RadioButton x:Name="normal" Content="Normal" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Snow" FontSize="16" Checked="normal_Checked"/>
                        <TextBlock x:Name="TextBlock1" Text="       The file is a standard file." Foreground="LightSkyBlue" FontSize="14"/>
                        <Rectangle x:Name="Rectangle1" Height="2" Fill="Linen"/>
                        <RadioButton x:Name="other" Content="Some thing other" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Snow" FontSize="16" Checked="other_Checked" Unchecked="other_Unchecked"/>
                        <CheckBox x:Name="read_only" Content="Read Only" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Snow" FontSize="16" Checked="Attributes_Checked" Unchecked="Attributes_Unchecked" Margin="30,0,0,0"/>
                        <CheckBox x:Name="hidden" Content="Hidden" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Snow" FontSize="16" Checked="Attributes_Checked" Unchecked="Attributes_Unchecked" Margin="30,0,0,0"/>
                        <CheckBox x:Name="archive" Content="Archive" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Snow" FontSize="16" Checked="Attributes_Checked" Unchecked="Attributes_Unchecked" Margin="30,0,0,0"/>
                        <CheckBox x:Name="compressed" Content="Compressed" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Snow" FontSize="16" Checked="Attributes_Checked" Unchecked="Attributes_Unchecked" Margin="30,0,0,0"/>
                        <CheckBox x:Name="encrypted" Content="Encrypted" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Snow" FontSize="16" Checked="Attributes_Checked" Unchecked="Attributes_Unchecked" Margin="30,0,0,0"/>
                        <Rectangle x:Name="Rectangle2" Height="2" Fill="Linen"  Margin="30,0,0,0"/>
                        <CheckBox x:Name="system" Content="System" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Snow" FontSize="16" Checked="Attributes_Checked" Unchecked="Attributes_Unchecked" Margin="30,0,0,0"/>
                        <TextBlock x:Name="TextBlock2" Foreground="LightSkyBlue" FontSize="14" TextWrapping="Wrap" Margin="60,0,0,0"><Run Text="The file is part of the operating system or is used exclusively by the operating system."/><LineBreak/><Run Foreground="Tomato" Text="&quot;Caution: use with attention!&quot;."/></TextBlock>
                        <Rectangle x:Name="Rectangle4" Height="2" Fill="Linen"  Margin="30,0,0,0"/>
                        <CheckBox x:Name="not_content_indexed" Content="Not Content Indexed" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Snow" FontSize="16" Checked="Attributes_Checked" Unchecked="Attributes_Unchecked"  Margin="30,0,0,0"/>
                        <TextBlock x:Name="TextBlock5"  Text="The file will not be indexed by the operating system's content indexing service." Foreground="LightSkyBlue" FontSize="14" TextWrapping="Wrap"  Margin="60,0,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Height="32" Margin="0,0,10,40" VerticalAlignment="Bottom" Width="276" Orientation="Horizontal" FlowDirection="RightToLeft">
                        <Button Content="Save" HorizontalAlignment="Right" Margin="2" Width="60" Background="{x:Null}" Foreground="Snow" BorderBrush="Linen" Visibility="Visible" Click="SaveAttributes_Click"/>
                        <Button x:Name="apply_to_all" Content="Apply to all containt" HorizontalAlignment="Right" Margin="2" Width="140" Background="{x:Null}" Foreground="Snow" BorderBrush="Linen" Visibility="Visible" Click="SaveToAllAttributes_Click"/>
                        <Button x:Name="reverse" Content="Reverse" HorizontalAlignment="Right" Margin="2" Width="60" Background="{x:Null}" Foreground="Snow" BorderBrush="Linen" Visibility="Collapsed" Click="Reverse_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid x:Name="caution" Height="30" VerticalAlignment="Bottom" Visibility="Collapsed">
            <Rectangle Fill="Black" Height="30" Stroke="Black" VerticalAlignment="Bottom" Opacity="0.5"/>
            <Rectangle Height="29" VerticalAlignment="Bottom" Opacity="0.9" RenderTransformOrigin="0.5,0.5">
                <Rectangle.Stroke>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFB40100" Offset="0"/>
                        <GradientStop Color="#FFDC02FF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Stroke>
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                        <GradientStop Color="#FFB40100" Offset="1"/>
                        <GradientStop Color="#FFDC0200"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock x:Name="failed" Text="Caution: This file type maybe contain a virus or damage your computer" Foreground="WhiteSmoke" FontSize="16" TextAlignment="Center" HorizontalAlignment="Left" Width="800" Height="24" VerticalAlignment="Top" Margin="0,3,0,0" FontWeight="SemiBold"/>
        </Grid>
        <Grid x:Name="main_menu" Width="64" HorizontalAlignment="Left" Background="#FF111111" Margin="-64,0,0,0" MouseLeave="HideMenu_MouseLeave">
            <StackPanel x:Name="main_menu_stack">
                <Button x:Name="open_button" Height="64" VerticalAlignment="Top" Margin="-64,15,64,0" Background="#FF333333" Template="{StaticResource roundButtonTemplate}" ToolTip="Open" Click="Open_Click">
                    <Button.Content>
                        <Image x:Name="open_button_image" Source="Images/Menu/open-file.png"/>
                    </Button.Content>
                </Button>
                <Button x:Name="open_with_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}" ToolTip="Open with" Click="OpenWith_Click">
                    <Button.Content>
                        <Image x:Name="open_with_button_image" Source="Images/Menu/open-with.png"/>
                    </Button.Content>
                </Button>
                <Button x:Name="explore_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}">
                    <Button.Content>
                        <Image x:Name="explore_button_image" Source="Images/Menu/copy-stop.png"/>
                    </Button.Content>
                </Button>
                <Button x:Name="extract_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}">
                    <Button.Content>
                        <Image x:Name="extract_button_image" Source="Images/Menu/copy-stop.png"/>
                    </Button.Content>
                </Button>
                <Button x:Name="move_to_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}" ToolTip="Move to" Click="MoveTo_Click">
                    <Button.Content>
                        <Image x:Name="move_to_button_image" Source="Images/Menu/file-move.png"/>
                    </Button.Content>
                </Button>
                <Button x:Name="copy_to_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}" ToolTip="Copy to" Click="CopyTo_Click">
                    <Button.Content>
                        <Image x:Name="copy_to_button_image" Source="Images/Menu/file-copy.png"/>
                    </Button.Content>
                </Button>
                <Button x:Name="delete_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}" ToolTip="Delete" Click="Delete_Click">
                    <Button.Content>
                        <Image x:Name="delete_button_image" Source="Images/Menu/file-delete.png"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
        <Grid HorizontalAlignment="Left" Width="5" MouseEnter="ShowMenu_MouseEnter" Background="#FF41403B" Margin="0,26,0,0" Opacity="0"/>
        <Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Width="50" Height="21" IsCancel="True" Background="#FFC75050" Foreground="Snow" Click="Close_Click" BorderBrush="#FFC75050" FontSize="12"/>
        <TextBlock x:Name="FileName" TextWrapping="NoWrap" Foreground="White" Visibility="Visible" TextAlignment="Center" FontSize="16" VerticalAlignment="Top"  Margin="215,0,55,0" TextTrimming="CharacterEllipsis"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="641,4,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
    </Grid>
</Window>
