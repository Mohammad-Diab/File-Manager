<Window x:Class="File_Manager.Files_Encrepter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encrypt files" Height="428" Width="702" Closing="Window_Closing" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid x:Name="main_grid">
            <StackPanel x:Name="tab_panal" Height="36" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
                <Label x:Name="label1" Content="ENCRYPT FILES" FontSize="18" Background="White" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
                <Label x:Name="label2" Content="DE-ENCRYPT FILES" FontSize="18" Foreground="White" Background="Black" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
                <Label x:Name="label3" Content="VIEW PACK CONTENT" FontSize="18" IsEnabled="False" Foreground="LightGray" Background="#FF2C2C2C" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
            </StackPanel>

            <Grid x:Name="mother" Margin="0,40,0,0">
                <Grid HorizontalAlignment="Left" Width="685" AllowDrop="True"  Drop="EncOutputText_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="encrypt_add_button" ToolTip="Add files" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}" Margin="10,5,0,0">
                        <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="encrypt_add_folder_button" ToolTip="Add folder (add all files in it)" Margin="47,5,0,0" VerticalAlignment="Top" Click="AddDirectory_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="encrypt_clear_button" ToolTip="Clear list" Margin="0,5,10,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="encrypt_remove_button" ToolTip="Remove selected files" Margin="0,5,47,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <ListView x:Name="encrypt_list" Margin="10,42,10,10" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}" AllowDrop="True" Drop="EncryptList_Drop">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ContextMenu="{Binding Menu}">
                                    <TextBlock Margin="28,4,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left"/>
                                    <Image Margin="0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Rectangle Fill="#FF9CC9F0" Width="2" Margin="0,30" HorizontalAlignment="Left" Grid.Column="1"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Encrypt options" VerticalAlignment="Top" Foreground="#FF003397" FontSize="20" Grid.Column="1"/>
                    <Button VerticalAlignment="Bottom" Content="Encrypt" Foreground="White" Click="Encrypt_Click" Height="32" Background="#FF40E2E2" FontSize="18" HorizontalAlignment="Right" Width="109" Margin="0,0,15,25" Grid.Column="1"/>
                    <Grid Margin="20,70,15,0" Grid.Column="1" Height="20" VerticalAlignment="Top">
                        <TextBox x:Name="enc_password_text" Height="18" Margin="0,1,27,1" Visibility="Collapsed"/>
                        <PasswordBox x:Name="enc_password" Height="18" MaxLength="128" Margin="0,1,27,0" VerticalAlignment="Top"/>
                        <ToggleButton x:Name="enc_show_password" HorizontalAlignment="Right" Width="20"  Background="{x:Null}" Click="ShowPassword_Click">
                            <Image Source="Images/Appearance/show-passwoed.png" Stretch="Fill"/>
                        </ToggleButton>
                    </Grid>
                    <TextBlock HorizontalAlignment="Left" Margin="10,45,0,0" TextWrapping="Wrap" Text="Password:" FontSize="14" VerticalAlignment="Top" Grid.Column="1"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,110,0,0" TextWrapping="Wrap" Text="Output files" VerticalAlignment="Top" FontSize="14" Grid.Column="1"/>
                    <CheckBox x:Name="enc_delete_files" Content="Secure delete files after encryption." HorizontalAlignment="Left" Margin="10,255,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Red" BorderBrush="Green" IsChecked="False" Grid.Column="1"/>
                    <TextBlock Margin="10,0,0,5" Text="All files in the list will be encrypt with same password." TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Foreground="Green" HorizontalAlignment="Left" Grid.Column="1"/>
                    <CheckBox x:Name="enc_file_name" Content="Encrypt files name and extension." HorizontalAlignment="Left" Margin="10,235,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="False" Grid.Column="1"/>
                    <CheckBox x:Name="enc_pack_files" Content="Put all files in one encrypted package." HorizontalAlignment="Left" Margin="10,215,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="False" Grid.Column="1"/>
                    <RadioButton x:Name="overwrite_file" Content="Overwrite original files." HorizontalAlignment="Left" Margin="20,135,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="False" Grid.Column="1" Checked="EncryptOverwriteFile_Checked"/>
                    <RadioButton Content="in specific location:" HorizontalAlignment="Left" Margin="20,155,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="True" Grid.Column="1" Checked="RadioButton_Checked"/>
                    <Grid x:Name="enc_output_grid" Grid.Column="1" Height="20" Margin="20,176,15,0" VerticalAlignment="Top">
                        <TextBox x:Name="enc_output" Margin="0,1,25,1" Text="D:\" MaxLines="1" MaxLength="248"/>
                        <Button x:Name="encrypt_browser_button" Content="Browse" HorizontalAlignment="Right" Width="20" Background="{x:Null}" Click="Browser_Click"/>
                    </Grid>
                </Grid>

                <Grid HorizontalAlignment="Left" Margin="700,0,0,0" Width="685" AllowDrop="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    <Button ToolTip="Add files" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}" Margin="10,5,0,0">
                        <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button ToolTip="Add folder (add all files in it)" Margin="47,5,0,0" VerticalAlignment="Top" Click="AddDirectory_Click" HorizontalAlignment="Left" Background="{x:Null}">
                        <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button ToolTip="Clear list" Margin="0,5,10,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button ToolTip="Remove selected files" Margin="0,5,47,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <ListView x:Name="decrypt_list" Margin="10,42,10,10" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}" AllowDrop="True" Drop="DecryptList_Drop">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ContextMenu="{Binding Menu}">
                                    <TextBlock Margin="28,4,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left"/>
                                    <Image Margin="0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Rectangle Fill="#FF9CC9F0" Margin="0,30,0,30" HorizontalAlignment="Left" Width="2" Grid.Column="1"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Decrypt options" VerticalAlignment="Top" Foreground="#FF003397" FontSize="20" Grid.Column="1"/>
                    <Button FontSize="18" VerticalAlignment="Bottom" Click="Decrypt_Click" Content="De-encrypt" Height="32" Background="#FF883CD4" Foreground="White" HorizontalAlignment="Right" Width="109" Margin="0,0,15,25" Grid.Column="1">
                        <!--<Grid Width="105" Height="28">
                            <TextBlock Text="De-encrypt" Foreground="White" Margin="35,5,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Image Source="Images/Appearance/rename.png" Width="28" Stretch="Fill" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>-->
                    </Button>
                    <TextBlock HorizontalAlignment="Left" Margin="10,45,0,0" TextWrapping="Wrap" Text="Password:" FontSize="14" VerticalAlignment="Top" Grid.Column="1"/>
                    <TextBox x:Name="dec_output" Margin="20,135,40,0" Text="D:\" VerticalAlignment="Top" MaxLines="1" MaxLength="248" AllowDrop="True" Drop="DecOutputText_Drop" Grid.Column="1"/>
                    <Button Content="Browse" HorizontalAlignment="Right" Margin="0,134,15,0" VerticalAlignment="Top" Width="20" Height="20" Background="{x:Null}" Click="Browser_Click" Grid.Column="1"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,110,0,0" TextWrapping="Wrap" Text="Save output files in" VerticalAlignment="Top" FontSize="14" Grid.Column="1"/>
                    <TextBlock Margin="10,0,15,5" TextTrimming="CharacterEllipsis" Text="Make sure that all files in list have the same password." VerticalAlignment="Bottom" Foreground="Red" MaxHeight="36" Grid.Column="1"/>
                    <Grid Margin="20,70,15,0" Grid.Column="1" Height="20" VerticalAlignment="Top">
                        <TextBox x:Name="dec_password_text" Height="18" Margin="0,1,27,1" Visibility="Collapsed"/>
                        <PasswordBox x:Name="dec_password" Height="18" MaxLength="128" Margin="0,1,27,0" VerticalAlignment="Top"/>
                        <ToggleButton x:Name="dec_show_password" HorizontalAlignment="Right" Width="20"  Background="{x:Null}" Click="ShowPassword_Click">
                            <Image Source="Images/Appearance/show-passwoed.png" Stretch="Fill"/>
                        </ToggleButton>
                    </Grid>
                    <CheckBox  Margin="10,176,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="False" Grid.Column="1" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Text="Files which encrypted in a package, save them in a separated directory."/>
                    </CheckBox>
                </Grid>
            </Grid>
            <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,32,0,0" VerticalAlignment="Top" Width="125"/>
        </Grid>
        <Button ToolTip="Setting" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" BorderBrush="{x:Null}" Width="36" Height="36" Margin="0,0,41,0">
            <Image Source="Images/Appearance/setting.png" Height="30" Width="30" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="About Files Destroy" HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" Background="{x:Null}" BorderBrush="{x:Null}" Click="AboutTool_Click">
            <Image Stretch="Fill" Source="Images/Menu/about-tool.png"/>
        </Button>
        <Button x:Name="button" Content="enc" HorizontalAlignment="Right" Height="46" Margin="-127,0,746,0" VerticalAlignment="Bottom" Width="75" Click="Test_Click"/>
    </Grid>
</Window>
