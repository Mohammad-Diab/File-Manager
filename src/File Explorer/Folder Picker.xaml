<Window x:Class="File_Manager.Folder_Picker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder_Picker" Height="350" Width="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded_1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="286*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <TreeView x:Name="FolderExplorer" Margin="0,0,0,33" Grid.RowSpan="2"/>
        <Button Content="OK" HorizontalAlignment="Right" Margin="0,4,95,3" Width="75" Grid.Row="1"/>
        <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,4,10,3" Width="75" Grid.Row="1"/>
    </Grid>
</Window>
