<Window x:Class="File_Explorer.Exists_Files_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What do you want to do" Height="500" Width="525" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Icon="Images/Appearance/empty.png">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
            <GradientStop Color="LightSkyBlue" Offset="1"/>
            <GradientStop Color="White" Offset="0.902"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <ScrollViewer Margin="0,88,0,37" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="container"/>
        </ScrollViewer>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Margin="10,10,0,0" Foreground="DarkBlue" FontSize="22"><Run Text="Which files do you want to Keep?"/><LineBreak/><Run Foreground="Black" FontSize="14" Text="if you choose both files the copy file will have a number added to its name."/></TextBlock>
        <CheckBox x:Name="source_checkbox" Content="File from source" HorizontalAlignment="Left" Margin="10,65,0,0" VerticalAlignment="Top" FontSize="14" Checked="CheckSource_Checked" Unchecked="CheckSource_Unloaded"/>
        <CheckBox x:Name="target_checkbox" Content="File already in target" HorizontalAlignment="Left" Margin="255,65,0,0" VerticalAlignment="Top" FontSize="14" Checked="CheckTarget_Checked" Unchecked="CheckTarget_Unloaded"/>
        <Rectangle Fill="YellowGreen" Height="1" Margin="0,85,0,0" Stroke="YellowGreen" VerticalAlignment="Top"/>
        <Button Content="Skip All" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Height="22" Background="White" Opacity="0.9" Click="Cancel_Click"/>
        <Button Content="Done" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Height="22" Background="White" Opacity="0.9" Click="OK_Click"/>
        <CheckBox x:Name="skip_same" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" FontSize="14" Checked="Same_Checked" Unchecked="Same_Unchecked">
            <CheckBox.Content>
                <TextBlock>
                    <TextBlock.ToolTip>
                        <TextBlock Text="Caution: It maybe take a lot of time if there is a huge files or lot of files" Foreground="Tomato" FontSize="14" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="SemiBold"/>
                    </TextBlock.ToolTip>
                    <Run Text="Skip"/>
                    <Run x:Name="same_containt" Text="????" Foreground="Green"/>
                    <Run Text="files with same containt."/>
                </TextBlock>
            </CheckBox.Content>
        </CheckBox>
    </Grid>
</Window>
