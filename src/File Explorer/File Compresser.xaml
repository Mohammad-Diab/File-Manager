<Window x:Class="File_Explorer.File_Compresser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Compresser" Height="350" Width="600">
    <Grid>
        <ListView x:Name="list" Margin="0,50,0,25" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Path=Name}"/>
                    <GridViewColumn Header="Size" Width="120" DisplayMemberBinding="{Binding Path=Size}"/>
                    <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding Path=Type}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="Add folder" HorizontalAlignment="Left" Margin="22,25,0,0" VerticalAlignment="Top" Width="75" Click="AddFolder_Click"/>
        <Button Content="Add Files" HorizontalAlignment="Left" Margin="102,25,0,0" VerticalAlignment="Top" Width="75" Click="AddFiles_Click"/>
        <Button Content="Clear list" HorizontalAlignment="Left" Margin="262,25,0,0" VerticalAlignment="Top" Width="75"/>
        <Button Content="delete items" HorizontalAlignment="Left" Margin="182,25,0,0" VerticalAlignment="Top" Width="75"/>
        <Button Content="Clear list" HorizontalAlignment="Left" Margin="262,25,0,0" VerticalAlignment="Top" Width="75"/>
        <Button Content="Save" HorizontalAlignment="Left" Margin="342,25,0,0" VerticalAlignment="Top" Width="75"/>
        <Button Content="Open" HorizontalAlignment="Left" Margin="422,25,0,0" VerticalAlignment="Top" Width="75" Click="AddFiles_Click"/>
        <Button Content="Compress" HorizontalAlignment="Left" Margin="502,25,0,0" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>
