                        <Image Source="Images/Menu/media-skip-forward.png" Height="48" Width="48" Stretch="Fill"/>
                    </Button>
                    <Button Template="{StaticResource mediumRoundButtonTemplate}" Margin="140,228,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="80" Height="80" Click="PreviousAudio_Click">
                        <Image Source="Images/Menu/media-skip-backward.png" Height="48" Width="48" Stretch="Fill" RenderTransformOrigin="0.5,0.5"/>
                    </Button>
                    <TextBlock x:Name="audio_total_time" HorizontalAlignment="Left" Margin="10,0,0,10" TextWrapping="Wrap" Text="--:--" VerticalAlignment="Bottom" Foreground="White"/>
                    <TextBlock x:Name="audio_current_position_time" Margin="10,358,245,0" TextWrapping="Wrap" Text="00:00" VerticalAlignment="Top" Foreground="White" TextAlignment="Center" FontSize="36"/>
                    <TextBlock HorizontalAlignment="Left" Margin="560,118,0,0" TextWrapping="Wrap" Text="Play list" VerticalAlignment="Top" Foreground="White" FontSize="16"/>
