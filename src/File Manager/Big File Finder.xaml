<Window x:Class="File_Manager.Big_File_Finder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Directory Analyzer" Height="450" Width="650" MinWidth="400" Icon="Images/Appearance/analyzer.png" Closing="Window_Closing">
    <Grid>
        <Grid x:Name="mother" Margin="-650,0,0,0">
            <Grid Margin="0,0,0,0" Width="600" HorizontalAlignment="Left">
                <ListView x:Name="item_list" Margin="0,68,10,10" ItemsSource="{Binding}" PreviewKeyUp="ItemsList_PreviewKeyUp">
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event='MouseDoubleClick' Handler='BigFileFinder_MouseDoubleClick'/>
                            <EventSetter Event='PreviewKeyUp'  Handler='BigFileFinder_PreviewKeyUp'/>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="125">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <!--Background="{Binding Path=Background}"-->
                                            <TextBlock Margin="28,0,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Path=FileType}"/>
                            <GridViewColumn Header="Size" Width="60" DisplayMemberBinding="{Binding Path=FileSize}"/>
                            <GridViewColumn Header="Percent" Width="60" DisplayMemberBinding="{Binding Path=Percent}"/>
                            <GridViewColumn Header="Size / All" Width="60" DisplayMemberBinding="{Binding Path=SizeFromAll}"/>
                            <GridViewColumn Header="Directories &amp; Files" Width="105" DisplayMemberBinding="{Binding Path=DirectoriesAndFiles}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBox x:Name="current_path" Margin="50,42,10,0" Text="root" VerticalAlignment="Top" FontSize="14" IsReadOnly="True"/>
                <Button IsEnabled="False" x:Name="go_up" ToolTip="Select a Directory" Margin="0,43,0,0" VerticalAlignment="Top" Click="GoUp_Click" HorizontalAlignment="Left" Background="{x:Null}">
                    <Image Source="Images/Appearance/go-up.png" Width="16" Height="16" Stretch="UniformToFill"/>
                </Button>
                <Button x:Name="go_home" IsEnabled="False" ToolTip="Go to home" Margin="25,43,0,0" VerticalAlignment="Top" Click="GoHome_Click" HorizontalAlignment="Left" Background="{x:Null}">
                    <Image Source="Images/Appearance/go-home.png" Width="16" Height="16" Stretch="UniformToFill"/>
                </Button>
            </Grid>

            <Grid Margin="695,0,0,0" HorizontalAlignment="Left" Width="600">
                <ListView x:Name="all_files_list" Margin="0,45,10,10" ItemsSource="{Binding}" PreviewKeyUp="ItemsList_PreviewKeyUp">
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event='PreviewKeyUp'  Handler='BigFileFinder_PreviewKeyUp'/>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <!--Background="{Binding Path=Background}"-->
                                            <TextBlock Margin="28,0,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Path=FileType}"/>
                            <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding Path=FileSize}"/>
                            <GridViewColumn Header="Size / All" Width="100" DisplayMemberBinding="{Binding Path=SizeFromAll}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <Grid Margin="1345,0,0,0" HorizontalAlignment="Left" Width="600">
                <ListView x:Name="statistical_list" Margin="0,45,10,10" ItemsSource="{Binding}" PreviewKeyUp="ItemsList_PreviewKeyUp">
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event='PreviewKeyUp'  Handler='BigFileFinder_PreviewKeyUp'/>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <!--Background="{Binding Path=Background}"-->
                                            <TextBlock Margin="28,0,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Path=FileType}"/>
                            <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding Path=FileSize}"/>
                            <GridViewColumn Header="Size / All" Width="100" DisplayMemberBinding="{Binding Path=SizeFromAll}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>



        <Button ToolTip="Select a Directory" Margin="5,41,0,0" VerticalAlignment="Top" Click="AnalyseDisk_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/folder-search.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="delete_files" ToolTip="Delete selected items" Margin="0,187,605,0" VerticalAlignment="Top" Click="DeleteItems_Click" IsEnabled="False" Background="{x:Null}" HorizontalAlignment="Right">
            <Image Source="Images/Appearance/delete.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="select_all" ToolTip="Select all items" Margin="0,150,605,0" VerticalAlignment="Top" Click="SelectAll_Click" Background="{x:Null}" HorizontalAlignment="Right" IsEnabled="False" RenderTransformOrigin="-7.969,1.094">
            <Image Source="Images/Appearance/select-all.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="clear_list" ToolTip="Clear List" Margin="0,224,605,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" IsEnabled="False">
            <Image Source="Images/Appearance/list-clear.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="Setting" Margin="0,261,605,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}">
            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <StackPanel Height="36" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="BROWSING" FontSize="18" Background="White" MouseUp="Label1_MouseUp" Cursor="Hand"/>
            <Label x:Name="label2" Content="ALL FILES" FontSize="18" Foreground="White" Background="Black" MouseUp="label2_MouseUp" Cursor="Hand"/>
            <Label x:Name="label3" Content="STATISTICAL" FontSize="18" Foreground="White" Background="Black" MouseUp="label2_MouseUp" Cursor="Hand"/>
            <ProgressBar x:Name="progressbar" Width="300" Margin="20,8,0,8" Maximum="5100" Visibility="Hidden"/>
        </StackPanel>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,32,0,0" VerticalAlignment="Top" Width="99"/>
    </Grid>
</Window>
