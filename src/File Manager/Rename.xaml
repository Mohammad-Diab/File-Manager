<Window x:Class="File_Manager.Rename"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name" Height="130" MaxHeight="130" MaxWidth="400" Width="400" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Icon="Images/Appearance/rename.png" PreviewKeyUp="Window_PreviewKeyUp">
    <Grid>
        <Button x:Name="Ok_button" Content="OK" Margin="150,0,150,10" VerticalAlignment="Bottom" IsDefault="True" Click="OK_Click" FontSize="14" Background="{x:Null}"/>
        <Button Content="Cancel" Margin="0,0,0,0" VerticalAlignment="Bottom" IsDefault="True" Click="Cancel_Click" IsCancel="True" FontSize="1" Background="{x:Null}" Visibility="Hidden"/>
        <TextBlock Text="Enter new name:" HorizontalAlignment="Left" Margin="55,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="name" Margin="55,28,51,0" Text="New Name" VerticalAlignment="Top" SpellCheck.IsEnabled="False" TabIndex="10" AutoWordSelection="True" MaxLines="1" MaxLength="255" TextChanged="Name_TextChanged" FontSize="14"/>
        <Image HorizontalAlignment="Left" Height="32" Margin="10,10,0,0" VerticalAlignment="Top" Width="32" Source="Images/Appearance/rename.png"/>
        <Button ToolTip="Switch between arabic char and english" Content="S" HorizontalAlignment="Right" Margin="0,28,28,0" VerticalAlignment="Top" Width="24" Background="{x:Null}" Height="21" BorderBrush="#FFABADB3"/>
        <Button ToolTip="Random file name" Content="R" HorizontalAlignment="Right" Margin="0,28,5,0" VerticalAlignment="Top" Width="24" Background="{x:Null}" Height="21" BorderBrush="#FFABADB3"/>
    </Grid>
</Window>
