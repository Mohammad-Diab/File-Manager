                    </Rectangle.Fill>
                </Rectangle>
                <Grid Margin="0,123,10,0" HorizontalAlignment="Right" Width="360" Height="75" VerticalAlignment="Top">
                    <RadioButton x:Name="compressed" Content="Compressed" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF404040" FontSize="16" Checked="AnyAttributes_Checked"/>
                    <RadioButton x:Name="encrypted" Content="Encrypted" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF404040" FontSize="16" Margin="0,25,0,0" Checked="AnyAttributes_Checked"/>
