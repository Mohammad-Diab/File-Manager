<Window x:Class="File_Manager.Create_Virtual_Hard_Disk"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Virtual Hard Disk" Height="560" Width="440" MinWidth="380" MinHeight="360" FontSize="14" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="options" BorderBrush="#FF7498BF" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,10,14,10">
                <StackPanel Orientation="Horizontal">
                    <Image Height="37" Width="37" Stretch="Fill" Source="Images/Icons/virtual-hard-drive.png"/>
                    <TextBlock x:Name="textBlock" Margin="8,0,0,0" Text="Virtual hard disk options" VerticalAlignment="Center" FontSize="26" TextDecorations="Underline" Foreground="#FF737575"/>
                </StackPanel>
                <TextBlock Margin="0,16,0,4" Text="File location"/>
                <Grid Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="disk_location" Height="28" VerticalContentAlignment="Center" BorderBrush="#FF737575" TextChanged="DiskLocation_TextChanged"/>
                    <Button Grid.Column="1" Content="..." Width="32" Height="28" Margin="4,0,0,0" Background="{x:Null}" BorderBrush="#FF737575" ToolTip="Choose where to save the virtual hard disk" Click="BrowseButton_Click"/>
                </Grid>
                <TextBlock Margin="0,14,0,4" Text="Format"/>
                <ComboBox x:Name="disk_format" Margin="20,0,0,0" HorizontalAlignment="Left" Width="260" SelectedIndex="0" SelectionChanged="DiskFormat_SelectionChanged">
                    <ComboBoxItem Content="VHD (Virtual PC, Hyper-V, Windows)" Tag="vpc"/>
                    <ComboBoxItem Content="VHDX (Hyper-V, Windows 8 and later)" Tag="vhdx"/>
                    <ComboBoxItem Content="QCOW2 (QEMU)" Tag="qcow2"/>
                    <ComboBoxItem Content="VDI (VirtualBox)" Tag="vdi"/>
                    <ComboBoxItem Content="VMDK (VMware)" Tag="vmdk"/>
                    <ComboBoxItem Content="Raw image (.img)" Tag="raw"/>
                </ComboBox>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="textBlock3" Text="Disk size" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="disk_size_text" Grid.Column="1" Width="80" Height="26" VerticalContentAlignment="Center" Text="20" BorderBrush="#FF737575" TextChanged="DiskSizeText_TextChanged"/>
                    <ComboBox x:Name="size_unit" Grid.Column="2" SelectedIndex="1" Margin="4,0,0,0" Width="56" Height="26" Background="{x:Null}" SelectionChanged="SizeUnit_SelectionChanged">
                        <ComboBoxItem Content="MB"/>
                        <ComboBoxItem Content="GB"/>
                    </ComboBox>
                    <TextBlock x:Name="size_hint" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Slider x:Name="disk_size" ToolTip="Disk Size" Margin="20,8,0,0" TickPlacement="TopLeft" SmallChange="16" TickFrequency="128" LargeChange="128" Maximum="4096" Value="20" Minimum="4" Foreground="#FF737575" ValueChanged="DiskSize_ValueChanged"/>
                <TextBlock Margin="0,14,0,4" Text="Type"/>
                <RadioButton x:Name="dynamic_expand" Content="Dynamically expanding" Margin="20,4,0,0" BorderBrush="#FF737575" ToolTipService.ShowOnDisabled="True" Tag="The file starts small and grows when data is written"/>
                <TextBlock Margin="40,4,0,0" TextWrapping="Wrap"><Run Text="The size of this virtual hard disk "/><Run Foreground="Green" Text="expands"/><Run Text=" to a fixed maximum size as data is saved to it."/><LineBreak/><Run Text="The disk size "/><Run Foreground="Red" Text="does not compact " TextDecorations="Underline"/><Run Text="automatically when data is deleted."/></TextBlock>
                <RadioButton x:Name="fixed_size" Margin="20,12,0,0" BorderBrush="#FF737575" IsChecked="True">
                    <TextBlock><Run Text="Fixed Size ("/><Run Foreground="Green" Text="Recommended"/><Run Text=")"/></TextBlock>
                </RadioButton>
                <TextBlock Margin="40,4,0,0" TextWrapping="Wrap"><Run Text="The virtual hard disk uses a "/><Run Foreground="Green" Text="fixed amount of space"/><Run Text=" regardless of the amount of the data stored on it. Creating it takes longer and needs the full size free on the drive."/></TextBlock>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="attach_button" Content="Attach VHD" Width="100" Height="28" Background="{x:Null}" BorderBrush="#FF737575" Tag="Show this VHD/VHDX file as a drive in Windows (Windows asks for administrator rights)" ToolTipService.ShowOnDisabled="True" Click="AttachVHD_Click"/>
            <Button x:Name="detach_button" Grid.Column="1" Content="Detach VHD" Width="100" Height="28" Margin="5,0,0,0" Background="{x:Null}" Foreground="Black" BorderBrush="#FF737575" Tag="Remove this attached VHD/VHDX drive from Windows (Windows asks for administrator rights)" ToolTipService.ShowOnDisabled="True" Click="DetachVHD_Click"/>
            <ProgressBar x:Name="progress" Grid.Column="2" Height="14" Margin="10,0" IsIndeterminate="False" Visibility="Hidden"/>
            <Button x:Name="create_button" Grid.Column="3" Content="CREATE" Width="110" Height="30" Background="{x:Null}" BorderBrush="#FF63839A" Foreground="#FF63839A" Tag="Create the virtual hard disk with qemu-img" ToolTipService.ShowOnDisabled="True" Click="CreateButton_Click"/>
        </Grid>
    </Grid>
</Window>
