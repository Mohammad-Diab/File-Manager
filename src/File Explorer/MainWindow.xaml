<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Custom="http://schemas.microsoft.com/winfx/2006/xaml/presentation/ribbon" x:Class="File_Manager.MainWindow"
        Title="File Manager" Width="810" Height="525" WindowStartupLocation="Manual" Loaded="Main_Window_Loaded" Icon="File_Manager.ico" PreviewKeyUp="Refresh">
    <Grid>
        <Grid Margin="0,51,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid x:Name="Properties" HorizontalAlignment="Right" Margin="0,0,0,0" Width="220" Visibility="Visible" Grid.RowSpan="1" Background="#FFE7E5E4">
                <Image x:Name="img" Height="200" Margin="10,20,10,0" VerticalAlignment="Top" Source="Images\Icons\computer.png"/>
                <StackPanel Margin="10,240,10,10">
                    <TextBlock x:Name="name" Margin="0,0,0,0" TextWrapping="Wrap" Text="Name:" VerticalAlignment="Top" FontSize="14"/>
                    <TextBlock x:Name="type" Margin="0,0,0,0" TextWrapping="Wrap" Text="Type:" VerticalAlignment="Top"/>
                    <TextBlock x:Name="size" Margin="0,0,0,0" TextWrapping="Wrap" Text="Size:" VerticalAlignment="Top"/>
                    <TextBlock x:Name="data_Modified" Margin="0,0,0,0" TextWrapping="Wrap" Text="Data Modified:" VerticalAlignment="Top"/>
                </StackPanel>
            </Grid>
            <ListView x:Name="Explorer" TextBlock.TextAlignment="Right" PreviewMouseDoubleClick="Traversing" Margin="0,0,220,19" SelectionChanged="View_Items_Basic_Info" PreviewKeyUp="Preview_Items" Foreground="#FF41403B">
                <!--<ListView.View>-->
                    <!--<GridView x:Name="vvv">
                        <GridViewColumn TextBlock.TextAlignment="Left" Header="Name" Width="275"/>
                        <GridViewColumn Header="Size" Width="90"/>
                        <GridViewColumn Header="Type" Width="85"/>
                        <GridViewColumn Header="Data Modified" Width="125"/>
                    </GridView>-->
                <!--</ListView.View>-->
            </ListView>
            <Grid VerticalAlignment="Bottom" Margin="0,0,220,0">
                <TextBlock x:Name="statebar" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontSize="14" Margin="2,0,0,0"/>
            </Grid>
        </Grid>
        <Grid Height="30" Margin="0,21,0,0" VerticalAlignment="Top" Background="#FFF2F1F0">
            <Button Content="Back" Click="Go_Back" Margin="3,3,0,3" VerticalAlignment="Stretch" Background="{x:Null}" HorizontalAlignment="Left" />
            <Button Content="Forword" Click="Go_Front" Margin="34,3,0,3" VerticalAlignment="Stretch" Background="{x:Null}" HorizontalAlignment="Left" />
            <ComboBox x:Name="backMenu" HorizontalAlignment="Left" Margin="87,6,0,6" Width="20" SelectionChanged="Surfing_Back"/>
            <Button Content="Up" Click="Go_UP" Margin="112,3,0,3" VerticalAlignment="Stretch" Background="{x:Null}" HorizontalAlignment="Left"/>
            <TextBox x:Name="Address" Text="Computer" Margin="136,6,255,6" Background="{x:Null}" KeyUp="Traversing_KeyBoard" HorizontalAlignment="Stretch"/>
            <Button Content="Refresh" Click="Refresh" Margin="0,3,206,3" VerticalAlignment="Stretch" Background="{x:Null}" HorizontalAlignment="Right"/>
            <TextBox x:Name="Search" Margin="0,6" Background="{x:Null}" HorizontalAlignment="Right" Width="200"/>
        </Grid>
        <Grid VerticalAlignment="Top" Background="#FFEEF5FD">
            <Menu Background="#FF41403B" Foreground="#FFF2F2EB">
                <MenuItem Header="Files" FontSize="14">
                    <MenuItem Header="New Window" Foreground="#FF41403B" Click="New_Window"/>
                    <MenuItem Header="New Window(Admin Propriety)" Foreground="#FF41403B" Click="New_Window_Admin"/>
                    <Separator/>
                    <MenuItem Header="BookMarks" Foreground="#FF41403B"/>
                    <Separator/>
                    <MenuItem Header="Preferences" Foreground="#FF41403B"/>
                    <MenuItem Header="about File Manager" Foreground="#FF41403B" Click="MenuItem_Click"/>
                    <MenuItem Header="Help" Foreground="#FF41403B"/>
                    <Separator/>
                    <MenuItem Header="Quit" Foreground="#FF41403B" Click="Quit"/>
                </MenuItem>
                <MenuItem Header="View" FontSize="14">
                    <MenuItem Header="Show Image" Foreground="#FF41403B" Click="MenuItem_Click_1"/>
                    <MenuItem Header="Zoom In" Foreground="#FF41403B"/>
                    <MenuItem Header="Zoom Out" Foreground="#FF41403B"/>
                    <MenuItem Header="Normal Size" Foreground="#FF41403B" Click="HH"/>
                    <Separator/>
                    <MenuItem Header="Refresh" Foreground="#FF41403B" Click="Refresh"/>
                    <Separator/>
                    <MenuItem Header="Show Details Pane" Foreground="#FF41403B"/>
                    <MenuItem Header="Show Hidden Files" Foreground="#FF41403B" Click="Show_Hidden_Files"/>
                </MenuItem>
                <MenuItem Header="Options" FontSize="14">
                    <MenuItem Header="New Tab" Foreground="#FF41403B"/>
                    <MenuItem Header="New Folder" Foreground="#FF41403B" Click="New_Folder"/>
                    <MenuItem Header="New Document" Foreground="#FF41403B">
                        <MenuItem Header="Text" Foreground="#FF41403B"/>
                    </MenuItem>
                    <Separator/>
                    <Grid>
                        <Button Width="40" Margin="-80,0,0,0" Content="Cut" Foreground="#FF41403B"/>
                        <Button Width="40" Margin="10,0,0,0" Content="Copy" Foreground="#FF41403B" Click="Copy"/>
                        <Button Width="40" Margin="100,0,0,0" Content="Paste" Foreground="#FF41403B" Click="Paste"/>
                    </Grid>
                    <MenuItem Header="Undo" Foreground="#FF41403B"/>
                    <MenuItem Header="Redo" Foreground="#FF41403B"/>
                    <Separator/>
                    <MenuItem Header="Select All" Foreground="#FF41403B"/>
                    <MenuItem Header="Inverse Selection" Foreground="#FF41403B"/>
                    <Separator/>
                    <MenuItem Header="BookMark This Location" Foreground="#FF41403B"/>
                    <MenuItem Header="Properties" Foreground="#FF41403B"/>
                    <Separator/>
                    <MenuItem Header="Close" Foreground="#FF41403B" Click="Close"/>
                </MenuItem>
            </Menu>
        </Grid>
    </Grid>
</Window>
