                                    <TextBlock Grid.Row="5" Text="Alt+Up" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Up one level" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="6" Text="F5" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Refresh" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="7" Text="Space" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Details of the selected items" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="8" Text="F2" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Rename" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="9" Text="Delete" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="Delete to the Recycle Bin" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="10" Text="Shift+Delete" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="Delete permanently" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="11" Text="Ctrl+C, Ctrl+X, Ctrl+V" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="11" Grid.Column="1" Text="Copy, cut and paste" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="12" Text="Ctrl+A" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="12" Grid.Column="1" Text="Select all" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="13" Text="Left, Right" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="13" Grid.Column="1" Text="Columns view: parent folder, open the selected folder" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="14" Text="Enter in the filter box" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,3"/>
                                    <TextBlock Grid.Row="14" Grid.Column="1" Text="Search in all sub-folders" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                </Grid>
                                <Separator Height="1" HorizontalAlignment="Left" Width="250" Margin="10,15,0,0" Background="WhiteSmoke"/>
                                <Button Style="{StaticResource link_button}" Content="Open the old explorer (legacy)" HorizontalAlignment="Left" Margin="6,10,0,0" VerticalAlignment="Top" FontSize="14" Foreground="DodgerBlue" ToolTip="Opens the legacy explorer window of File Manager" Click="OldExplorer_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ABOUT" Grid.Column="1" Margin="7,0,0,0" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="ABOUT" VerticalAlignment="Top" Foreground="White" FontSize="20"/>
                        <ScrollViewer Margin="0,42,0,0" VerticalScrollBarVisibility="Auto">
                            <local:About_Panel Foreground="White" LinkClick="AboutPanel_LinkClick"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>

        <Button x:Name="file_button" HorizontalAlignment="Left" VerticalAlignment="Top" Width="40" Height="30" BorderBrush="Blue" Foreground="White" Background="RoyalBlue" FontSize="18" Click="File_Click">
            <Button.Content>
                <Grid x:Name="hbrg_recs" Width="20">
                    <Image Height="20" Width="20" Margin="-40,0,0,0" Source="Images/Explorer Interface/arrow.png" Visibility="Hidden"/>
                    <Rectangle Fill="White" Height="2" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <Rectangle Fill="White" Height="2" VerticalAlignment="Top" Margin="0,9,0,0"/>
                    <Rectangle Fill="White" Height="2" VerticalAlignment="Top" Margin="0,14,0,0"/>
                </Grid>
            </Button.Content>
        </Button>
        <StackPanel Height="20" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,10,0">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14" Margin="10,1,20,0"><Run Foreground="#FF008CB6" x:Name="items_count" Text="0"/><Run x:Name="item_unit" Text=" item"/></TextBlock>
            <TextBlock x:Name="items_selected" FontSize="14" VerticalAlignment="Bottom" Margin="20,0,10,0"><Run x:Name="items_selected_count" Foreground="Red" Text="0"/><Run Text=" item selected"/></TextBlock>
            <TextBlock FontSize="14" VerticalAlignment="Bottom" x:Name="items_selected_size" Margin="15,0,10,0" Foreground="Green" Text="0 byte"/>
        </StackPanel>
    </Grid>
</Window>
