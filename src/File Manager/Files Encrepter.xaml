<Window x:Class="File_Manager.Files_Encrepter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encrypt files" Height="428" Width="702" Icon="Images/Tools Icon/Window/FilesEncrypter.ico" Closing="Window_Closing" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid x:Name="main_grid">
            <StackPanel x:Name="tab_panal" Height="36" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
                <Label x:Name="label1" Content="ENCRYPT FILES" FontSize="18" Background="White" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
                <Label x:Name="label2" Content="DE-ENCRYPT FILES" FontSize="18" Foreground="White" Background="Black" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
                <Label x:Name="label3" Content="VIEW PACK CONTENT" FontSize="18" Foreground="White" Background="Black" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
            </StackPanel>

            <Grid x:Name="mother" Margin="0,40,0,0">
                <Grid HorizontalAlignment="Left" Width="685" AllowDrop="True"  Drop="EncOutputText_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="encrypt_add_button" Tag="Add files" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}" Margin="10,5,0,0" Padding="2">
                        <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="encrypt_add_folder_button" Tag="Add folder (all files in it and in its sub-folders, links are not followed)" ToolTipService.ShowOnDisabled="True" Margin="47,5,0,0" VerticalAlignment="Top" Click="AddDirectory_Click" HorizontalAlignment="Left" Background="{x:Null}" Padding="2">
                        <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="encrypt_clear_button" Tag="Clear list" ToolTipService.ShowOnDisabled="True" Margin="0,5,10,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" Padding="2">
                        <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="encrypt_remove_button" Tag="Remove selected files from the list (Del)" ToolTipService.ShowOnDisabled="True" Margin="0,5,47,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}" Padding="2">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <ListView x:Name="encrypt_list" Margin="10,42,10,10" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}" AllowDrop="True" Drop="EncryptList_Drop" SelectionChanged="List_SelectionChanged" PreviewKeyDown="List_PreviewKeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="{Binding FullPath}">
                                    <TextBlock Margin="28,4,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left"/>
                                    <Image Margin="0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Rectangle Fill="#FF9CC9F0" Width="2" Margin="0,30" HorizontalAlignment="Left" Grid.Column="1"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Encrypt options" VerticalAlignment="Top" Foreground="#FF003397" FontSize="20" Grid.Column="1"/>
                    <Button x:Name="encrypt_button" Tag="Encrypt the files of the list" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Bottom" Content="Encrypt" Foreground="White" Click="Encrypt_Click" Height="32" Background="#FF40E2E2" FontSize="18" HorizontalAlignment="Right" Width="109" Margin="0,0,15,25" Grid.Column="1"/>
                    <Grid Margin="20,70,15,0" Grid.Column="1" Height="20" VerticalAlignment="Top">
                        <TextBox x:Name="enc_password_text" Height="18" Margin="0,1,27,1" Visibility="Collapsed" TextChanged="Password_Changed"/>
                        <PasswordBox x:Name="enc_password" Height="18" MaxLength="128" Margin="0,1,27,0" VerticalAlignment="Top" PasswordChanged="Password_Changed"/>
                        <ToggleButton x:Name="enc_show_password" HorizontalAlignment="Right" Width="20"  Background="{x:Null}" Click="ShowPassword_Click">
                            <Image Source="Images/Appearance/show-passwoed.png" Stretch="Fill"/>
                        </ToggleButton>
                    </Grid>
                    <TextBlock HorizontalAlignment="Left" Margin="10,45,0,0" TextWrapping="Wrap" Text="Password:" FontSize="14" VerticalAlignment="Top" Grid.Column="1"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,110,0,0" TextWrapping="Wrap" Text="Output files" VerticalAlignment="Top" FontSize="14" Grid.Column="1"/>
                    <CheckBox x:Name="enc_delete_files" Content="Securely delete the original files after encryption." ToolTip="When the encryption ends, File Destroyer opens with only the original files whose encrypted copy was written and verified.&#x0a;You choose the destroy method there and confirm before anything is destroyed." ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Left" Margin="10,255,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Red" BorderBrush="Green" IsChecked="False" Grid.Column="1"/>
                    <TextBlock Margin="10,0,0,5" Text="All files in the list will be encrypt with same password." TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Foreground="Green" HorizontalAlignment="Left" Grid.Column="1"/>
                    <CheckBox x:Name="enc_file_name" Content="Encrypt files name and extension." HorizontalAlignment="Left" Margin="10,235,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="False" Grid.Column="1"/>
                    <CheckBox x:Name="enc_pack_files" Content="Put all files in one encrypted package." ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Left" Margin="10,215,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="False" Grid.Column="1"/>
                    <RadioButton x:Name="overwrite_file" Content="Overwrite original files." ToolTip="Every file is encrypted to '&lt;name&gt;.enf' next to it. Only after the encrypted copy is verified, the original is overwritten with zeros, renamed, emptied and deleted." HorizontalAlignment="Left" Margin="20,135,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="False" Grid.Column="1" Checked="EncryptOverwriteFile_Checked"/>
                    <RadioButton Content="in specific location:" HorizontalAlignment="Left" Margin="20,155,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="True" Grid.Column="1" Checked="RadioButton_Checked"/>
                    <Grid x:Name="enc_output_grid" Grid.Column="1" Margin="20,176,15,0" VerticalAlignment="Top" ToolTipService.ShowOnDisabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="enc_output" VerticalAlignment="Top" MaxLines="1" MaxLength="248" ToolTip="Folder for the encrypted files, you can type it or choose it with '...'"/>
                        <Button x:Name="encrypt_browser_button" Grid.Column="1" Content="..." ToolTip="Choose the folder for the encrypted files" Width="24" Height="{Binding ActualHeight, ElementName=enc_output}" Margin="-1,0,0,0" VerticalAlignment="Top" Background="{x:Null}" Click="Browser_Click"/>
                    </Grid>
                </Grid>

                <Grid HorizontalAlignment="Left" Margin="700,0,0,0" Width="685" AllowDrop="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="decrypt_add_button" Tag="Add encrypted files (.enf, .enp, .fme)" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Top" Click="AddFile_Click" HorizontalAlignment="Left" Background="{x:Null}" Margin="10,5,0,0" Padding="2">
                        <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="decrypt_add_folder_button" Tag="Add folder (only the files encrypted by File Manager in it and in its sub-folders)" ToolTipService.ShowOnDisabled="True" Margin="47,5,0,0" VerticalAlignment="Top" Click="AddDirectory_Click" HorizontalAlignment="Left" Background="{x:Null}" Padding="2">
                        <Image Source="Images/Appearance/add-folder.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="decrypt_clear_button" Tag="Clear list" ToolTipService.ShowOnDisabled="True" Margin="0,5,10,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" Padding="2">
                        <Image Source="Images/Appearance/list-clear.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <Button x:Name="decrypt_remove_button" Tag="Remove selected files from the list (Del)" ToolTipService.ShowOnDisabled="True" Margin="0,5,47,0" VerticalAlignment="Top" Click="RemoveSelected_Click" HorizontalAlignment="Right" Background="{x:Null}" Padding="2">
                        <Image Source="Images/Appearance/list-remove.png" Height="28" Width="28" Stretch="UniformToFill"/>
                    </Button>
                    <ListView x:Name="decrypt_list" Margin="10,42,10,10" SelectionMode="Extended" ItemsSource="{Binding}" Background="{x:Null}" AllowDrop="True" Drop="DecryptList_Drop" SelectionChanged="List_SelectionChanged" PreviewKeyDown="List_PreviewKeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="{Binding FullPath}">
                                    <TextBlock Margin="28,4,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left"/>
                                    <Image Margin="0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Rectangle Fill="#FF9CC9F0" Margin="0,30,0,30" HorizontalAlignment="Left" Width="2" Grid.Column="1"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Decrypt options" VerticalAlignment="Top" Foreground="#FF003397" FontSize="20" Grid.Column="1"/>
                    <Button x:Name="decrypt_button" Tag="Decrypt the files of the list" ToolTipService.ShowOnDisabled="True" FontSize="18" VerticalAlignment="Bottom" Click="Decrypt_Click" Content="De-encrypt" Height="32" Background="#FF883CD4" Foreground="White" HorizontalAlignment="Right" Width="109" Margin="0,0,15,25" Grid.Column="1">
                        <!--<Grid Width="105" Height="28">
                            <TextBlock Text="De-encrypt" Foreground="White" Margin="35,5,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Image Source="Images/Appearance/rename.png" Width="28" Stretch="Fill" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>-->
                    </Button>
                    <TextBlock HorizontalAlignment="Left" Margin="10,45,0,0" TextWrapping="Wrap" Text="Password:" FontSize="14" VerticalAlignment="Top" Grid.Column="1"/>
                    <Grid Grid.Column="1" Margin="20,135,15,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="dec_output" VerticalAlignment="Top" MaxLines="1" MaxLength="248" AllowDrop="True" PreviewDragOver="PackPath_DragOver" PreviewDrop="DecOutputText_Drop" ToolTip="Folder for the decrypted files, you can type it or choose it with '...'"/>
                        <Button x:Name="dec_browser_button" Grid.Column="1" Content="..." ToolTip="Choose the folder for the decrypted files" Width="24" Height="{Binding ActualHeight, ElementName=dec_output}" Margin="-1,0,0,0" VerticalAlignment="Top" Background="{x:Null}" Click="Browser_Click"/>
                    </Grid>
                    <TextBlock HorizontalAlignment="Left" Margin="10,110,0,0" TextWrapping="Wrap" Text="Save output files in" VerticalAlignment="Top" FontSize="14" Grid.Column="1"/>
                    <TextBlock Margin="10,0,15,5" TextTrimming="CharacterEllipsis" Text="Make sure that all files in list have the same password." VerticalAlignment="Bottom" Foreground="Red" MaxHeight="36" Grid.Column="1"/>
                    <Grid Margin="20,70,15,0" Grid.Column="1" Height="20" VerticalAlignment="Top">
                        <TextBox x:Name="dec_password_text" Height="18" Margin="0,1,27,1" Visibility="Collapsed" TextChanged="Password_Changed"/>
                        <PasswordBox x:Name="dec_password" Height="18" MaxLength="128" Margin="0,1,27,0" VerticalAlignment="Top" PasswordChanged="Password_Changed"/>
                        <ToggleButton x:Name="dec_show_password" HorizontalAlignment="Right" Width="20"  Background="{x:Null}" Click="ShowPassword_Click">
                            <Image Source="Images/Appearance/show-passwoed.png" Stretch="Fill"/>
                        </ToggleButton>
                    </Grid>
                    <CheckBox x:Name="dec_package_directory" Margin="10,176,0,0" VerticalAlignment="Top" FontSize="12" Foreground="Black" BorderBrush="Green" IsChecked="False" Grid.Column="1" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Text="Files which encrypted in a package, save them in a separated directory."/>
                    </CheckBox>
                </Grid>

                <Grid HorizontalAlignment="Left" Margin="1400,0,0,0" Width="685">
                    <Button x:Name="pack_open_button" ToolTip="Open an encrypted package or file (.enp, .enf)" VerticalAlignment="Top" Click="PackOpen_Click" HorizontalAlignment="Left" Background="{x:Null}" Margin="10,5,0,0" Padding="2">
                        <Image Source="Images/Appearance/add-files.png" Width="28" Height="28" Stretch="UniformToFill"/>
                    </Button>
                    <TextBox x:Name="pack_path" Margin="50,10,350,0" VerticalAlignment="Top" Height="22" IsReadOnly="True" AllowDrop="True" PreviewDragOver="PackPath_DragOver" PreviewDrop="PackPath_Drop" TextChanged="Pack_Changed" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock HorizontalAlignment="Right" Margin="0,12,270,0" Text="Password:" FontSize="14" VerticalAlignment="Top"/>
                    <PasswordBox x:Name="pack_password" Height="22" MaxLength="128" Margin="0,10,125,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="140" PasswordChanged="Pack_Changed" KeyDown="PackPassword_KeyDown"/>
                    <Button x:Name="pack_show_button" Tag="Show the files in the package (Enter in the password box)" ToolTipService.ShowOnDisabled="True" Content="Show content" HorizontalAlignment="Right" Margin="0,10,15,0" VerticalAlignment="Top" Width="100" Height="22" Background="{x:Null}" Click="PackShow_Click"/>
                    <ListView x:Name="pack_list" Margin="10,42,10,80" SelectionMode="Extended" Background="{x:Null}" SelectionChanged="PackList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="440" DisplayMemberBinding="{Binding Path=Name}"/>
                                <GridViewColumn Header="Size" Width="150" DisplayMemberBinding="{Binding Path=Size}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock HorizontalAlignment="Left" Margin="10,0,0,52" Text="Extract to:" FontSize="14" VerticalAlignment="Bottom"/>
                    <Grid Margin="90,0,195,50" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="pack_output" Height="22" VerticalAlignment="Top" MaxLines="1" MaxLength="248" AllowDrop="True" PreviewDragOver="PackPath_DragOver" PreviewDrop="DecOutputText_Drop" ToolTip="Folder for the extracted files, you can type it or choose it with '...'"/>
                        <Button x:Name="pack_browser_button" Grid.Column="1" Content="..." ToolTip="Choose the folder for the extracted files" Width="24" Height="{Binding ActualHeight, ElementName=pack_output}" Margin="-1,0,0,0" VerticalAlignment="Top" Background="{x:Null}" Click="Browser_Click"/>
                    </Grid>
                    <Button x:Name="pack_extract_button" Tag="Extract the selected files, or all files when nothing is selected" ToolTipService.ShowOnDisabled="True" Content="Extract selected" FontSize="16" HorizontalAlignment="Right" Margin="0,0,15,46" VerticalAlignment="Bottom" Width="170" Height="30" Background="#FF883CD4" Foreground="White" Click="PackExtract_Click"/>
                    <TextBlock Margin="10,0,15,10" TextTrimming="CharacterEllipsis" Text="Open an encrypted package (.enp) or file (.enf), enter its password, then extract all files or only the selected ones." VerticalAlignment="Bottom" Foreground="Green"/>
                </Grid>
            </Grid>
            <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,32,0,0" VerticalAlignment="Top" Width="125"/>
        </Grid>
        <Button ToolTip="About Files Encrypter" HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" Background="{x:Null}" BorderBrush="{x:Null}" Click="AboutTool_Click">
            <Image Stretch="Fill" Source="Images/Menu/about-tool.png"/>
        </Button>
    </Grid>
</Window>
