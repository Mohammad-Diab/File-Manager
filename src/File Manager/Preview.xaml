                        <Image x:Name="image_view" Stretch="None"/>
                    </ScrollViewer>
                    <Grid x:Name="image_control" MouseEnter="ImageControl_MouseEnter" MouseLeave="ImageControl_MouseLeave">
                        <TextBlock x:Name="zoom_value" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,10,0"/>
                        <Button x:Name ="rotate_left" Foreground ="black" FontSize ="28" FontWeight ="Bold" Margin="301,0,0,10" Template="{StaticResource roundButtonTemplate}" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalAlignment="Left" Width="60" Visibility="Visible" MouseEnter="Grid1_MouseOver" MouseLeave="Grid1_MouseLeave" Height="64" VerticalAlignment="Bottom" Click="RotateLeft_Click">
                            <Button.Content>
                                <Image x:Name="play_content" Source="Images/Menu/rotate-left.png" Height="32" Width="32"/>
                            </Button.Content>
                        </Button>
                        <Button x:Name ="save_image" Foreground ="White" FontSize ="28" FontWeight ="Bold" Template="{StaticResource roundButtonTemplate}"  Margin="368,0,0,10" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalAlignment="Left" Width="60" Visibility="Visible" IsEnabled="True" MouseEnter="Grid1_MouseOver" MouseLeave="Grid1_MouseLeave" Click="SaveImage_Click" Height="64" VerticalAlignment="Bottom">
                            <Button.Content>
                                <Image x:Name="pause_content" Source="Images/Appearance/save.png" Height="32" Width="32"/>
                            </Button.Content>
                        </Button>
                        <Button x:Name ="rotate_right" Template="{StaticResource roundButtonTemplate}"  Foreground ="White" FontSize ="28" FontWeight ="Bold" Margin="437,0,0,10" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalAlignment="Left" Width="60" Visibility="Visible" MouseEnter="Grid1_MouseOver" MouseLeave="Grid1_MouseLeave" Click="RotateRight_Click" Height="64" VerticalAlignment="Bottom">
                            <Button.Content>
                                <Image Source="Images/Menu/rotate-right.png" Height="32" Width="32"/>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Grid>
                <Grid x:Name="audio_player" Visibility="Collapsed" MouseMove="AudioPlayerGrid_MouseMove" MouseWheel="AudioPlayerGrid_MouseWheel" Background="#FF404040">
                    <MediaElement x:Name="audio_player_element" Margin="10,10,0,0" MediaOpened="AudioPlayer_MediaOpened" MediaFailed="AudioPlayer_MediaFailed" MediaEnded="AudioPlayer_MediaEnded" Volume="0.75" HorizontalAlignment="Left" Width="40" Height="40" VerticalAlignment="Top"/>
                    <ListBox x:Name="audio_play_list" HorizontalAlignment="Right" Margin="0,144,20,10" Width="220" Background="{x:Null}" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="16" SelectionChanged="AudioPlayList_SelectionChanged"/>
                    <Button Template="{StaticResource bigRoundButtonTemplate}" Margin="238,208,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="125" Click="AudioPlayPause_Click">
                        <Button.Content>
                            <Image ToolTip="Play" x:Name="audio_paly_button_image" Source="Images/Menu/media-play.png" Height="64" Width="64" Stretch="Fill" RenderTransformOrigin="0.5,0.5"/>
                        </Button.Content>
                    </Button>
                    <TextBlock x:Name="playing_file_name" Margin="10,10,20,0" Text="Song Name" VerticalAlignment="Top" Foreground="#BFFFFFFF" FontSize="72" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
