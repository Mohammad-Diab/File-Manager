<Window x:Class="File_Explorer.File_Operation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Operation" Width="500" ResizeMode="NoResize" ScrollViewer.CanContentScroll="True" Loaded="Window_Loaded" Height="115" Icon="Images/Appearance/file-operation.png">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo Description="Pause this operation" ImageSource="Images/Menu/copy-pause.png" Click="Pause_ThumbButtonInfo_Click"/>
                <ThumbButtonInfo Description="Resume this operation" ImageSource="Images/Menu/copy-start.png" Click="Start_ThumbButtonInfo_Click"/>
                <ThumbButtonInfo Description="Stop this operation" ImageSource="Images/Menu/copy-stop.png" Click="Stop_ThumbButtonInfo_Click"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid>
        <ProgressBar x:Name="PB" Margin="10,0,10,5" Height="20" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="TextBlock1" Margin="10,3,70,0" VerticalAlignment="Top" FontSize="14" TextTrimming="CharacterEllipsis">
            <Run x:Name="op" Text="Copying: "/>
            <Run x:Name="completed" Foreground="Green" FontSize="16"/>
            <Run Text=" completed of "/><Run x:Name="items_number" Foreground="Green" FontSize="16"/>
            <Run x:Name="to"/>
        </TextBlock>
        <Button HorizontalAlignment="Right" Margin="0,12,10,0" Width="24" Height="24" VerticalAlignment="Top" Background="{x:Null}" Click="Stop_Click">
            <Button.Content>
                <Image Source="Images/Menu/copy-stop.png" />
            </Button.Content>
        </Button>
        <Button x:Name="play_pause" HorizontalAlignment="Right" Margin="0,12,39,0" Width="24" Height="24" VerticalAlignment="Top" Background="{x:Null}" Click="PlayPause_Click">
            <Button.Content>
                <Image x:Name="play_pause_img" Source="Images/Menu/copy-pause.png"/>
            </Button.Content>
        </Button>
        <TextBlock Margin="217,0,0,5" VerticalAlignment="Bottom" TextAlignment="Center" Foreground="Black" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Width="60" Height="20"><Run x:Name="percent" Text="0"/><Run Text="%"/></TextBlock>
        <TextBlock Margin="10,23,70,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis">
            <Run Text="Name: "/>
            <Run x:Name="item_name"/>
        </TextBlock>
        <TextBlock Margin="10,39,70,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"><Run Text="Spead: "/><Run x:Name="speed"/></TextBlock>
    </Grid>
</Window>
