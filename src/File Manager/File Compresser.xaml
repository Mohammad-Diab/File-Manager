<Window x:Class="File_Manager.File_Compresser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File_Compresser" Height="420" Width="640">
    <Grid>
        <ListView x:Name="list" Margin="10,75,10,10" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock Margin="25,0,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left"/>
                                    <Image Margin="0" Source="{Binding Path=Image}" Height="18" Width="18" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Path=FileType}"/>
                    <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding Path=FileSize}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Menu VerticalAlignment="Top" FontSize="14">
            <MenuItem Header="ARCHIVE">
                <MenuItem Header="New"/>
                <MenuItem Header="Open archive project"/>
                <MenuItem Header="Open archive"/>
                <Separator/>
                <MenuItem Header="Save"/>
                <MenuItem Header="Save as"/>
                <Separator/>
                <MenuItem Header="Compress"/>
                <Separator/>
                <MenuItem Header="Close"/>
            </MenuItem>
            <MenuItem Header="FILES">
                <MenuItem Header="Add files"/>
                <MenuItem Header="Add foleder"/>
                <Separator/>
                <MenuItem Header="Remove selected items"/>
                <MenuItem Header="Clear list"/>
            </MenuItem>
            <MenuItem Header="TOOLS">
                <MenuItem Header="Setting"/>
            </MenuItem>
        </Menu>
        <TextBox x:Name="current_path" Margin="35,50,10,0" Text="root" VerticalAlignment="Top" FontSize="14"/>
        <Button ToolTip="Select a Directory" Margin="10,50,0,0" VerticalAlignment="Top" Click="GoUp_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/go-up.png" Width="16" Height="16" Stretch="UniformToFill"/>
        </Button>
        <ToolBarPanel Height="24" Margin="0,24,0,0" VerticalAlignment="Top" Orientation="Horizontal">
            <Button ToolTip="New archive" Margin="10,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}">
                <Image Source="Images/Appearance/new-archive.png" Stretch="UniformToFill"/>
            </Button>
            <Button ToolTip="Open" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}">
                <Image Source="Images/Appearance/open.png" Stretch="UniformToFill"/>
            </Button>
            <Button ToolTip="Save project" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}">
                <Image Source="Images/Appearance/save.png" Stretch="UniformToFill"/>
            </Button>
            <Rectangle Margin="5,1,5,1" Width="1" Stroke="#FF4B9B9B"/>
            <Button ToolTip="Compress" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}">
                <Image Source="Images/Appearance/compress.png" Stretch="UniformToFill"/>
            </Button>
            <Rectangle Margin="5,1,5,1" Width="1" Stroke="#FF4B9B9B"/>
            <Button ToolTip="Add files" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Margin="2,0,2,0" Click="AddFiles_Click">
                <Image Source="Images/Appearance/add-files.png" Stretch="UniformToFill"/>
            </Button>
            <Button ToolTip="Add folder" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Margin="2,0,2,0" Click="AddDirectory_Click">
                <Image Source="Images/Appearance/add-folder.png" Stretch="UniformToFill"/>
            </Button>
            <Button x:Name="remove_selected" Margin="2,0,2,0" ToolTip="Remove selected files" VerticalAlignment="Top" Background="{x:Null}">
                <Image Source="Images/Appearance/list-remove.png" Stretch="UniformToFill"/>
            </Button>
            <Button ToolTip="Clear list" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}">
                <Image Source="Images/Appearance/list-clear.png" Stretch="UniformToFill"/>
            </Button>
        </ToolBarPanel>
    </Grid>
</Window>
