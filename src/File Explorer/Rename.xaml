<Window x:Class="File_Manager.Rename"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="_name" Title="Name" Height="120" Width="350" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded_1">
    <Grid>
        <Button Content="OK" Margin="135,56,135,0" VerticalAlignment="Top" IsDefault="True" Click="Button_Click_1" Height="21"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" Width="0" Visibility="Collapsed" IsCancel="True" Click="Button_Click_2"/>
        <Label Content="Enter the Name:" HorizontalAlignment="Left" Margin="5,7,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="name" Margin="20,35,20,0" TextWrapping="Wrap" Text="New Name" VerticalAlignment="Top" SpellCheck.IsEnabled="True" TabIndex="10" AutoWordSelection="True" MaxLines="1" MaxLength="255"/>
        <TextBlock x:Name="Label1" Text="File name can't contain any of these characters:&#xD;&#xA;\ / : * ? &quot; > |" VerticalAlignment="Top" Foreground="Red" TextAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,82,0,-34"/>
    </Grid>
</Window>
