<Window x:Class="File_Manager.Subtitle_Option"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Subtitle Options" Height="469" Width="450" WindowStartupLocation="CenterScreen" FontSize="14" Loaded="Window_Loaded" PreviewKeyUp="Window_PreviewKeyUp" ResizeMode="CanMinimize">
    <Grid>
        <Grid x:Name="mother" Margin="0,0,0,0">
            <Grid Width="445" HorizontalAlignment="Left">
                <TextBlock HorizontalAlignment="Left" Margin="10,50,0,0" TextWrapping="Wrap" Text="Preview" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,370,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Font size"/>
                <TextBlock HorizontalAlignment="Left" Margin="300,130,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Color"/>
                <ListBox x:Name="FontsNames" Margin="10,150,155,0" SelectionChanged="FontsNames_SelectionChanged" Height="205" VerticalAlignment="Top"/>
                <Slider x:Name="FontSizes" Margin="80,370,155,0" VerticalAlignment="Top" SmallChange="2" Minimum="8" Maximum="72" TickPlacement="BottomRight" Value="22" Ticks="8 9 10 11 12 14 16 18 20 22 24 26 28 36 48 72" AutoToolTipPlacement="BottomRight" ValueChanged="FontSizes_ValueChanged" LargeChange="10"/>
                <ListBox x:Name="FontColors" Margin="300,150,10,0" SelectionChanged="FontColors_SelectionChanged" Height="205" VerticalAlignment="Top"/>
                <TextBox x:Name="TextTest" Margin="10,70,10,0" Text="هلا سكنت بذي ضغث فقد زعموا &#xD;&#xA;شخصت تطلب ظبيا راح مجتازا" TextAlignment="Center" AutoWordSelection="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AcceptsTab="True" Height="50" VerticalAlignment="Top" TextChanged="TextTest_TextChanged"/>
                <CheckBox x:Name="Bold" Content="Bold" Margin="375,370,0,0" VerticalAlignment="Top" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                <CheckBox x:Name="Italic" Content="Italic" HorizontalAlignment="Left" Margin="300,370,0,0" VerticalAlignment="Top" FlowDirection="LeftToRight"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,130,0,0" TextWrapping="Wrap" Text="Font" VerticalAlignment="Top"/>
            </Grid>
            <Grid Margin="450,0,0,0" Width="445" HorizontalAlignment="Left">
                <TextBlock HorizontalAlignment="Left" Margin="10,64,0,0" TextWrapping="Wrap" Text="Subtitle Synchronize" VerticalAlignment="Top"/>
                <TextBox HorizontalAlignment="Left" Margin="51,88,0,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" Width="95"/>
                <ComboBox HorizontalAlignment="Left" Margin="195,88,0,0" VerticalAlignment="Top" Width="68" SelectedIndex="0">
                    <ComboBoxItem Content="second"/>
                    <ComboBoxItem Content="minite"/>
                </ComboBox>
                <TextBlock HorizontalAlignment="Left" Margin="10,265,0,0" TextWrapping="Wrap" Text="Subtitle Encode" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,200,0,0" TextWrapping="Wrap" Text="Position" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,222,0,0" TextWrapping="Wrap" Text="left" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="231,222,0,0" TextWrapping="Wrap" Text="Botton" VerticalAlignment="Top"/>
                <TextBox HorizontalAlignment="Left" Height="23" Margin="291,217,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="103"/>
                <TextBox HorizontalAlignment="Left" Height="23" Margin="51,217,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="85"/>

            </Grid>
            <TextBlock HorizontalAlignment="Left" Margin="10,0,0,10" TextWrapping="Wrap" VerticalAlignment="Bottom" Foreground="Red" FontSize="12"><InlineUIContainer>
            		<Image Height="16" Width="16"/>
            	</InlineUIContainer><Run Text=" "/><Run FlowDirection="RightToLeft" Language="ar-sa" Text="سيقوم ذلك باستبدال الخيار في ملف الترجمة"/></TextBlock>
        </Grid>
        <StackPanel Height="45" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="FONT STYLE" FontSize="24" Background="White" MouseUp="Label1_MouseUp" Cursor="Hand"/>
            <Label x:Name="label2" Content="SUBTITLE SETTING" FontSize="24" Foreground="White" Background="Black" MouseUp="label2_MouseUp" Cursor="Hand"/>
        </StackPanel>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,41,0,0" VerticalAlignment="Top" Width="144"/>
        <Button x:Name="_Save" Content="save" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Height="25" Click="Save_Setting" FontSize="12"/>
        <Button x:Name="_Cancel" Content="cancel" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Click="Cancel" Height="25" FontSize="12"/>
    </Grid>
</Window>
