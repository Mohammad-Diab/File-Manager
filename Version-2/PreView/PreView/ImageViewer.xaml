<Window x:Class="PreView.ImageViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PreView"
        mc:Ignorable="d"
        Title="ImageViewer" Height="250" Width="400">
    <Grid>
        
        <Grid Margin="40,0,0,0" Background="#FF404040">

            <Image x:Name="image" RenderTransformOrigin="0.5,0.5" OpacityMask="#FF404040"/>

            <StackPanel x:Name="controls" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" Margin="0,0,10,5" MinWidth="220" HorizontalAlignment="Right" Width="228">
                <Button Width="40" Margin="2,0,2,0" Background="#FFF0F0F0" BorderBrush="Black">
                    <StackPanel Orientation="Horizontal">
                        <Image/>
                        <TextBlock/>
                    </StackPanel>
                </Button>
                <Button Width="40" Margin="2,0,2,0" Background="#FFF0F0F0" BorderBrush="Black">
                    <StackPanel Orientation="Horizontal">
                        <Image/>
                        <TextBlock/>
                    </StackPanel>
                </Button>
                <Button Width="40" Margin="2,0,2,0" Background="#FFF0F0F0" BorderBrush="Black">
                    <StackPanel Orientation="Horizontal">
                        <Image/>
                        <TextBlock/>
                    </StackPanel>
                </Button>
                <Button Width="40" Margin="2,0,2,0" Background="#FFF0F0F0" BorderBrush="Black">
                    <StackPanel Orientation="Horizontal">
                        <Image/>
                        <TextBlock/>
                    </StackPanel>
                </Button>
                <Button Width="40" Margin="2,0,2,0" Background="#FFF0F0F0" BorderBrush="Black">
                    <StackPanel Orientation="Horizontal">
                        <Image/>
                        <TextBlock/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid x:Name="caution" Height="30" VerticalAlignment="Top" Visibility="Hidden">
                <Rectangle Fill="Black" Height="30" Stroke="Black" VerticalAlignment="Bottom" Opacity="0.5"/>
                <Rectangle Height="29" VerticalAlignment="Bottom" Opacity="0.9" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.Stroke>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFB40100" Offset="0"/>
                            <GradientStop Color="#FFDC02FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Stroke>
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                            <GradientStop Color="#FFB40100" Offset="1"/>
                            <GradientStop Color="#FFDC0200"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock x:Name="failed" Text="Can't open this image file, make sure that the file is not too large and it is a correct image file." Foreground="WhiteSmoke" FontSize="16" TextAlignment="Center" Height="24" VerticalAlignment="Top" Margin="0,3,0,0" FontWeight="SemiBold"/>
            </Grid>

        </Grid>

        <Grid x:Name="main_grid" Margin="-100,0,0,0">
            <Rectangle Fill="#FF202020" Stroke="Black" HorizontalAlignment="Left" Width="140"/>
            <ItemsControl Margin="0,35,0,0" HorizontalAlignment="Left" Width="140" >
                <Button Height="30" Margin="0,2,0,2" Background="#FF202020" BorderBrush="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <Image/>
                        <TextBlock Text="Delete" Foreground="White" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button Height="30" Margin="0,2,0,2"  Background="#FF202020" BorderBrush="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <Image/>
                        <TextBlock Text="Delete" Foreground="White" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button Height="30" Margin="0,2,0,2" Background="#FF202020" BorderBrush="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <Image/>
                        <TextBlock Text="Delete" Foreground="White" FontSize="14"/>
                    </StackPanel>
                </Button>
            </ItemsControl>
        </Grid>

        <Button x:Name="file_button" HorizontalAlignment="Left" VerticalAlignment="Top" Width="40" Height="30" BorderBrush="Blue" Foreground="White" Background="RoyalBlue" FontSize="18" Click="File_Click">
            <Grid x:Name="hbrg_recs" Width="20">
                <Image Height="20" Width="20" Margin="-40,0,0,0" Source="Image/Interface/back_arrow.png" Visibility="Hidden"/>
                <Rectangle Fill="White" Height="2" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <Rectangle Fill="White" Height="2" VerticalAlignment="Top" Margin="0,9,0,0"/>
                <Rectangle Fill="White" Height="2" VerticalAlignment="Top" Margin="0,14,0,0"/>
            </Grid>
        </Button>

    </Grid>
</Window>
