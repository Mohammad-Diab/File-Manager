                            <GradientStop Color="#FFA0D8EF" Offset="0.329"/>
                            <GradientStop Color="#FFCEEBF6" Offset="0.855"/>
                            <GradientStop Color="#FF93D2EC" Offset="0.177"/>
                            <GradientStop Color="#FFB1DFF1" Offset="0.502"/>
