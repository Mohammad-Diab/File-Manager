<Window x:Class="File_Manager.File_Compresser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Compresser" Height="420" Width="640" Closing="Window_Closing" Icon="Images/Appearance/compress-48.png">
    <Grid>
        <ListView x:Name="list" Margin="10,75,10,10" ItemsSource="{Binding}">
            <ListView.Resources>
                <Style TargetType="{x:Type ListViewItem}">
                    <EventSetter Event='MouseDoubleClick' Handler='Item_DoubleClick'/>
                    <!--<EventSetter Event='ContextMenuOpening'  Handler='Item_ContextMenuOpening'/>-->
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock Margin="31,2,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left" FontSize="14"/>
                                    <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Path=FileType}"/>
                    <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding Path=FileSize}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Menu VerticalAlignment="Top" FontSize="14">
            <MenuItem Header="ARCHIVE">
                <MenuItem Header="New" Click="NewArchive_Click"/>
                <MenuItem Header="Open archive project" Click="OpenProject_Click"/>
                <MenuItem Header="Open archive" Click="OpenArchive_Click"/>
                <Separator/>
                <MenuItem x:Name="close_archive" Header="Close archive" IsEnabled="False" Click="CloseArchive_Click"/>
                <Separator/>
                <MenuItem x:Name="save_menu" Header="Save" Click="SaveProject_Click"/>
                <Separator/>
                <MenuItem x:Name="compress_menu" Header="Compress" Click="Compress_Click"/>
                <Separator/>
                <MenuItem Header="Close" Click="Close_Click"/>
            </MenuItem>
            <MenuItem Header="FILES" x:Name="files_menu">
                <MenuItem Header="Add files" Click="AddFiles_Click"/>
                <MenuItem Header="Add foleder" Click="AddDirectory_Click"/>
                <Separator/>
                <MenuItem Header="Remove selected items" Click="RemoveSelectedItem_Click"/>
                <MenuItem Header="Clear list" Click="ClearList_Click"/>
            </MenuItem>
            <MenuItem Header="TOOLS">
                <MenuItem Header="Setting"/>
            </MenuItem>
        </Menu>
        <TextBox x:Name="current_path" Margin="60,50,10,0" Text="root" VerticalAlignment="Top" FontSize="14" IsReadOnly="True"/>
        <Button x:Name="go_up" IsEnabled="False" ToolTip="Go up" Margin="10,51,0,0" VerticalAlignment="Top" Click="GoUp_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/go-up.png" Width="16" Height="16" Stretch="UniformToFill"/>
        </Button>
        <ToolBarPanel Height="24" Margin="0,24,0,0" VerticalAlignment="Top" Orientation="Horizontal">
            <Button ToolTip="New archive" Margin="10,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="NewArchive_Click">
                <Image Source="Images/Appearance/new-archive.png" Stretch="UniformToFill"/>
            </Button>
            <Button ToolTip="Open" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="OpenProject_Click">
                <Image Source="Images/Appearance/open.png" Stretch="UniformToFill"/>
            </Button>
            <Button x:Name="save_project" ToolTip="Save project" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="SaveProject_Click">
                <Image Source="Images/Appearance/save.png" Stretch="UniformToFill"/>
            </Button>
            <Rectangle Margin="5,1,5,1" Width="1" Stroke="#FF4B9B9B"/>
            <Button x:Name="compress" ToolTip="Compress" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Click="Compress_Click">
                <Image Source="Images/Appearance/compress.png" Stretch="UniformToFill"/>
            </Button>
            <Rectangle Margin="5,1,5,1" Width="1" Stroke="#FF4B9B9B"/>
            <Button x:Name="add_files" ToolTip="Add files" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Margin="2,0,2,0" Click="AddFiles_Click">
                <Image Source="Images/Appearance/add-files.png" Stretch="UniformToFill"/>
            </Button>
            <Button x:Name="add_directory" ToolTip="Add directory" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Margin="2,0,2,0" Click="AddDirectory_Click">
                <Image Source="Images/Appearance/add-folder.png" Stretch="UniformToFill"/>
            </Button>
            <Button x:Name="remove_selected" Margin="2,0,2,0" ToolTip="Remove selected files" VerticalAlignment="Top" Background="{x:Null}" Click="RemoveSelectedItem_Click">
                <Image Source="Images/Appearance/list-remove.png" Stretch="UniformToFill"/>
            </Button>
            <Button x:Name="clear_list" ToolTip="Clear list" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="ClearList_Click">
                <Image Source="Images/Appearance/list-clear.png" Stretch="UniformToFill"/>
            </Button>
            <ProgressBar x:Name="process_bar" Margin="2,0,2,0" Width="365" IsIndeterminate="True" Visibility="Hidden"/>
        </ToolBarPanel>
        <Button x:Name="go_home" IsEnabled="False" ToolTip="Go to home" Margin="35,51,0,0" VerticalAlignment="Top" Click="GoHome_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/go-home.png" Width="16" Height="16" Stretch="UniformToFill"/>
        </Button>
    </Grid>
</Window>
