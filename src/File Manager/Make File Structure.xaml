<Window x:Class="File_Manager.Make_File_Structure"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make_File_Structure" Height="480" Width="800">
    <Grid>
        <ListBox x:Name="list" HorizontalAlignment="Left" Margin="10,36,0,10" Width="238" SelectionChanged="list_SelectionChanged"/>
        <TextBox x:Name="path" HorizontalAlignment="Left" Margin="10,10,0,0" Text="C:\Users\pal\Documents\File" VerticalAlignment="Top" Width="238" FontSize="14"/>
        <Button Content="Read Files" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
        <Image x:Name="i256" HorizontalAlignment="Right" Height="256" Margin="0,35,10,0" VerticalAlignment="Top" Width="256" Source="Images/Icons/256/archive-cab.png"/>
        <Image x:Name="i64" HorizontalAlignment="Right" Height="64" Margin="0,276,475,0" VerticalAlignment="Top" Width="64" Source="Images/Icons/64/archive-deb.png"/>
        <Image x:Name="i24" HorizontalAlignment="Right" Height="24" Margin="0,316,446,0" VerticalAlignment="Top" Width="24" Source="Images/Icons/24/archive-ace.png"/>
        <TextBlock HorizontalAlignment="Left" Margin="253,36,0,0" TextWrapping="Wrap" Text="Extention:" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="253,62,0,0" TextWrapping="Wrap" Text="Description:" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="253,88,0,0" TextWrapping="Wrap" Text="Category:" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="253,114,0,0" TextWrapping="Wrap" Text="Has Subtext:" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="253,140,0,0" TextWrapping="Wrap" Text="Subtext:" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="253,166,0,0" TextWrapping="Wrap" Text="May Danger" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock x:Name="ext" HorizontalAlignment="Left" Margin="354,36,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock x:Name="des"  HorizontalAlignment="Left" Margin="354,62,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock x:Name="cat"  HorizontalAlignment="Left" Margin="354,88,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock x:Name="has_sub"  HorizontalAlignment="Left" Margin="354,114,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock x:Name="sub"  HorizontalAlignment="Left" Margin="354,140,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock x:Name="maydan"  HorizontalAlignment="Left" Margin="354,166,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock  HorizontalAlignment="Left" Margin="253,218,0,0" TextWrapping="Wrap" Text="HX Ids" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock  HorizontalAlignment="Left" Margin="253,192,0,0" TextWrapping="Wrap" Text="Offset" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock x:Name="hix"  HorizontalAlignment="Left" Margin="354,218,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock x:Name="offset"  HorizontalAlignment="Left" Margin="354,192,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16"/>
        <Button Content="Open File" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Click="Button_Click_2"/>
        <Button Content="Save File" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Click="Button_Click_1"/>
        <Image x:Name="i16" HorizontalAlignment="Right" Height="16" Margin="0,324,425,0" VerticalAlignment="Top" Width="16" Source="Images/Icons/64/archive-rpm.png"/>
        <TextBox x:Name="TargetFile" HorizontalAlignment="Left" Margin="253,0,0,10" Text="C:\Users\pal\Documents\File\FileInfo.dat" VerticalAlignment="Bottom" Width="369" FontSize="14"/>
    </Grid>
</Window>
