<Window x:Class="File_Explorer.My_MessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Item" Height="220" Width="500" ResizeMode="NoResize" FontSize="14" WindowStartupLocation="CenterScreen" Icon="Images/Appearance/delete-icon.png" ShowInTaskbar="False" SizeToContent="Height">
    <Grid x:Name="container">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="main" HorizontalAlignment="Left" Margin="70,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="RoyalBlue" FontSize="18"><Run Text="Do you really want to "/><Run Text="permanently delete this item?"/></TextBlock>
        <Button x:Name="no" Content="No" HorizontalAlignment="Right" Margin="0,0,10,11" Width="75" Background="{x:Null}" IsCancel="True" Click="No_Click" Grid.Row="1" Height="22" VerticalAlignment="Bottom"/>
        <Button x:Name="yes" Content="Yes" HorizontalAlignment="Right" Margin="0,0,90,10" Width="75" Background="Tomato" Foreground="White" IsDefault="True" Click="Yes_Click" FontSize="15" Grid.Row="1" Height="24" VerticalAlignment="Bottom"/>
        <Image x:Name="icons" HorizontalAlignment="Left" Height="48" Margin="10,10,0,0" VerticalAlignment="Top" Width="48" Source="Images/Appearance/delete.png"/>
        <TextBlock x:Name="name" HorizontalAlignment="Left" Margin="150,46,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="150,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Type: "/><Run x:Name="type"/></TextBlock>
        <TextBlock x:Name="size" HorizontalAlignment="Left" Margin="150,94,0,0" TextWrapping="Wrap" Text="Size: " VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="150,118,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Date Modified: "/><Run x:Name="date"/></TextBlock>
        <Image x:Name="Image" HorizontalAlignment="Left" Height="80" Margin="57,53,0,0" VerticalAlignment="Top" Width="80"/>
    </Grid>
</Window>
