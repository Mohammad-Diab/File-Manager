<Window x:Class="File_Manager.Big_File_Finder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big File Finder" Height="400" Width="450" MinWidth="400" SizeChanged="Window_SizeChanged" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TreeView x:Name="ItemsTree" Margin="0,42,-432,10" HorizontalAlignment="Right" Width="422"/>
        <Button ToolTip="Select a Directory" Margin="10,5,0,0" VerticalAlignment="Top" Click="findBigItems_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/folder-search.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="DeleteItems" ToolTip="Delete selected items" Margin="0,5,84,0" VerticalAlignment="Top" Click="DeleteItems_Click" IsEnabled="False" Background="{x:Null}" HorizontalAlignment="Right">
            <Image Source="Images/Appearance/delete.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="Select all items" Margin="0,5,121,0" VerticalAlignment="Top" Click="SelectAll_Click" Background="{x:Null}" HorizontalAlignment="Right" IsEnabled="False">
            <Image Source="Images/Appearance/select-all.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="Clear List" Margin="0,5,47,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" IsEnabled="False">
            <Image Source="Images/Appearance/list-clear.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="Setting" Margin="0,5,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}">
            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <ListView x:Name="item_list" Margin="10,66,10,10" ItemsSource="{Binding}" MouseDoubleClick="item_list_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="125">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <!--Background="{Binding Path=Background}"-->
                                    <TextBlock Margin="25,0,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left"/>
                                    <Image Margin="0" Source="{Binding Path=Image}" Height="18" Width="18" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Path=FileType}"/>
                    <GridViewColumn Header="Size" Width="60" DisplayMemberBinding="{Binding Path=FileSize}"/>
                    <GridViewColumn Header="Percent" Width="60" DisplayMemberBinding="{Binding Path=Percent}"/>
                    <GridViewColumn Header="Size / All" Width="60" DisplayMemberBinding="{Binding Path=SizeFromAll}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBox x:Name="current_path" Margin="35,42,10,0" Text="Path" VerticalAlignment="Top" FontSize="14" PreviewKeyUp="current_path_PreviewKeyUp"/>
        <Button ToolTip="Select a Directory" Margin="10,42,0,0" VerticalAlignment="Top" Click="GoUp_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/go-up.png" Width="16" Height="16" Stretch="UniformToFill"/>
        </Button>
        <ProgressBar x:Name="progressbar" Height="21" Margin="35,42,10,0" VerticalAlignment="Top" Maximum="5100"/>
    </Grid>
</Window>
