<Window x:Class="File_Manager.File_Compresser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compressed Files Manager" Height="460" Width="720" MinHeight="300" MinWidth="560" Closing="Window_Closing" Icon="Images/Tools Icon/Window/CompressedFilesManager.ico" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="main_grid">
        <ListView x:Name="list" Margin="10,80,10,10" ItemsSource="{Binding}" AllowDrop="True" Drop="FilesList_Drop" DragOver="FilesList_DragOver" SelectionChanged="List_SelectionChanged">
            <ListView.Resources>
                <Style TargetType="{x:Type ListViewItem}">
                    <EventSetter Event='MouseDoubleClick' Handler='Item_DoubleClick'/>
                    <Setter Property="ToolTip" Value="{Binding Path=ItemToolTip}"/>
                    <!--<EventSetter Event='ContextMenuOpening'  Handler='Item_ContextMenuOpening'/>-->
                </Style>
            </ListView.Resources>
            <ListView.ContextMenu>
                <ContextMenu FontSize="14">
                    <MenuItem x:Name="context_open" Header="Open" InputGestureText="Enter" Click="OpenItem_Click"/>
                    <MenuItem x:Name="context_extract" Header="Extract..." InputGestureText="Ctrl+E" Click="ExtractSelected_Click"/>
                    <Separator/>
                    <MenuItem x:Name="context_rename" Header="Rename" InputGestureText="F2" Click="Rename_Click"/>
                    <MenuItem x:Name="context_remove" Header="Remove" InputGestureText="Del" Click="RemoveSelectedItem_Click"/>
                    <Separator/>
                    <MenuItem x:Name="context_properties" Header="Properties" InputGestureText="Alt+Enter" Click="Properties_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock Margin="31,2,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left" FontSize="14"/>
                                    <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding Path=FileType}"/>
                    <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Path=FileSize}"/>
                    <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding Path=Modified}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Menu VerticalAlignment="Top" FontSize="14">
            <MenuItem Header="ARCHIVE">
                <MenuItem x:Name="new_menu" Header="New project" InputGestureText="Ctrl+N" Click="NewArchive_Click"/>
                <MenuItem x:Name="open_archive_menu" Header="Open archive..." InputGestureText="Ctrl+O" Click="OpenArchive_Click"/>
                <MenuItem x:Name="open_project_menu" Header="Open archive project..." InputGestureText="Ctrl+Shift+O" Click="OpenProject_Click"/>
                <Separator/>
                <MenuItem x:Name="save_menu" Header="Save project" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                <MenuItem x:Name="save_as_menu" Header="Save project as..." InputGestureText="Ctrl+Shift+S" Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem x:Name="compress_menu" Header="Compress..." Click="CompressProject_Click"/>
                <MenuItem x:Name="extract_menu" Header="Extract selected..." InputGestureText="Ctrl+E" Click="ExtractSelected_Click"/>
                <MenuItem x:Name="extract_all_menu" Header="Extract all..." Click="ExtractAll_Click"/>
                <Separator/>
                <MenuItem x:Name="close_archive" Header="Close archive" Click="CloseArchive_Click"/>
                <Separator/>
                <MenuItem Header="Close" InputGestureText="Alt+F4" Click="Close_Click"/>
            </MenuItem>
            <MenuItem Header="FILES" x:Name="files_menu">
                <MenuItem x:Name="add_files_menu" Header="Add files..." Click="AddFiles_Click"/>
                <MenuItem x:Name="add_folder_menu" Header="Add folder..." Click="AddDirectory_Click"/>
                <Separator/>
                <MenuItem x:Name="rename_menu" Header="Rename" InputGestureText="F2" Click="Rename_Click"/>
                <MenuItem x:Name="remove_menu" Header="Remove selected items" InputGestureText="Del" Click="RemoveSelectedItem_Click"/>
                <Separator/>
                <MenuItem x:Name="select_all_menu" Header="Select all" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                <MenuItem x:Name="clear_menu" Header="Clear list" Click="ClearList_Click"/>
            </MenuItem>
            <MenuItem Header="TOOLS">
                <MenuItem x:Name="test_menu" Header="Test archive" InputGestureText="Ctrl+T" Click="Test_Click"/>
                <MenuItem x:Name="properties_menu" Header="Properties" InputGestureText="Alt+Enter" Click="Properties_Click"/>
                <Separator/>
                <MenuItem x:Name="search_menu" Header="Search" InputGestureText="Ctrl+F" Click="SearchMenu_Click"/>
                <MenuItem x:Name="refresh_menu" Header="Refresh" InputGestureText="F5" Click="Refresh_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>
        <TextBox x:Name="current_path" Margin="60,50,220,0" Text="root" VerticalAlignment="Top" FontSize="14" KeyDown="CurrentPath_KeyDown" LostKeyboardFocus="CurrentPath_LostKeyboardFocus" ToolTip="Type a path inside the list and press Enter"/>
        <Button x:Name="go_up" Tag="Go up (Backspace)" Margin="10,50,0,0" VerticalAlignment="Top" Width="{Binding ActualHeight, ElementName=current_path}" Height="{Binding ActualHeight, ElementName=current_path}" Click="GoUp_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/go-up.png" Width="16" Height="16" Stretch="UniformToFill"/>
        </Button>
        <ToolBarPanel Height="24" Margin="0,24,10,0" VerticalAlignment="Top" Orientation="Horizontal">
            <Button x:Name="new_project" Tag="New project (Ctrl+N)" Margin="10,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="NewArchive_Click">
                <Image Source="Images/Appearance/new-archive.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="open_archive" Tag="Open archive (Ctrl+O)" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="OpenArchive_Click">
                <Image Source="Images/Menu/explore-archive.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="open_project" Tag="Open archive project (Ctrl+Shift+O)" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="OpenProject_Click">
                <Image Source="Images/Appearance/open.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="save_project" Tag="Save project (Ctrl+S)" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="SaveProject_Click">
                <Image Source="Images/Appearance/save.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Rectangle Margin="5,1,5,1" Width="1" Stroke="#FF4B9B9B"/>
            <Button x:Name="compress" Tag="Compress" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Click="Compress_Click">
                <Image x:Name="compress_image" Source="Images/Appearance/compress.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="test_archive" Tag="Test archive (Ctrl+T)" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Click="Test_Click">
                <Image Source="Images/Appearance/tick.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="properties_button" Tag="Properties (Alt+Enter)" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Click="Properties_Click">
                <Image Source="Images/Appearance/dialog-information.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Rectangle Margin="5,1,5,1" Width="1" Stroke="#FF4B9B9B"/>
            <Button x:Name="add_files" Tag="Add files" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Margin="2,0,2,0" Click="AddFiles_Click">
                <Image Source="Images/Appearance/add-files.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="add_directory" Tag="Add folder" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Margin="2,0,2,0" Click="AddDirectory_Click">
                <Image Source="Images/Appearance/add-folder.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="rename_button" Tag="Rename (F2)" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Margin="2,0,2,0" Click="Rename_Click">
                <Image Source="Images/Appearance/rename.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="remove_selected" Tag="Remove selected items (Del)" Margin="2,0,2,0" VerticalAlignment="Top" Background="{x:Null}" Click="RemoveSelectedItem_Click">
                <Image Source="Images/Appearance/list-remove.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="clear_list" Tag="Clear list" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="ClearList_Click">
                <Image Source="Images/Appearance/list-clear.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <Button x:Name="refresh_button" Tag="Refresh (F5)" Margin="2,0,2,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{x:Null}" Click="Refresh_Click">
                <Image Source="Images/Appearance/view-refresh.png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
            <ProgressBar x:Name="process_bar" Margin="8,2,2,2" Width="150" IsIndeterminate="True" Visibility="Hidden"/>
        </ToolBarPanel>
        <Button x:Name="go_home" Tag="Go to root (Alt+Home)" Margin="35,50,0,0" VerticalAlignment="Top" Width="{Binding ActualHeight, ElementName=current_path}" Height="{Binding ActualHeight, ElementName=current_path}" Click="GoHome_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/go-home.png" Width="16" Height="16" Stretch="UniformToFill"/>
        </Button>
        <Grid HorizontalAlignment="Right" Margin="0,50,10,0" VerticalAlignment="Top" Width="205">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="search" VerticalAlignment="Top" FontSize="14" KeyDown="Search_KeyDown" TextChanged="Search_TextChanged" ToolTip="Search names in the whole list (* and ? can be used), Enter to search, Esc to clear"/>
            <TextBlock x:Name="search_hint" Margin="5,2,0,0" VerticalAlignment="Top" FontSize="14" Text="Search" Foreground="Gray" IsHitTestVisible="False"/>
            <Button x:Name="search_button" Grid.Column="1" Tag="Search (Ctrl+F)" Width="{Binding ActualHeight, ElementName=search}" Height="{Binding ActualHeight, ElementName=search}" Margin="-1,0,0,0" VerticalAlignment="Top" Background="{x:Null}" Click="SearchButton_Click" BorderBrush="#FFABADB3">
                <Image Stretch="Uniform" Margin="2" Source="Images/Appearance/view-search.png"/>
            </Button>
        </Grid>

    </Grid>
</Window>
