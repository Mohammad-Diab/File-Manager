<Window x:Class="File_Manager.New_Shortcut"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut Creator" Height="270" Width="500" FontSize="14" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Grid>
        <Grid x:Name="mother" Margin="0,0,0,0">
            <Grid Width="495" HorizontalAlignment="Left">
                <TextBox x:Name="s_path" Margin="125,93,41,0" VerticalAlignment="Top"/>
                <TextBox x:Name="s_name" Margin="125,128,10,0" VerticalAlignment="Top"/>
                <TextBox x:Name="o_path" Margin="125,58,41,0" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,130,0,0" TextWrapping="Wrap" Text="Shortcut name" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,95,0,0" TextWrapping="Wrap" Text="Shortcut path" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,60,0,0"  TextWrapping="Wrap" Text="Original path" VerticalAlignment="Top"/>
                <Button Content="B" HorizontalAlignment="Right" Margin="0,91,10,0" VerticalAlignment="Top" Width="31" Click="SelectLinkDestination_Click" Background="{x:Null}"/>
                <Button Content="B" HorizontalAlignment="Right" Margin="0,56,10,0" VerticalAlignment="Top" Width="31" Click="SelectOrginalItem_Click" Background="{x:Null}"/>
                <Button Content="Create" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Click="CreateShortcut_Click" Background="{x:Null}"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,200,0,0" TextWrapping="Wrap" Text="Icon" VerticalAlignment="Top"/>
                <TextBox x:Name="desc" Margin="125,163,10,0" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,165,0,0" TextWrapping="Wrap" Text="Description" VerticalAlignment="Top"/>
            </Grid>
            <Grid Margin="500,0,0,0" Width="495" HorizontalAlignment="Left">
                <TextBox x:Name="j_path" Margin="125,98,41,0" VerticalAlignment="Top"/>
                <TextBox x:Name="d_path" Margin="125,58,41,0" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,100,0,0" TextWrapping="Wrap" Text="Junction Targe" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,60,0,0"  TextWrapping="Wrap" Text="Source path" VerticalAlignment="Top"/>
                <Button Content="B" HorizontalAlignment="Right" Margin="0,97,10,0" VerticalAlignment="Top" Width="31" Click="SelectJunctionTarget_Click" Background="{x:Null}"/>
                <Button Content="B" HorizontalAlignment="Right" Margin="0,57,10,0" VerticalAlignment="Top" Width="31" Click="SelectSourceDirectory_Click" Background="{x:Null}"/>
                <Button Content="Create" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Click="CreateJunction_Click" Background="{x:Null}"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,178,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF6DAB21" FontSize="20" Text="      Target must be an empty directory."/>
                <Image Source="Images/Appearance/dialog-information.png" Margin="10,179,0,0" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Width="25"/>
                <CheckBox x:Name="create_direcory" Content="Create directory if it is not exist." HorizontalAlignment="Left" Margin="125,130,0,0" VerticalAlignment="Top" IsChecked="True"/>
            </Grid>
        </Grid>
        <StackPanel Height="45" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="NEW SHORTCUT" FontSize="24" Background="White" MouseUp="Label1_MouseUp" Cursor="Hand"/>
            <Label x:Name="label2" Content="NEW JUNCTION" FontSize="24" Foreground="White" Background="Black" MouseUp="label2_MouseUp" Cursor="Hand"/>
        </StackPanel>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,41,0,0" VerticalAlignment="Top" Width="186"/>
    </Grid>
</Window>
