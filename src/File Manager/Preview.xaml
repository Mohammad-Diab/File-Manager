                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="White" Offset="1"/>
                            <GradientStop Color="#FF85EC4A"/>
                            <GradientStop Color="#FFA7F17C" Offset="0.369"/>
                            <GradientStop Color="#FFB4F38F" Offset="0.514"/>
                            <GradientStop Color="#FFE7FBDC" Offset="0.855"/>
                            <GradientStop Color="#FFD2F7BC" Offset="0.735"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
            <Grid Margin="2400,44,0,0" HorizontalAlignment="Left" Width="800">
                <Button x:Name="apply_to_all_Copy" Content="Calculate" Margin="10,390,630,0" Background="{x:Null}" Foreground="#FF2AB048" FontSize="16" BorderBrush="#FF2AB048" Visibility="Visible" Height="32" VerticalAlignment="Top"/>
                <TextBox Margin="86,49,10,0" TextWrapping="Wrap" Text="MD5" VerticalAlignment="Top" FontSize="24"/>
                <TextBox Margin="86,10,10,0" TextWrapping="Wrap" Text="MD4" VerticalAlignment="Top" FontSize="24"/>
                <TextBox Margin="86,147,10,0" TextWrapping="Wrap" Text="SHA1" VerticalAlignment="Top" FontSize="24"/>
                <TextBox Margin="86,88,10,0" TextWrapping="Wrap" Text="MD6" VerticalAlignment="Top" FontSize="24"/>
                <TextBox Margin="86,225,10,0" TextWrapping="Wrap" Text="SHA1 384" VerticalAlignment="Top" FontSize="24"/>
                <TextBox Margin="86,264,10,0" TextWrapping="Wrap" Text="SHA1 512" VerticalAlignment="Top" FontSize="24"/>
                <TextBox Margin="86,323,10,0" TextWrapping="Wrap" Text="CRC32" VerticalAlignment="Top" FontSize="24"/>
                <TextBox Margin="86,186,10,0" TextWrapping="Wrap" Text="SHA1 256" VerticalAlignment="Top" FontSize="24"/>
            </Grid>
            <Grid Margin="3200,44,0,0" HorizontalAlignment="Left" Width="800"/>
            <Grid Margin="4000,44,0,0" HorizontalAlignment="Left" Width="800">
                <Button x:Name="save_spitial_info" Content="Save" Margin="0,0,20,10" Background="{x:Null}" Foreground="#FF0F0A0A" FontSize="16" BorderBrush="#FF2AB048" Visibility="Visible" Height="32" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="100"/>
                <StackPanel Margin="10,10,20,47"/>
            </Grid>
        </Grid>
        <StackPanel x:Name="tab_control" Height="44" VerticalAlignment="Top" Orientation="Horizontal">
            <StackPanel.Background>
                <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                    <GradientStop Color="#FFE1E1E1" Offset="0"/>
                    <GradientStop Color="#FFF0F0F0" Offset="1"/>
                    <GradientStop Color="#FFE6E6E6" Offset="0.478"/>
                </LinearGradientBrush>
            </StackPanel.Background>
            <Label x:Name="preview_tab" Margin="0,0,10,0" FontSize="22" Content="File Preview" Foreground="#FF404040" Cursor="Hand" MouseEnter="TabItem_MouseEnter" MouseLeave="TabItem_MouseLeave" MouseLeftButtonUp="TabItem_MouseLeftButtonUp" Background="White"/>
            <Label x:Name="information_tab" Margin="0,0,10,0" FontSize="22" Content="Information" Foreground="#FF404040" Cursor="Hand" MouseEnter="TabItem_MouseEnter" MouseLeave="TabItem_MouseLeave" MouseLeftButtonUp="TabItem_MouseLeftButtonUp"/>
            <Label x:Name="attribute_tab" Margin="0,0,10,0" FontSize="22" Content="Attribute" Foreground="#FF404040" Cursor="Hand" MouseEnter="TabItem_MouseEnter" MouseLeave="TabItem_MouseLeave" MouseLeftButtonUp="TabItem_MouseLeftButtonUp"/>
            <Label x:Name="hash_tab" Margin="0,0,10,0" FontSize="22" Content="Hash Calculator " Foreground="#FF404040" Cursor="Hand" MouseEnter="TabItem_MouseEnter" MouseLeave="TabItem_MouseLeave" MouseLeftButtonUp="TabItem_MouseLeftButtonUp"/>
            <Label x:Name="security_tab" Margin="0,0,10,0" FontSize="22" Content="Security " Foreground="#FF404040" Cursor="Hand" MouseEnter="TabItem_MouseEnter" MouseLeave="TabItem_MouseLeave" MouseLeftButtonUp="TabItem_MouseLeftButtonUp"/>
            <Label Visibility="Collapsed" x:Name="special_function" Margin="0,0,10,0" FontSize="22" Content="Audio Info" Foreground="#FF404040" Cursor="Hand" MouseEnter="TabItem_MouseEnter" MouseLeave="TabItem_MouseLeave" MouseLeftButtonUp="TabItem_MouseLeftButtonUp" Background="#7FDA8825"/>
        </StackPanel>
        <Grid HorizontalAlignment="Left" Width="5" MouseEnter="MainMenu_MouseEnter" Background="#FF41403B" Margin="0,0,0,0" Opacity="0"/>
        <Grid x:Name="main_menu" Width="64" HorizontalAlignment="Left" Background="#FF000000" Margin="-64,0,0,0" MouseLeave="MainMenu_MouseLeave">
            <StackPanel x:Name="main_menu_stack" Margin="0,20,0,0">
                <Button x:Name="open_button" Height="64" VerticalAlignment="Top" Margin="-64,15,64,0" Background="#FF333333" Template="{StaticResource roundButtonTemplate}" ToolTip="Open" Click="MainMenuOpen_Click">
                    <Image x:Name="open_button_image" Source="Images/Menu/open-file.png"/>
                </Button>
                <Button x:Name="open_with_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}" ToolTip="Open with" Click="MainMenuOpenWith_Click">
                    <Image x:Name="open_with_button_image" Source="Images/Menu/open-with.png"/>
                </Button>
                <Button x:Name="explore_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}">
                    <Image x:Name="explore_button_image" Source="Images/Menu/copy-stop.png"/>
                </Button>
                <Button x:Name="extract_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}">
                    <Image x:Name="extract_button_image" Source="Images/Menu/copy-stop.png"/>
                </Button>
                <Button x:Name="move_to_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}" ToolTip="Move to" Click="MainMenuMoveTo_Click">
                    <Image x:Name="move_to_button_image" Source="Images/Menu/file-move.png"/>
                </Button>
                <Button x:Name="copy_to_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}" ToolTip="Copy to" Click="MainMenuCopyTo_Click">
                    <Image x:Name="copy_to_button_image" Source="Images/Menu/file-copy.png"/>
                </Button>
                <Button x:Name="delete_button" Height="64" VerticalAlignment="Top" Margin="-64,0,64,0" Background="{x:Null}" Template="{StaticResource roundButtonTemplate}" ToolTip="Delete" Click="MainMenuDelete_Click">
                    <Image x:Name="delete_button_image" Source="Images/Menu/file-delete.png"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid x:Name="caution" Height="30" VerticalAlignment="Bottom" Visibility="Collapsed">
            <Rectangle Fill="Black" Height="30" Stroke="Black" VerticalAlignment="Bottom" Opacity="0.5"/>
            <Rectangle Height="29" VerticalAlignment="Bottom" Opacity="0.9" RenderTransformOrigin="0.5,0.5">
                <Rectangle.Stroke>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFB40100" Offset="0"/>
                        <GradientStop Color="#FFDC02FF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Stroke>
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                        <GradientStop Color="#FFB40100" Offset="1"/>
                        <GradientStop Color="#FFDC0200"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock x:Name="failed" Text="Caution: This file type maybe contain a virus or damage your computer" Foreground="WhiteSmoke" FontSize="16" TextAlignment="Center" HorizontalAlignment="Left" Width="800" Height="24" VerticalAlignment="Top" Margin="0,3,0,0" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
