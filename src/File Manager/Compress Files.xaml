<Window x:Class="File_Manager.Compress_Files"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compress Files" Height="250" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="Images/Appearance/compress.png" FontSize="14">
    <Grid>
        <Grid x:Name="main_grid" Width="994" Margin="0,0,0,0" HorizontalAlignment="Left">
            <Grid x:Name="main" Margin="0,0,0,0" HorizontalAlignment="Left" Width="490">
                <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Archive:" VerticalAlignment="Top"/>
                <TextBox x:Name="file_name" Margin="64,10,36,0" TextWrapping="Wrap" VerticalAlignment="Top" IsReadOnly="True"/>
                <Button Content="..." Margin="0,10,10,0" VerticalAlignment="Top" Height="21" HorizontalAlignment="Right" Width="21" Click="Browse_Click"/>
                <ComboBox x:Name="format" HorizontalAlignment="Left" Margin="120,37,0,0" VerticalAlignment="Top" Width="139" SelectionChanged="Format_SelectionChanged">
                    <ComboBoxItem Content="7z"/>
                    <ComboBoxItem Content="ace"/>
                    <ComboBoxItem Content="arc"/>
                    <ComboBoxItem Content="b1"/>
                    <ComboBoxItem Content="bzip"/>
                    <ComboBoxItem Content="cab"/>
                    <ComboBoxItem Content="gzip"/>
                    <ComboBoxItem Content="iso"/>
                    <ComboBoxItem Content="kgb"/>
                    <ComboBoxItem Content="mou"/>
                    <ComboBoxItem Content="rar"/>
                    <ComboBoxItem Content="rar5"/>
                    <ComboBoxItem Content="sit"/>
                    <ComboBoxItem Content="sitx"/>
                    <ComboBoxItem Content="tar"/>
                    <ComboBoxItem Content="uha"/>
                    <ComboBoxItem Content="wim"/>
                    <ComboBoxItem Content="xz"/>
                    <ComboBoxItem Content="zip"/>
                    <ComboBoxItem Content="zipx"/>
                </ComboBox>
                <TextBlock HorizontalAlignment="Left" Margin="10,39,0,0" TextWrapping="Wrap" Text="Format" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,71,0,0" TextWrapping="Wrap" Text="Compress level" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,101,0,0" TextWrapping="Wrap" Text="Solid block size" VerticalAlignment="Top"/>
                <CheckBox x:Name="sfx" Content="SFX archive" HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top" Checked="SFX_Checked" Unchecked="SFX_Unchecked"/>
                <ComboBox x:Name="level" HorizontalAlignment="Left" Margin="120,69,0,0" VerticalAlignment="Top" Width="139">
                    <ComboBoxItem Content="Just store"/>
                    <ComboBoxItem Content="Low"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="High"/>
                    <ComboBoxItem Content="Ultra"/>
                </ComboBox>
                <ComboBox x:Name="solid_block" HorizontalAlignment="Left" Margin="120,99,0,0" VerticalAlignment="Top" Width="139">
                    <ComboBoxItem Content="Non-Solid"/>
                    <ComboBoxItem Content="1 MB"/>
                    <ComboBoxItem Content="2 MB"/>
                    <ComboBoxItem Content="4 MB"/>
                    <ComboBoxItem Content="8 MB"/>
                    <ComboBoxItem Content="16 MB"/>
                    <ComboBoxItem Content="32 MB"/>
                    <ComboBoxItem Content="64 MB"/>
                    <ComboBoxItem Content="128 MB"/>
                    <ComboBoxItem Content="256 MB"/>
                    <ComboBoxItem Content="512 MB"/>
                    <ComboBoxItem Content="1 GB"/>
                    <ComboBoxItem Content="2 GB"/>
                    <ComboBoxItem Content="4 GB"/>
                    <ComboBoxItem Content="8 GB"/>
                    <ComboBoxItem Content="16 GB"/>
                    <ComboBoxItem Content="32 GB"/>
                    <ComboBoxItem Content="64 GB"/>
                    <ComboBoxItem Content="Solid"/>
                </ComboBox>
                <GroupBox Header="Password" HorizontalAlignment="Right" Margin="0,36,10,0" Width="175" Height="140" VerticalAlignment="Top">
                    <Grid>
                        <PasswordBox x:Name="password" Margin="5,5,10,0" VerticalAlignment="Top"/>
                        <TextBox x:Name="password_textbox" Margin="4,4,10,0" VerticalAlignment="Top" Visibility="Hidden"/>
                        <PasswordBox x:Name="password_retry" Margin="5,31,10,0" VerticalAlignment="Top"/>
                        <CheckBox x:Name="show_password" Content="Show password" HorizontalAlignment="Left" Margin="5,57,0,0" VerticalAlignment="Top" Checked="ShowPassword_Checked" Unchecked="ShowPassword_Unchecked"/>
                        <CheckBox x:Name="encrypt_file_name" Content="Encrypt file names" HorizontalAlignment="Left" Margin="5,80,0,0" VerticalAlignment="Top"/>
                    </Grid>
                </GroupBox>
                <Button Content="Compress" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Foreground="RoyalBlue" Click="Copress_Click" BorderBrush="RoyalBlue"/>
                <Button Content="Close" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Click="Close_Click"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,131,0,0" TextWrapping="Wrap" Text="Priority" VerticalAlignment="Top"/>
                <ComboBox x:Name="priority" HorizontalAlignment="Left" Margin="120,129,0,0" VerticalAlignment="Top" Width="139">
                    <ComboBoxItem Content="Low"/>
                    <ComboBoxItem Content="Normal"/>
                    <ComboBoxItem Content="High"/>
                </ComboBox>
            </Grid>
            <Grid Margin="500,0,0,0" HorizontalAlignment="Left" Width="495" Background="#FF334D5C">
                <Grid x:Name="eg" Margin="51,135,51,0" Height="5" VerticalAlignment="Top">
                    <Rectangle Fill="#FFFF96FF" HorizontalAlignment="Left" Height="5" VerticalAlignment="Top" Width="5" Margin="-10,0,0,0"/>
                    <Rectangle Fill="#FFFFCF96" HorizontalAlignment="Left" Height="5" VerticalAlignment="Top" Width="5" Margin="-10,0,0,0"/>
                    <Rectangle Fill="#FF96D4FF" HorizontalAlignment="Left" Height="5" VerticalAlignment="Top" Width="5" Margin="-10,0,0,0"/>
                    <Rectangle Fill="#FF96FF96" HorizontalAlignment="Left" Height="5" VerticalAlignment="Top" Width="5" Margin="-10,0,0,0"/>
                    <Rectangle Fill="#FFE9FF00" HorizontalAlignment="Left" Height="5" VerticalAlignment="Top" Width="5" Margin="-10,0,0,0"/>
                </Grid>
                <TextBlock Margin="95,20,10,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="White"><Run Text="Compressing has started in that boring black window (Command Prompt)."/><LineBreak/><Run Text="keep your eyes on it may you have to answer some questions."/></TextBlock>
                <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,0,20,30" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" BorderBrush="Red" Foreground="Red" Click="Cancel_Click"/>
                <TextBlock Margin="10,0,0,10" TextWrapping="Wrap" Text="To cancel compressing press &quot;Ctrl&quot; + &quot;C&quot; in &quot;Command Prompt&quot; or click on &quot;Cancel&quot; button " VerticalAlignment="Bottom" FontSize="11" HorizontalAlignment="Left" Foreground="White"/>
                <TextBlock Margin="170,86,0,0" TextWrapping="Wrap" Text="Compressing..." VerticalAlignment="Top" Foreground="#FFAEE5FF" FontSize="24" HorizontalAlignment="Left"/>
                <Image HorizontalAlignment="Left" Height="75" Margin="10,20,0,0" VerticalAlignment="Top" Width="75" Source="Images/Appearance/compressing-icon.png"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
