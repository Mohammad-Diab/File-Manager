<Window x:Class="File_Manager.Create_Virtual_Hard_Disk"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Virtual Hard Disk" Height="420" Width="400" FontSize="14">

    <Grid>
        <ScrollViewer Margin="0,0,0,40" BorderBrush="#FF7498BF">
            <Grid>
                <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Margin="52,10,0,0" Text="Virtual hard disk options" VerticalAlignment="Top" FontSize="28" TextDecorations="Underline" Foreground="#FF737575"/>
                <TextBlock HorizontalAlignment="Left" Margin="20,70,0,0" TextWrapping="Wrap" Text="File location" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="20,215,0,0" TextWrapping="Wrap" Text="Format" VerticalAlignment="Top"/>
                <RadioButton x:Name="dynamic_expand" Content="Dynamicly expanding" HorizontalAlignment="Left" Margin="40,240,0,0" VerticalAlignment="Top" BorderBrush="#FF737575"/>
                <RadioButton HorizontalAlignment="Left" Margin="40,355,0,0" VerticalAlignment="Top" BorderBrush="#FF737575" IsChecked="True">
                    <TextBlock><Run Text="Fixed Size ("/><Run Foreground="Green" Text="Recommended"/><Run Text=")"/></TextBlock>
                </RadioButton>
                <RadioButton Content="Fixed Size (Fast Creation)" HorizontalAlignment="Left" Margin="40,490,0,0" VerticalAlignment="Top" BorderBrush="#FF737575" IsEnabled="False"/>
                <TextBox x:Name="disk_location" Height="23" Margin="40,95,32,0" VerticalAlignment="Top" BorderBrush="#FF737575"/>
                <Button Content="B" HorizontalAlignment="Right" Margin="0,95,10,0" VerticalAlignment="Top" Width="23" Background="{x:Null}" BorderBrush="#FF737575" Height="23" Click="BrowseButton_Click"/>
                <TextBlock x:Name="textBlock3" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Disk size" VerticalAlignment="Top" Margin="20,140,0,0"/>
                <Slider x:Name="disk_size" ToolTip="Disk Size" Margin="40,170,20,0" VerticalAlignment="Top" TickPlacement="TopLeft" SmallChange="16" TickFrequency="128" LargeChange="128" Maximum="4096" Value="20" Minimum="4" Foreground="#FF737575" ValueChanged="DiskSize_ValueChanged"/>
                <TextBox x:Name="disk_size_text" Margin="132,137,143,0" Text="20" VerticalAlignment="Top" BorderBrush="#FF737575" TextChanged="DiskSizeText_TextChanged"/>
                <Image HorizontalAlignment="Left" Height="37" Margin="10,10,0,0" VerticalAlignment="Top" Width="37" Stretch="Fill" Source="Images/Icons/virtual-hard-drive.png"/>
                <TextBlock Margin="60,265,10,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="The size of this virtual hard disk "/><Run Foreground="Green" Text="expands"/><Run Text=" to a fixed maximum size as data is saved to it."/><LineBreak/><Run Text="The disk size "/><Run Foreground="Red" Text="does not compact " TextDecorations="Underline"/><Run Text="automatically when data is deleted."/></TextBlock>
                <TextBlock Margin="60,379,10,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="The virtual hard disk uses a "/><Run Foreground="Green" Text="fixed amount of space"/><Run Text=" regardless of the amount of the data stored on it. Its default size is the maximum amount of space available on your physical hard disk."/></TextBlock>
                <TextBlock Margin="60,514,10,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Foreground="Green" Text="Same as fixed"/><Run Text=", but significant "/><Run Foreground="Green" Text="faster creation"/><Run Text="."/><LineBreak/><Run Text="Harddisk space required by VHD will "/><Run Foreground="Red" Text="not be initialized" TextDecorations="Underline"/><Run Text="."/></TextBlock>
                <ComboBox x:Name="size_unit" HorizontalAlignment="Right" SelectedIndex="1" Margin="0,137,88,0" VerticalAlignment="Top" Width="50" Height="25" Background="{x:Null}">
                    <ComboBoxItem Content="MB"/>
                    <ComboBoxItem Content="GB"/>
                </ComboBox>
            </Grid>
        </ScrollViewer>
        <Button Content="CREATE" HorizontalAlignment="Right" Margin="0,0,10,5" VerticalAlignment="Bottom" Background="{x:Null}" Width="110" Height="30" BorderBrush="#FF63839A" Foreground="#FF63839A" Click="CreateButton_Click"/>
        <Button Content="Attach VHD" HorizontalAlignment="Left" Margin="10,0,0,7" VerticalAlignment="Bottom" Width="100" Background="{x:Null}" BorderBrush="#FF737575" Click="AttachVHD_Click"/>
        <Button Content="Detach VHD" HorizontalAlignment="Left" Margin="115,0,0,7" VerticalAlignment="Bottom" Width="100" Background="{x:Null}" Foreground="Black" BorderBrush="#FF737575" Click="DetachVHD_Click"/>
    </Grid>
</Window>
