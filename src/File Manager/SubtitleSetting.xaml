                        </LinearGradientBrush>
                    </TextBox.Background>-->
                </TextBox>
                <CheckBox x:Name="Bold" Content="Bold" Margin="0,0,20,52" VerticalAlignment="Bottom" FlowDirection="LeftToRight" HorizontalAlignment="Right"  FontSize="14" Foreground="#FF195310" BorderBrush="#FF6E4702" FontWeight="Bold" Unchecked="Bold_Unchecked" Checked="Bold_Checked"/>
                <CheckBox x:Name="Italic" Content="Italic" HorizontalAlignment="Right" Margin="0,0,90,52" VerticalAlignment="Bottom" FlowDirection="LeftToRight"  FontSize="14" Foreground="#FF195310" BorderBrush="#FF6C4500" FontStyle="Italic" Unchecked="Italic_Unchecked" Checked="Italic_Checked"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,165,0,0" Text="Font" VerticalAlignment="Top" FontSize="18" Foreground="#FF195310"/>
                <TextBlock x:Name="font_filter_mask" HorizontalAlignment="Right" Margin="0,167,180,0" VerticalAlignment="Top" Width="135" Text="fonts filter" FontStyle="Italic" Foreground="#FF646464"/>
                <TextBox x:Name="font_filter" HorizontalAlignment="Right" Height="23" Margin="0,165,180,0" VerticalAlignment="Top" Width="140" Background="{x:Null}" GotFocus="FilterMask_GotFocus" LostFocus="FilterMask_LostFocus" TextChanged="FontFilter_TextChanged"/>
                <TextBlock x:Name="fcolor_filter_mask" HorizontalAlignment="Right" Margin="0,167,20,0" VerticalAlignment="Top" Width="85" Text="colors filter" FontStyle="Italic" Foreground="#FF646464"/>
                <TextBox x:Name="fcolor_filter" HorizontalAlignment="Right" Height="23" Margin="0,165,20,0" VerticalAlignment="Top" Width="90" Background="#00000000" GotFocus="FilterMask_GotFocus" LostFocus="FilterMask_LostFocus" TextChanged="FColorFilter_TextChanged"/>
                <Button ToolTip="Text background = White" HorizontalAlignment="Right" Margin="0,70,20,0" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Click="SetBackgroundWhite_Click">
                    <Button.Content>
                        <Ellipse HorizontalAlignment="Left" Fill="WhiteSmoke" Height="24" Width="24" Stroke="#CC505050" VerticalAlignment="Top"/>
                    </Button.Content>
                </Button>
                <Button ToolTip="Text background = Black" HorizontalAlignment="Right" Margin="0,114,20,0" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Click="SetBackgroundBlack_Click">
                    <Ellipse HorizontalAlignment="Left" Fill="#CC000000" Height="24" Width="24" Stroke="#FF505050" VerticalAlignment="Top"/>
                </Button>
            </Grid>
            <Grid Margin="500,0,0,0" Width="495" HorizontalAlignment="Left">
                <ScrollViewer Margin="0,40,10,41" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock HorizontalAlignment="Left" Margin="20,48,0,0" TextWrapping="Wrap" FontSize="18" Text="Synchronize" VerticalAlignment="Top" Foreground="#FF195310"/>
                        <ComboBox x:Name="sync_multiple" HorizontalAlignment="Right" Margin="0,79,64,0" VerticalAlignment="Top" Width="70" FontSize="12" SelectedIndex="0" Background="{x:Null}" BorderBrush="#FF6C4500" SelectionChanged="SyncMultiple_SelectionChanged">
                            <ComboBoxItem Content="second"/>
                            <ComboBoxItem Content="minite"/>
                        </ComboBox>
                        <TextBlock HorizontalAlignment="Left" FontSize="18" Margin="20,297,0,0" Text="Subtitle encode" VerticalAlignment="Top" Foreground="#FF195310"/>
                        <TextBlock HorizontalAlignment="Left" Margin="20,143,0,0" FontSize="18" Text="Position" VerticalAlignment="Top" Foreground="#FF195310"/>
                        <TextBlock HorizontalAlignment="Left" Margin="30,173,0,0" Text="left" VerticalAlignment="Top"/>
                        <TextBlock HorizontalAlignment="Left" Margin="30,228,0,0" Text="bottom" VerticalAlignment="Top"/>
                        <TextBox x:Name="bottom_textbox" Margin="200,226,74,0" TextWrapping="Wrap" Text="30" VerticalAlignment="Top" BorderBrush="#FF6C4500"/>
                        <TextBox x:Name="left_textbox" Margin="200,172,74,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" BorderBrush="#FF6C4500"/>
                        <TextBlock x:Name="syncvalue_textblock" FontSize="12" HorizontalAlignment="Left" Text="0 second" Margin="40,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF6C4500"/>
                        <TextBlock HorizontalAlignment="Left" Margin="10,8,0,0" TextWrapping="Wrap" Text="Subtitle Options" VerticalAlignment="Top" FontSize="24" Foreground="RoyalBlue"/>
                        <ComboBox x:Name="encode_comboBox" Margin="200,295,35,0" VerticalAlignment="Top" SelectedIndex="4" Background="{x:Null}" BorderBrush="#FF6C4500"/>
                        <Slider x:Name="sync_slider" Margin="30,78,162,0" VerticalAlignment="Top" Minimum="-60" Maximum="60" LargeChange="5" SmallChange="0.01" TickFrequency="5" TickPlacement="BottomRight" ValueChanged="SyncSlider_ValueChanged" Foreground="#FF6C4500"/>
                        <TextBlock x:Name="syncvalue_textblock_Copy" FontSize="12" HorizontalAlignment="Left" Text="minimum '10' pixels and maximum '200' pixels" Margin="40,198,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF6C4500"/>
                        <TextBlock x:Name="syncvalue_textblock_Copy1" FontSize="12" HorizontalAlignment="Left" Text="minimum '10' pixels and maximum '250' pixels" Margin="40,253,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF6C4500"/>
                        <TextBlock x:Name="textBlock" HorizontalAlignment="Right" Margin="0,173,35,0" TextWrapping="Wrap" Text="Pixels" VerticalAlignment="Top"/>
                        <TextBlock x:Name="textBlock_Copy" HorizontalAlignment="Right" Margin="0,227,35,0" TextWrapping="Wrap" Text="Pixels" VerticalAlignment="Top"/>
                        <Button ToolTip="Rest synchronize to zero" Content="zero" HorizontalAlignment="Right" Margin="0,78,35,0" VerticalAlignment="Top" Width="24" Background="{x:Null}" Click="SyncRest_Click"/>
                        <TextBlock HorizontalAlignment="Left" FontSize="18" Margin="20,341,0,0" Text="Text option" VerticalAlignment="Top" Foreground="#FF195310"/>

                        <ListBox x:Name="bg_colors_list" Margin="40,395,35,0" ItemsSource="{Binding}" BorderBrush="#FF6C4500" SelectionMode="Single" Height="120" VerticalAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse HorizontalAlignment="Left" Height="24" Width="24" Fill="{Binding Path=Color}" ToolTip="{Binding Path=ColorName}" Stroke="#CC505050" VerticalAlignment="Top"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock HorizontalAlignment="Left" Margin="30,371,0,0" Text="background color" VerticalAlignment="Top"/>
                        <TextBlock x:Name="bcolor_filter_mask" HorizontalAlignment="Right" Margin="0,371,35,0" VerticalAlignment="Top" Width="120" Text="colors filter" FontStyle="Italic" Foreground="#FF646464"/>
                        <TextBox x:Name="bcolor_filter" HorizontalAlignment="Right" Height="23" Margin="0,369,35,0" VerticalAlignment="Top" Width="125" Background="#00000000" GotFocus="FilterMask_GotFocus" LostFocus="FilterMask_LostFocus" TextChanged="BColorFilter_TextChanged"/>

                        <TextBlock HorizontalAlignment="Left" Margin="30,525,0,0" Text="background opacity" VerticalAlignment="Top"/>
                        <Slider x:Name="background_opacity_slider" Margin="40,549,75,0" VerticalAlignment="Top" Minimum="0" Maximum="100" LargeChange="10" SmallChange="1" TickFrequency="5" TickPlacement="BottomRight" ValueChanged="BackgroundOpacitySlider_ValueChanged" Foreground="#FF6C4500"/>
                        <TextBlock x:Name="background_opacity_text" HorizontalAlignment="Right" Margin="0,551,35,0" Text="0%" VerticalAlignment="Top"/>
                        <TextBlock HorizontalAlignment="Left" Margin="30,579,0,0" Text="text opacity" VerticalAlignment="Top"/>
                        <Slider x:Name="text_opacity_slider" Margin="40,603,75,0" VerticalAlignment="Top" Minimum="50" Maximum="100" LargeChange="5" SmallChange="1" TickFrequency="5" TickPlacement="BottomRight" ValueChanged="TextOpacitySlider_ValueChanged" Foreground="#FF6C4500"/>
                        <TextBlock x:Name="text_opacity_text" HorizontalAlignment="Right" Margin="0,605,35,0" Text="0%" VerticalAlignment="Top"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        <TextBlock Margin="10,0,250,10" MaxHeight="32" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" VerticalAlignment="Bottom" Foreground="Red" FontSize="12" Text="It will replace default font style in subtitle file."/>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,32,0,0" VerticalAlignment="Top" Width="107"/>
        <Button x:Name="_Save" Content="save" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Height="25" Click="Save_Setting" FontSize="16" BorderBrush="#FF6C4500" Foreground="#FF6C4500"/>
        <Button x:Name="_Cancel" Content="cancel" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Click="Cancel" Height="25" FontSize="16" BorderBrush="#FF6C4500"/>
        <Button x:Name="button" Content="Default" ToolTip="Get style from subtitle file (not working yet)" HorizontalAlignment="Right" Margin="0,0,170,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Height="25"/>
        <Button ToolTip="About Subtitle Setting" HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" Background="{x:Null}" BorderBrush="{x:Null}" Click="AboutTool_Click">
            <Button.Content>
                <Image Stretch="Fill" Source="Images/Menu/about-tool.png"/>
            </Button.Content>
        </Button>
    </Grid>
</Window>
