<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Custom="http://schemas.microsoft.com/winfx/2006/xaml/presentation/ribbon" x:Class="File_Manager.MainWindow"
        Title="File Manager" Width="810" Height="525" WindowStartupLocation="Manual" Loaded="Main_Window_Loaded" Icon="File_Manager.ico" PreviewKeyUp="Refresh">
    <Grid Background="#FFF0F0F0">
        <Grid Margin="0,26,0,0">
            <ListView x:Name="Explorer" TextBlock.TextAlignment="Right" PreviewMouseDoubleClick="Traversing" Margin="0,0,10,19">
                <!--<ListView.View>-->
                <!--<GridView x:Name="vvv">
                        <GridViewColumn TextBlock.TextAlignment="Left" Header="Name" Width="275"/>
                        <GridViewColumn Header="Size" Width="90"/>
                        <GridViewColumn Header="Type" Width="85"/>
                        <GridViewColumn Header="Data Modified" Width="125"/>
                    </GridView>-->
                <!--</ListView.View>-->
            </ListView>
            <Grid VerticalAlignment="Bottom">
                <TextBlock x:Name="statebar" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontSize="14" Margin="2,0,0,0"/>
            </Grid>
        </Grid>
        <Menu HorizontalAlignment="Left" VerticalAlignment="Top">
            <MenuItem Header="File Manager" FontSize="14" Height="25">
                <MenuItem Header="New Window" Click="New_Window"/>
                <MenuItem Header="New Window(Admin Propriety)" Click="New_Window_Admin"/>
                <Separator/>
                <MenuItem Header="Preferences"/>
                <MenuItem Header="about File Manager"  Click="MenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Quit"  Click="Quit"/>
            </MenuItem>
        </Menu>
        <TextBox x:Name="Address" Text="Computer" Background="{x:Null}" KeyUp="Traversing_KeyBoard" VerticalAlignment="Top" Margin="123,3,10,0"/>
        <Button Content="Up" Click="Go_UP" Margin="99,2,0,0" VerticalAlignment="Top" Background="{x:Null}" HorizontalAlignment="Left"/>
    </Grid>
</Window>
