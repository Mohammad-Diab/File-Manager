<Window x:Class="File_Manager.Identical_File_Remover"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dublicate files remover" Height="400" Width="615" Closing="Window_Closing" Icon="Images/Tools Icon/dublicate-files-remover.png">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal"/>
    </Window.TaskbarItemInfo>
    <Grid>
        <Button x:Name="delete" ToolTip="Delete selected items" Margin="0,5,84,0" VerticalAlignment="Top" Click="Delete_Click" IsEnabled="False" Background="{x:Null}" HorizontalAlignment="Right" Height="32" Width="32">
            <Image Source="Images/Appearance/delete.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="find_dublicate" ToolTip="Choose folders to search in" Margin="10,5,0,0" VerticalAlignment="Top" Click="FindDuplicate_Click" Background="{x:Null}" HorizontalAlignment="Left" Height="32" Width="32">
            <Image Source="Images/Appearance/folder-search.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="select_none" ToolTip="Select none" Margin="0,5,121,0" VerticalAlignment="Top" Click="SelectNone_Click" Background="{x:Null}" HorizontalAlignment="Right" IsEnabled="False" Height="32" Width="32">
            <Image Source="Images/Appearance/select-none.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="clear_list" ToolTip="Clear list" Margin="0,5,47,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" IsEnabled="False" Height="32" Width="32">
            <Image Source="Images/Appearance/list-clear.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="Setting" Margin="0,5,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Height="32" Width="32">
            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="Sort" Margin="0,5,195,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Click="SortBy_Click" IsEnabled="False">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="by Name"/>
                    <MenuItem Header="by Size"/>
                    <MenuItem Header="by Type"/>
                    <MenuItem Header="by Date modified"/>
                    <Separator/>
                    <MenuItem Header="Ascrending" IsCheckable="True"/>
                    <MenuItem Header="Descrending" IsCheckable="True"/>
                </ContextMenu>
            </Button.ContextMenu>
            <Image Source="Images/Appearance/sort-by.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="select_all" ToolTip="Select all" Margin="0,5,158,0" VerticalAlignment="Top" Click="SelectAll_Click" Background="{x:Null}" HorizontalAlignment="Right" IsEnabled="False" Height="32" Width="32">
            <Image Source="Images/Appearance/select-all.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <ProgressBar x:Name="process" Visibility="Hidden" Height="21" Margin="112,0,10,4" VerticalAlignment="Bottom"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,0,0,4" VerticalAlignment="Bottom" FontSize="16" TextTrimming="CharacterEllipsis" Width="97" Height="21"><Run x:Name="number" Text="0" Foreground="Goldenrod"/><Run Text=" "/><Run x:Name="items_label" Text="Item" Foreground="DarkSlateBlue"/></TextBlock>
        <Grid x:Name="flow_shart" Visibility="Hidden" HorizontalAlignment="Left" Height="25" Margin="112,0,0,3" VerticalAlignment="Bottom" Width="322">
            <Rectangle x:Name="total" Height="21" Margin="2,2,2,2" Stroke="RoyalBlue" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                        <GradientStop Color="SkyBlue" Offset="1"/>
                        <GradientStop Color="#FF6EAAE7" Offset="0.669"/>
                        <GradientStop Color="#FF659DE5"/>
                        <GradientStop Color="#FF68A2E5" Offset="0.334"/>
                        <GradientStop Color="#FF7CBEE9" Offset="0.801"/>
                        <GradientStop Color="#FF669FE5" Offset="0.195"/>
                        <GradientStop Color="#FE6AA5E5" Offset="0.467"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="duplicate" Height="19" Margin="3,0,0,3" Stroke="Black" VerticalAlignment="Bottom" StrokeThickness="0" HorizontalAlignment="Left" Width="254">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFD485D4"/>
                        <GradientStop Color="#FFFF9AFA" Offset="1"/>
                        <GradientStop Color="#FFED91EA" Offset="0.599"/>
                        <GradientStop Color="#FFF293EE" Offset="0.712"/>
                        <GradientStop Color="#FFE38CE1" Offset="0.377"/>
                        <GradientStop Color="#FFDB88DA" Offset="0.195"/>
                        <GradientStop Color="#FFE68DE3" Offset="0.444"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid x:Name="deleted_grid" HorizontalAlignment="Left" Height="25" Margin="0,0,0,0" VerticalAlignment="Top" Width="170">
                <Rectangle x:Name="deleted_rect" Height="25" Margin="0,0,0,0" Stroke="Red" VerticalAlignment="Top" StrokeThickness="3" Fill="#54FF6347"/>
                <TextBlock x:Name="deleted_text" Margin="4,3,4,0" Text="" VerticalAlignment="Top" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="White"/>
            </Grid>
        </Grid>
        <Grid Margin="10,42,10,33">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="item_viewer" Margin="11,0,0,0" ItemsSource="{Binding}" Grid.Column="1">
                <ListView.Resources>
                    <Style TargetType="{x:Type ListViewItem}">
                        <EventSetter Event='Control.MouseDoubleClick' Handler='Item_MouseDoubleClick'/>
                        <EventSetter Event='UIElement.PreviewKeyUp'  Handler='Item_PreviewKeyUp'/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <TextBlock Margin="44,4,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left"/>
                            <Image Margin="16,0,0,0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <CheckBox Margin="0" IsChecked="{Binding IsChecked}" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="Sun_Checked" Unchecked="Sun_Unchecked"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <GridSplitter HorizontalAlignment="Left" Background="#FF919191" Width="5" Grid.Column="1" Margin="1,0,0,0"/>
            <ListView x:Name="item_group_viewer" Margin="0,0,4,0" ItemsSource="{Binding}" SelectionChanged="ItemGroupViewer_SelectionChanged" MinWidth="200">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Group" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock Margin="44,2,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left" FontSize="14"/>
                                        <Image Margin="16,0,0,0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        <CheckBox Margin="0" IsChecked="{Binding IsChecked}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Type" Width="75" DisplayMemberBinding="{Binding FileType}"/>
                        <GridViewColumn Header="Size" Width="60" DisplayMemberBinding="{Binding FileSize}"/>
                        <GridViewColumn Header="Total Size" Width="75" DisplayMemberBinding="{Binding TotalFileSize}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
