<Window x:Class="File_Manager.Subtitle_Option"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:File_Manager"
        mc:Ignorable="d"
    Title="Subtitle Options" Height="469" Width="450" Topmost="True" WindowStartupLocation="CenterScreen" FontSize="14" Loaded="Window_Loaded" PreviewKeyUp="Window_PreviewKeyUp" ResizeMode="CanMinimize">
    <Grid>
        <Grid x:Name="mother" Margin="-450,0,0,0">
            <Grid Width="445" HorizontalAlignment="Left">
                <TextBlock HorizontalAlignment="Left" Margin="10,50,0,0" TextWrapping="Wrap" Text="Preview" VerticalAlignment="Top"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,367,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Font size"/>
                <TextBlock HorizontalAlignment="Left" Margin="300,130,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Color"/>
                <ListBox x:Name="FontsNames" Margin="10,150,155,85" SelectionChanged="FontsNames_SelectionChanged" BorderBrush="#FF6C4500"/>
                <Slider x:Name="FontSizes" Margin="80,367,155,0" VerticalAlignment="Top" SmallChange="2" Minimum="8" Maximum="72" TickPlacement="BottomRight" Value="22" Ticks="8 9 10 11 12 14 16 18 20 22 24 26 28 36 48 72" AutoToolTipPlacement="BottomRight" ValueChanged="FontSizes_ValueChanged" LargeChange="10" Foreground="#FF6C4500"/>
                <ListBox x:Name="FontColors" Margin="300,150,10,85" SelectionChanged="FontColors_SelectionChanged" BorderBrush="#FF6C4500"/>
                <TextBox x:Name="TextTest" Margin="10,70,10,0" Text="هلا سكنت بذي ضغث فقد زعموا &#xD;&#xA;شخصت تطلب ظبيا راح مجتازا" TextAlignment="Center" AutoWordSelection="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AcceptsTab="True" Height="50" VerticalAlignment="Top" BorderBrush="#FF6C4500"/>
                <CheckBox x:Name="Bold" Content="Bold" Margin="375,367,0,0" VerticalAlignment="Top" FlowDirection="LeftToRight" HorizontalAlignment="Left" Foreground="Black" BorderBrush="#FF6E4702"/>
                <CheckBox x:Name="Italic" Content="Italic" HorizontalAlignment="Left" Margin="300,367,0,0" VerticalAlignment="Top" FlowDirection="LeftToRight" BorderBrush="#FF6C4500"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,130,0,0" TextWrapping="Wrap" Text="Font" VerticalAlignment="Top"/>
            </Grid>
            <Grid Margin="450,0,0,0" Width="445" HorizontalAlignment="Left">
                <ScrollViewer Height="400" Margin="0,40,0,0" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock HorizontalAlignment="Left" Margin="20,48,0,0" TextWrapping="Wrap" FontSize="18" Text="Synchronize" VerticalAlignment="Top" Foreground="#FF195310"/>
                        <ComboBox x:Name="sync_multiple" HorizontalAlignment="Right" Margin="0,79,64,0" VerticalAlignment="Top" Width="70" FontSize="12" SelectedIndex="0" Background="{x:Null}" BorderBrush="#FF6C4500" SelectionChanged="sync_multiple_SelectionChanged">
                            <ComboBoxItem Content="second"/>
                            <ComboBoxItem Content="minite"/>
                        </ComboBox>
                        <TextBlock HorizontalAlignment="Left" FontSize="18" Margin="20,297,0,0" Text="Subtitle encode" VerticalAlignment="Top" Foreground="#FF195310"/>
                        <TextBlock HorizontalAlignment="Left" Margin="20,143,0,0" FontSize="18" Text="Position" VerticalAlignment="Top" Foreground="#FF195310"/>
                        <TextBlock HorizontalAlignment="Left" Margin="30,173,0,0" Text="left" VerticalAlignment="Top" FontSize="14"/>
                        <TextBlock HorizontalAlignment="Left" Margin="30,228,0,0" Text="bottom" VerticalAlignment="Top"/>
                        <TextBox x:Name="bottom_textbox" Margin="200,226,74,0" TextWrapping="Wrap" Text="30" VerticalAlignment="Top" BorderBrush="#FF6C4500"/>
                        <TextBox x:Name="left_textbox" Margin="200,172,74,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" BorderBrush="#FF6C4500"/>
                        <TextBlock x:Name="syncvalue_textblock" FontSize="12" HorizontalAlignment="Left" Text="0 second" Margin="40,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF6C4500"/>
                        <TextBlock x:Name="textBlock1" HorizontalAlignment="Left" Margin="10,8,0,0" TextWrapping="Wrap" Text="Subtitle Options" VerticalAlignment="Top" FontSize="24" Foreground="RoyalBlue"/>
                        <ComboBox x:Name="encode_comboBox" Margin="200,295,35,0" VerticalAlignment="Top" SelectedIndex="4" Background="{x:Null}" BorderBrush="#FF6C4500">
                            <!--<ComboBoxItem Content="ASCII"/>
                    <ComboBoxItem Content="BigEndianUnicode"/>
                    <ComboBoxItem Content="Unicode"/>
                    <ComboBoxItem Content="UTF7"/>
                    <ComboBoxItem Content="UTF8"/>
                    <ComboBoxItem Content="UTF32"/>-->
                        </ComboBox>
                        <Slider x:Name="sync_slider" HorizontalAlignment="Left" Margin="30,78,0,0" VerticalAlignment="Top" Width="276" Minimum="-60" Maximum="60" LargeChange="5" SmallChange="0.01" TickFrequency="5" TickPlacement="BottomRight" ValueChanged="slider_ValueChanged" Foreground="#FF6C4500"/>
                        <TextBlock x:Name="syncvalue_textblock_Copy" FontSize="12" HorizontalAlignment="Left" Text="minimum '10' pixels and maximum '200' pixels" Margin="40,198,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF6C4500"/>
                        <TextBlock x:Name="syncvalue_textblock_Copy1" FontSize="12" HorizontalAlignment="Left" Text="minimum '10' pixels and maximum '250' pixels" Margin="40,253,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF6C4500"/>
                        <TextBlock x:Name="textBlock" HorizontalAlignment="Right" Margin="0,173,35,0" TextWrapping="Wrap" Text="Pixels" VerticalAlignment="Top"/>
                        <TextBlock x:Name="textBlock_Copy" HorizontalAlignment="Right" Margin="0,227,35,0" TextWrapping="Wrap" Text="Pixels" VerticalAlignment="Top"/>
                        <Button ToolTip="Rest synchronize to zero" Content="zero" HorizontalAlignment="Right" Margin="0,78,35,0" VerticalAlignment="Top" Width="24" Background="{x:Null}" Click="SyncRest_Click"/>
                    </Grid>
                </ScrollViewer>



            </Grid>
            <TextBlock HorizontalAlignment="Left" Margin="10,0,0,10" TextWrapping="Wrap" VerticalAlignment="Bottom" Foreground="Red" FontSize="12" Text="It will replace default font style in subtitle file"/>
        </Grid>
        <StackPanel Height="36" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="FONT STYLE" FontSize="18" Background="White" MouseUp="Label1_MouseUp" Cursor="Hand"/>
            <Label x:Name="label2" Content="SUBTITLE SETTING" FontSize="18" Foreground="White" Background="Black" MouseUp="label2_MouseUp" Cursor="Hand"/>
        </StackPanel>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,32,0,0" VerticalAlignment="Top" Width="107"/>
        <Button x:Name="_Save" Content="save" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Height="25" Click="Save_Setting" FontSize="16" BorderBrush="#FF6C4500" Foreground="#FF6C4500"/>
        <Button x:Name="_Cancel" Content="cancel" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Click="Cancel" Height="25" FontSize="16" BorderBrush="#FF6C4500"/>
    </Grid>
</Window>
