<Window x:Class="File_Manager.System_Monitor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System_Monitor" Height="400" Width="425" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged_1">
    <Grid x:Name="GridContainer">
        <ListView x:Name="ProcessList" Margin="10,10,10,45"/>
        <Button x:Name="EndProcess" IsEnabled="False" Content="Ask to close" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="100" Margin="10,0,0,10" Height="30"/>
        <Button x:Name="EndProcess_Copy" IsEnabled="False" Content="Kill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="100" Margin="115,0,0,10" Height="30"/>
        <Button x:Name="Refresh" Content="Refresh" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="100" Click="Refresh_Click" Margin="220,0,0,10" Height="30"/>
    </Grid>
</Window>
