<Window x:Class="File_Manager.Desktop_Environment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop_Environment" Height="600" Width="800" MinHeight="600" MinWidth="600" WindowStartupLocation="CenterScreen" WindowState="Maximized" ResizeMode="NoResize" WindowStyle="None" Activated="Window_Activated" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <StackPanel Background="Black" x:Name="launcher_panal" HorizontalAlignment="Left" Width="56" Margin="0,0,0,0">
            <Grid Height="54" Background="White" Cursor="Hand" ToolTip="Home" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-home-48.png" Margin="3,3,3,3"/>
            </Grid>
            <Grid Height="54" Background="Black" Cursor="Hand" ToolTip="Apps" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-application.png" Margin="3,3,3,3"/>
            </Grid>
            <Grid Height="54" Background="Black" Cursor="Hand" ToolTip="Games" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-game.png" Margin="3,3,3,3"/>
            </Grid>
            <Grid Height="54" Background="Black" Cursor="Hand" ToolTip="Documents" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-documents.png" Margin="3,3,3,3"/>
            </Grid>
            <Grid Height="54" Background="Black" Cursor="Hand" ToolTip="Pictures" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-picture.png" Margin="3,3,3,3"/>
            </Grid>
            <Grid Height="54" Background="Black" Cursor="Hand" ToolTip="Music" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-music.png" Margin="3,3,3,3"/>
            </Grid>
            <Grid Height="54" Background="Black" Cursor="Hand" ToolTip="Video" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-video.png" Margin="3,3,3,3"/>
            </Grid>
            <Grid Height="54" Background="Black" Cursor="Hand" ToolTip="Favorite" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-favorite.png" Margin="3,3,3,3"/>
            </Grid>
            <Grid Height="54" Background="Black" Cursor="Hand" ToolTip="Search" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-search.png" Margin="3,3,3,3"/>
            </Grid>
            <Grid Height="54" Background="Black" Cursor="Hand" ToolTip="Control Panal" MouseLeftButtonUp="Launcher_MouseLeftButtonUp">
                <Image Source="Images/Appearance/go-settings.png" Margin="3,3,3,3"/>
            </Grid>
        </StackPanel>
        <Grid x:Name="mother" Margin="0,-1800,0,0">
            <Grid Height="595" VerticalAlignment="Top">
                <ListView x:Name="home_list_view" Margin="60,0,0,0" ItemsSource="{Binding}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Left" Height="140" ToolTip="{Binding Path=Name}" Margin="10" VerticalAlignment="Top" Width="220" Background="{Binding Path=BackgroundColor}">
                                            <Image Source="{Binding Path=BigImage}" />
                                            <TextBlock Margin="5" FontSize="{Binding Path=TextFontSize}" TextWrapping="Wrap" Text="{Binding Path=TextContent}" TextAlignment="Center" Foreground="White"/>
                                            <Image HorizontalAlignment="Left" Source="{Binding Path=SmallImage0}" Height="40" Margin="20,20,0,0" VerticalAlignment="Top" Width="40"/>
                                            <Image HorizontalAlignment="Left" Source="{Binding Path=SmallImage3}" Height="40" Margin="20,68,0,0" VerticalAlignment="Top" Width="40"/>
                                            <Image HorizontalAlignment="Left" Source="{Binding Path=SmallImage1}" Height="40" Margin="90,20,0,0" VerticalAlignment="Top" Width="40"/>
                                            <Image HorizontalAlignment="Left" Source="{Binding Path=SmallImage4}" Height="40" Margin="90,68,0,0" VerticalAlignment="Top" Width="40"/>
                                            <Image HorizontalAlignment="Left" Source="{Binding Path=SmallImage2}" Height="40" Margin="160,20,0,0" VerticalAlignment="Top" Width="40"/>
                                            <Rectangle Fill="#55000000" Height="20" VerticalAlignment="Bottom"/>
                                            <TextBlock Margin="3,0,48,0" Text="{Binding Path=Name}" Height="20" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom" Foreground="Black"/>
                                            <TextBlock Margin="2,0,49,1" Text="{Binding Path=Name}" Height="19" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Bottom" Foreground="White"/>
                                            <Image HorizontalAlignment="Right" Height="48" VerticalAlignment="Bottom" Source="{Binding Path=Icon}" Width="48"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <!--<ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Expander IsExpanded="True" Header="{Binding Name}" Foreground="DimGray" FontSize="18">
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>-->
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event='MouseDoubleClick' Handler='HomeItem_DoubleClick'/>
                        </Style>
                    </ListView.Resources>
                </ListView>
            </Grid>
            <Grid Margin="0,600,0,0" VerticalAlignment="Top" Height="595">
                <ListView x:Name="app_list_view" Margin="60,30,0,0" ItemsSource="{Binding}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Left" Margin="5" VerticalAlignment="Bottom" Width="128" ToolTip="{Binding Path=Name}">
                                            <Image Height="128" Width="128" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{Binding Path=Image}"/>
                                            <Image Margin="40,50,40,40" Height="48" Width="48" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{Binding Path=SmallImage}"/>
                                            <TextBlock Margin="1,136,0,0" Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" FontSize="14" TextAlignment="Center"/>
                                            <TextBlock Margin="0,136,1,0" Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" FontSize="14" Foreground="White" TextAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event='MouseDoubleClick' Handler='AppItem_DoubleClick'/>
                        </Style>
                    </ListView.Resources>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
                <TextBox x:Name="app_filter" HorizontalAlignment="Right" Height="23" Margin="0,2,10,0" TextWrapping="Wrap" ToolTip="Filter" VerticalAlignment="Top" Width="177" TextChanged="AppsFilter_TextChanged"/>
                <Button Content="Add an app" HorizontalAlignment="Left" Margin="60,3,0,0" VerticalAlignment="Top" Width="78" Background="{x:Null}" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Right" Margin="0,6,200,0" TextWrapping="Wrap" Text="Apps Filter" VerticalAlignment="Top"/>
                <Button Content="get all apps in..." HorizontalAlignment="Left" Margin="143,3,0,0" VerticalAlignment="Top" Width="99" Background="{x:Null}" IsEnabled="False"/>
            </Grid>
            <Grid Margin="0,1200,0,0" Height="575" VerticalAlignment="Top">
                <ListView x:Name="game_list_view" Margin="60,30,0,0" ItemsSource="{Binding}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="275">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Left" Margin="5" VerticalAlignment="Bottom" Width="256" ToolTip="{Binding Path=Name}">
                                            <Image Height="256" Width="256" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{Binding Path=Image}"/>
                                            <TextBlock Margin="1,264,0,0" Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" FontSize="14" TextAlignment="Center"/>
                                            <TextBlock Margin="0,264,1,0" Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" FontSize="14" Foreground="White" TextAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event='MouseDoubleClick' Handler='GameItem_DoubleClick'/>
                        </Style>
                    </ListView.Resources>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
                <TextBox x:Name="game_filter" HorizontalAlignment="Right" Height="23" Margin="0,2,10,0" TextWrapping="Wrap" ToolTip="Filter" VerticalAlignment="Top" Width="177" TextChanged="GamesFilter_TextChanged"/>
                <Button Content="Add a game" HorizontalAlignment="Left" Margin="60,3,0,0" VerticalAlignment="Top" Width="78" Background="{x:Null}" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Right" Margin="0,6,200,0" TextWrapping="Wrap" Text="Games Filter" VerticalAlignment="Top"/>
            </Grid>
            <Grid Margin="0,1800,0,0" Height="575" VerticalAlignment="Top">
                <ListView x:Name="doc_list_view" Margin="60,30,68,0" ItemsSource="{Binding}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="225">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="128" ToolTip="{Binding Path=Name}">
                                            <Image Height="24" Width="24" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{Binding Path=Image}"/>
                                            <TextBlock Margin="28,1,0,0" Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" FontSize="14" TextAlignment="Center"/>
                                            <TextBlock Margin="28,1,1,0" Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" FontSize="14" Foreground="White" TextAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100" Header="Size" DisplayMemberBinding="{Binding Path=FileSize}"/>
                            <GridViewColumn Width="125" Header="Type" DisplayMemberBinding="{Binding Path=FileType}"/>        
                            <GridViewColumn Width="100" Header="Date" DisplayMemberBinding="{Binding Path=FileDate}"/>
                            <GridViewColumn Width="100" Header="Auther" DisplayMemberBinding="{Binding Path=Auther}"/>
                            <GridViewColumn Width="100" Header="Tags" DisplayMemberBinding="{Binding Path=Tags}"/>
                        </GridView>
                    </ListView.View>
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event='MouseDoubleClick' Handler='GameItem_DoubleClick'/>
                        </Style>
                    </ListView.Resources>
                </ListView>
                <TextBox x:Name="doc_filter" HorizontalAlignment="Right" Height="23" Margin="0,2,10,0" TextWrapping="Wrap" ToolTip="Filter" VerticalAlignment="Top" Width="177" TextChanged="DocumentFilter_TextChanged"/>
                <Button Content="Add document location" HorizontalAlignment="Left" Margin="60,3,0,0" VerticalAlignment="Top" Width="78" Background="{x:Null}" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Right" Margin="0,6,200,0" TextWrapping="Wrap" Text="Documents Filter" VerticalAlignment="Top"></TextBlock>
                <ListBox HorizontalAlignment="Right" Margin="0,57,0,0" Width="63">
                    <CheckBox Content="pdf"/>
                    <CheckBox Content="doc"/>
                    <CheckBox Content="docx"/>
                    <CheckBox Content="odt"/>
                    <CheckBox Content="ppt"/>
                    <CheckBox Content="pptx"/>
                    <CheckBox Content="odp"/>
                    <CheckBox Content="xls"/>
                    <CheckBox Content="xlsx"/>
                    <CheckBox Content="ods"/>
                    <CheckBox Content="doc"/>
                    <CheckBox Content="docx"/>
                    <CheckBox Content="odt"/>
                    <CheckBox Content="txt"/>
                    <CheckBox Content="mht"/>
                    <CheckBox Content="html"/>
                    <CheckBox Content="htm"/>
                    <CheckBox Content="xps"/>
                    <CheckBox Content="oxps"/>
                    <CheckBox Content="rtf"/>
                </ListBox>
                <ComboBox HorizontalAlignment="Right" Margin="0,30,0,0" VerticalAlignment="Top" Width="63" SelectedIndex="0">
                    <ComboBoxItem Content="Type"/>
                    <ComboBoxItem Content="Date"/>
                    <ComboBoxItem Content="Subject"/>
                    <ComboBoxItem Content="Author"/>
                </ComboBox>
            </Grid>
        </Grid>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="54" Margin="52,0,0,0" VerticalAlignment="Top" Width="4"/>
    </Grid>
</Window>

<!--Make AppBar contains general options for a tab and when select an item show delete remove uninstall.. item option-->
