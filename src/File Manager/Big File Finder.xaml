<Window x:Class="File_Manager.Big_File_Finder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Directory Analyzer" Height="400" Width="531" MinWidth="400" Icon="Images/Appearance/analyzer.png" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button ToolTip="Select a Directory" Margin="10,5,0,0" VerticalAlignment="Top" Click="AnalyseDisk_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/folder-search.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="delete_files" ToolTip="Delete selected items" Margin="0,5,84,0" VerticalAlignment="Top" Click="DeleteItems_Click" IsEnabled="False" Background="{x:Null}" HorizontalAlignment="Right">
            <Image Source="Images/Appearance/delete.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="select_all" ToolTip="Select all items" Margin="0,5,121,0" VerticalAlignment="Top" Click="SelectAll_Click" Background="{x:Null}" HorizontalAlignment="Right" IsEnabled="False">
            <Image Source="Images/Appearance/select-all.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button x:Name="clear_list" ToolTip="Clear List" Margin="0,5,47,0" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" IsEnabled="False">
            <Image Source="Images/Appearance/list-clear.png" Width="28" Height="28" Stretch="UniformToFill"/>
        </Button>
        <Button ToolTip="Setting" Margin="0,5,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}">
            <Image Source="Images/Appearance/setting.png" Height="28" Width="28" Stretch="UniformToFill"/>
        </Button>
        <ListView x:Name="item_list" Margin="10,66,10,10" ItemsSource="{Binding}" PreviewKeyUp="ItemsList_PreviewKeyUp">
            <ListView.Resources>
                <Style TargetType="{x:Type ListViewItem}">
                    <EventSetter Event='MouseDoubleClick' Handler='BigFileFinder_MouseDoubleClick'/>
                    <EventSetter Event='PreviewKeyUp'  Handler='BigFileFinder_PreviewKeyUp'/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="125">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <!--Background="{Binding Path=Background}"-->
                                    <TextBlock Margin="28,0,0,0" Text="{Binding Path=FileName}" HorizontalAlignment="Left" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <Image Margin="0" Source="{Binding Path=Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Path=FileType}"/>
                    <GridViewColumn Header="Size" Width="60" DisplayMemberBinding="{Binding Path=FileSize}"/>
                    <GridViewColumn Header="Percent" Width="60" DisplayMemberBinding="{Binding Path=Percent}"/>
                    <GridViewColumn Header="Size / All" Width="60" DisplayMemberBinding="{Binding Path=SizeFromAll}"/>
                    <GridViewColumn Header="Directories &amp; Files" Width="105" DisplayMemberBinding="{Binding Path=DirectoriesAndFiles}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBox x:Name="current_path" Margin="60,42,10,0" Text="root" VerticalAlignment="Top" FontSize="14" IsReadOnly="True"/>
        <Button IsEnabled="False" x:Name="go_up" ToolTip="Select a Directory" Margin="10,42,0,0" VerticalAlignment="Top" Click="GoUp_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/go-up.png" Width="16" Height="16" Stretch="UniformToFill"/>
        </Button>
        <ProgressBar x:Name="progressbar" Height="21" Margin="60,42,10,0" VerticalAlignment="Top" Maximum="5100" Visibility="Hidden"/>
        <Button x:Name="go_home" IsEnabled="False" ToolTip="Go to home" Margin="35,42,0,0" VerticalAlignment="Top" Click="GoHome_Click" HorizontalAlignment="Left" Background="{x:Null}">
            <Image Source="Images/Appearance/go-home.png" Width="16" Height="16" Stretch="UniformToFill"/>
        </Button>
        <TextBlock HorizontalAlignment="Left" Margin="-184,279,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="all files viewer sorted by size"/><LineBreak/><Run Text="directory view by size"/><LineBreak/><Run Text="sort types by size"/></TextBlock>
    </Grid>
</Window>
